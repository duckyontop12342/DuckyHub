-- Load: loadstring(game:HttpGet("https://raw.githubusercontent.com/duckyontop12342/DuckyHub/main/DuckyUILibrary/DuckyUI.lua"))()
-- Needs an executor with writefile/getcustomasset/gethui (falls back gracefully).

if not game:IsLoaded() then
	game.Loaded:Wait()
end

-- Constants.
local LUCIDE_URL = "https://raw.githubusercontent.com/mstudio45/lucide-roblox-direct/refs/heads/main/source.lua"
local LOGO_URL = "https://raw.githubusercontent.com/duckyontop12342/DuckyHub/main/Copilot_20261024_114935.png"
local FOLDER = "DuckyUI"
local SIDEBAR_WIDTH = 264
local TOP_OFFSET = 96

-- Services.
local cloneref = cloneref or function(object)
	return object
end
local playersService = cloneref(game:GetService("Players"))
local tweenService = cloneref(game:GetService("TweenService"))
local userInputService = cloneref(game:GetService("UserInputService"))
local httpService = cloneref(game:GetService("HttpService"))
local coreGui = cloneref(game:GetService("CoreGui"))

local Library = { Flags = {}, Options = {}, Windows = {}, Version = "2.3" }
Library.__index = Library

