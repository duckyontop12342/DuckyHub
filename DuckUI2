--#region window

function Window:findPopup(anchor)
	for _, popup in self.popups do
		if popup.Anchor == anchor then
			return popup
		end
	end
	return nil
end

function Window:closePopup(popup)
	local index = table.find(self.popups, popup)
	if not index then
		return
	end
	for i = #self.popups, index, -1 do
		local current = table.remove(self.popups, i)
		for _, connection in current.bin do
			connection:Disconnect()
		end
		if current.OnClose then
			current.OnClose()
		end
		tween(current.Frame, 0.14, { GroupTransparency = 1 })
		tween(current.Scale, 0.14, { Scale = self.userScale * 0.94 })
		task.delay(0.16, function()
			current.Frame:Destroy()
		end)
	end
end

function Window:closeAllPopups()
	if self.popups[1] then
		self:closePopup(self.popups[1])
	end
end

---Open a floating panel under an anchor.
---@param anchor GuiObject
---@param width number
---@param align string
---@return table
function Window:openPopup(anchor, width, align)
	local top = self.popups[#self.popups]
	if not (top and anchor:IsDescendantOf(top.Frame)) then
		self:closeAllPopups()
	end

	local factor = self.userScale
	local popup = { Anchor = anchor, bin = {} }
	local popupFrame = create("CanvasGroup", {
		Name = "Popup",
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Popup,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = self.popupLayer,
	}, { corner(12), stroke(Theme.Stroke) })
	popup.Frame = popupFrame
	popup.Scale = create("UIScale", { Scale = factor * 0.94, Parent = popupFrame })
	popup.Content = frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = popupFrame,
	}, { padding(14, 10, 14, 10), listLayout(0) })

	local x = anchor.AbsolutePosition.X
	if align == "right" then
		x = x + anchor.AbsoluteSize.X - width * factor
	end
	local y = anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 6
	popupFrame.Position = UDim2.fromOffset(x, y)

	table.insert(self.popups, popup)
	tween(popupFrame, 0.2, { GroupTransparency = 0 })
	tween(popup.Scale, 0.28, { Scale = factor }, Enum.EasingStyle.Back)

	task.defer(function()
		if not popupFrame.Parent then
			return
		end
		local viewport = self.gui.AbsoluteSize
		local size = popupFrame.AbsoluteSize
		local px, py = popupFrame.AbsolutePosition.X, popupFrame.AbsolutePosition.Y
		if px + size.X > viewport.X - 8 then
			px = viewport.X - size.X - 8
		end
		if py + size.Y > viewport.Y - 8 then
			py = anchor.AbsolutePosition.Y - size.Y - 6
		end
		popupFrame.Position = UDim2.fromOffset(math.max(px, 8), math.max(py, 8))
	end)
	return popup
end

---Open a selectable list under an anchor.
function Window:openList(anchor, values, isSelected, onPick, multi, onClose)
	local existing = self:findPopup(anchor)
	if existing then
		self:closePopup(existing)
		return
	end
	local width = math.max(anchor.AbsoluteSize.X / self.userScale, 150)
	local popup = self:openPopup(anchor, width, "left")
	popup.OnClose = onClose
	popup.Content:FindFirstChildOfClass("UIPadding"):Destroy()
	padding(4, 4, 4, 4).Parent = popup.Content

	local scroller = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, math.min(#values * 32 + 8, 208)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.TextDim,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = popup.Content,
	}, { listLayout(2), padding(0, 2, 0, 2) })

	local refreshers = {}
	for index, value in values do
		local item = button({
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			BackgroundColor3 = Theme.ElementHover,
			LayoutOrder = index,
			Parent = scroller,
		}, { corner(8) })
		local name = label({
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -36, 1, 0),
			Text = tostring(value),
			TextColor3 = Theme.TextSub,
			Parent = item,
		})
		local mark = icon("check", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			ImageColor3 = Theme.Accent,
			ImageTransparency = 1,
			Parent = item,
		})
		local function refresh()
			local active = isSelected(value)
			tween(mark, 0.2, { ImageTransparency = active and 0 or 1 })
			tween(name, 0.2, { TextColor3 = active and Theme.Text or Theme.TextSub })
		end
		table.insert(refreshers, refresh)
		refresh()

		item.MouseEnter:Connect(function()
			tween(item, 0.12, { BackgroundTransparency = 0.4 })
		end)
		item.MouseLeave:Connect(function()
			tween(item, 0.12, { BackgroundTransparency = 1 })
		end)
		item.MouseButton1Click:Connect(function()
			onPick(value)
			if multi then
				for _, refreshFn in refreshers do
					refreshFn()
				end
			else
				self:closePopup(popup)
			end
		end)
	end
end

function Window:flash(row)
	local overlay = frame({
		Size = UDim2.new(1, 16, 1, -4),
		Position = UDim2.fromOffset(-8, 2),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = row,
	}, { corner(8) })
	task.spawn(function()
		for _ = 1, 2 do
			tween(overlay, 0.25, { BackgroundTransparency = 0.78 }):Wait()
			tween(overlay, 0.35, { BackgroundTransparency = 1 }):Wait()
		end
		overlay:Destroy()
	end)
end

function Window:setCrumbs(first, second)
	self.crumbRoot.Text = first
	self.crumbLeaf.Text = second
end

function Window:showPage(page, instant)
	if self.currentPage == page then
		return
	end
	local previous = self.currentPage
	self.currentPage = page
	self.pageToken += 1
	local token = self.pageToken
	if instant or not previous then
		if previous then
			previous.Visible = false
		end
		page.Visible = true
		self.holder.GroupTransparency = 0
		return
	end
	tween(self.holder, 0.12, { GroupTransparency = 1 })
	task.delay(0.12, function()
		if token ~= self.pageToken then
			return
		end
		previous.Visible = false
		page.Visible = true
		self.holder.Position = UDim2.new(0, 0, 0, TOP_OFFSET + 16)
		tween(self.holder, 0.35, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, TOP_OFFSET) })
	end)
end

---Switch to a tab and optionally a specific sub tab.
function Window:selectTab(tab, subTab, instant)
	subTab = subTab or tab.active or tab.subTabs[1]
	self.activeTab = tab
	if subTab then
		tab.active = subTab
	end

	for _, other in self.tabs do
		local active = other == tab
		tween(other.button, 0.25, { BackgroundTransparency = active and 0 or 1 })
		tween(other.icon, 0.25, { ImageColor3 = active and Theme.Text or Theme.TextDim })
		tween(other.text, 0.25, { TextColor3 = active and Theme.Text or Theme.TextDim })
	end

	local scale = self.scale.Scale
	local targetY = (tab.button.AbsolutePosition.Y - self.sidebar.AbsolutePosition.Y) / scale + 10
	if instant then
		self.indicator.Position = UDim2.fromOffset(0, targetY)
	else
		tween(self.indicator, 0.4, { Position = UDim2.fromOffset(0, targetY) }, Enum.EasingStyle.Back)
	end

	if subTab then
		self.dropdownText.Text = subTab.name
		self:setCrumbs(tab.name, subTab.name)
		self.searchBox.Text = ""
		self:showPage(subTab.page, instant)
	else
		self.dropdownText.Text = "None"
		self:setCrumbs(tab.name, "None")
		self.searchBox.Text = ""
		self:showPage(tab.emptyPage, instant)
	end
end

function Window:updateSearch(query)
	query = query:lower()
	if query == "" then
		if self.activeTab and self.activeTab.active then
			self:setCrumbs(self.activeTab.name, self.activeTab.active.name)
			self:showPage(self.activeTab.active.page)
		end
		return
	end

	for _, child in self.searchInner:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local count = 0
	for _, entry in self.searchIndex do
		if entry.Name:lower():find(query, 1, true) then
			count += 1
			local result = button({
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundTransparency = 0,
				BackgroundColor3 = Theme.Panel,
				LayoutOrder = count,
				Parent = self.searchInner,
			}, { corner(10) })
			label({ Position = UDim2.fromOffset(16, 7), Size = UDim2.new(1, -50, 0, 18), Text = entry.Name, Parent = result })
			label({
				Position = UDim2.fromOffset(16, 26),
				Size = UDim2.new(1, -50, 0, 16),
				Text = entry.Tab.name .. "  ›  " .. entry.SubTab.name,
				TextSize = 13,
				TextColor3 = Theme.TextDim,
				Parent = result,
			})
			icon("chevron-right", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				Parent = result,
			})
			result.MouseEnter:Connect(function()
				tween(result, 0.15, { BackgroundColor3 = Theme.Element })
			end)
			result.MouseLeave:Connect(function()
				tween(result, 0.15, { BackgroundColor3 = Theme.Panel })
			end)
			result.MouseButton1Click:Connect(function()
				self:selectTab(entry.Tab, entry.SubTab)
				task.delay(0.5, function()
					self:flash(entry.Row)
				end)
			end)
		end
	end
	if count == 0 then
		label({
			Size = UDim2.new(1, 0, 0, 40),
			Text = "No results for \"" .. query .. "\"",
			TextColor3 = Theme.TextDim,
			Parent = self.searchInner,
		})
	end
	self:setCrumbs("Search", query)
	self:showPage(self.searchPage)
end

function Window:SetScale(value)
	self.userScale = value
	self.scale.Scale = value * self.anim.Value
end

function Window:SetToggleKey(key)
	self.toggleKey = key
end

---Show or hide the window.
function Window:Toggle(force)
	local show = force
	if show == nil then
		show = not self.open
	end
	if show == self.open then
		return
	end
	self.open = show
	self:closeAllPopups()
	if show then
		self.root.Visible = true
		tween(self.root, 0.3, { GroupTransparency = 0 })
		tween(self.anim, 0.4, { Value = 1 }, Enum.EasingStyle.Back)
	else
		tween(self.root, 0.22, { GroupTransparency = 1 })
		tween(self.anim, 0.22, { Value = 0.92 }).Completed:Connect(function()
			if not self.open then
				self.root.Visible = false
			end
		end)
	end
end

function Window:Destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end
	self.anim:Destroy()
	self.root:Destroy()
	self.popupLayer:Destroy()
	table.remove(Library.Windows, table.find(Library.Windows, self))
	for flag, option in Library.Options do
		if option.Window == self then
			Library.Options[flag] = nil
		end
	end
end

function Window:AddTab(config)
	local tab = setmetatable({ window = self, name = config.Name, subTabs = {} }, Tab)
	local index = #self.tabs + 1

	tab.button = button({
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		BackgroundColor3 = Theme.Element,
		LayoutOrder = index,
		Parent = self.tabList,
	}, { corner(10) })
	tab.icon = icon(config.Icon or "layers", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		Parent = tab.button,
	})
	tab.text = label({
		Position = UDim2.fromOffset(46, 0),
		Size = UDim2.new(1, -56, 1, 0),
		Text = config.Name,
		TextColor3 = Theme.TextDim,
		Parent = tab.button,
	})

	tab.button.MouseEnter:Connect(function()
		if self.activeTab ~= tab then
			tween(tab.button, 0.15, { BackgroundTransparency = 0.6 })
			tween(tab.text, 0.15, { TextColor3 = Theme.TextSub })
			tween(tab.icon, 0.15, { ImageColor3 = Theme.TextSub, Position = UDim2.new(0, 18, 0.5, 0) })
			tween(tab.text, 0.2, { Position = UDim2.fromOffset(50, 0) })
		end
	end)
	tab.button.MouseLeave:Connect(function()
		if self.activeTab ~= tab then
			tween(tab.button, 0.15, { BackgroundTransparency = 1 })
			tween(tab.text, 0.15, { TextColor3 = Theme.TextDim })
			tween(tab.icon, 0.15, { ImageColor3 = Theme.TextDim })
		end
		tween(tab.icon, 0.2, { Position = UDim2.new(0, 14, 0.5, 0) })
		tween(tab.text, 0.2, { Position = UDim2.fromOffset(46, 0) })
	end)
	tab.button.MouseButton1Click:Connect(function()
		self:selectTab(tab)
	end)

	tab.emptyPage = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = self.holder })
	label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(300, 24),
		Text = "Nothing here yet",
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = tab.emptyPage,
	})

	table.insert(self.tabs, tab)
	if index == 1 then
		task.defer(function()
			if not self.activeTab then
				self:selectTab(tab, nil, true)
			end
		end)
	end
	return tab
end

