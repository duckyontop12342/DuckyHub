-- State.
local lucide = nil
local logoAsset = nil
local logoAspect = 1
local screenGui = nil

--#region helpers

local function merge(defaults, props)
	local result = table.clone(defaults)
	for key, value in props or {} do
		result[key] = value
	end
	return result
end

local function create(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function padding(left, top, right, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
	})
end

local function listLayout(gap, horizontal)
	return create("UIListLayout", {
		Padding = UDim.new(0, gap or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
	})
end

local function tween(object, duration, properties, style, direction)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local playing = tweenService:Create(object, info, properties)
	playing:Play()
	return playing
end

local function label(props, children)
	return create(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.BuilderSansMedium,
			TextSize = 15,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
		}, props),
		children
	)
end

local function frame(props, children)
	return create("Frame", merge({ BorderSizePixel = 0, BackgroundColor3 = Theme.Panel }, props), children)
end

local function button(props, children)
	return create(
		"TextButton",
		merge({
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			BackgroundTransparency = 1,
			Font = Enum.Font.BuilderSansMedium,
			TextSize = 15,
			TextColor3 = Theme.Text,
		}, props),
		children
	)
end

local function applyIcon(image, name)
	if not lucide then
		return
	end
	local asset = lucide.GetAsset(name)
	if not asset then
		return
	end
	image.Image = asset.Url
	image.ImageRectSize = asset.ImageRectSize
	image.ImageRectOffset = asset.ImageRectOffset
end

local function icon(name, props, className)
	local image = create(
		className or "ImageLabel",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(18, 18),
			ImageColor3 = Theme.TextDim,
		}, props)
	)
	applyIcon(image, name)
	return image
end

local function isInside(object, position)
	local topLeft, size = object.AbsolutePosition, object.AbsoluteSize
	return position.X >= topLeft.X
		and position.X <= topLeft.X + size.X
		and position.Y >= topLeft.Y
		and position.Y <= topLeft.Y + size.Y
end

local function round(value, places)
	local factor = 10 ^ (places or 0)
	return math.floor(value * factor + 0.5) / factor
end

local function loadLucide()
	local success, result = pcall(function()
		return loadstring(game:HttpGet(LUCIDE_URL))()
	end)
	return success and result or nil
end

local function loadLogo()
	if not (writefile and getcustomasset and isfile and isfolder and makefolder) then
		return nil
	end
	local path = FOLDER .. "/logo.png"
	pcall(function()
		if not isfolder(FOLDER) then
			makefolder(FOLDER)
		end
		if not isfile(path) then
			writefile(path, game:HttpGet(LOGO_URL))
		end
	end)
	local success, asset = pcall(getcustomasset, path)
	if not success then
		return nil
	end
	-- Read the PNG header so the logo keeps its aspect ratio.
	local aspect = 1
	pcall(function()
		local data = readfile(path)
		local width, height = string.unpack(">I4I4", data, 17)
		aspect = width / height
	end)
	return asset, aspect
end

local function getGui()
	if screenGui and screenGui.Parent then
		return screenGui
	end
	screenGui = create("ScreenGui", {
		Name = "DuckyUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 100000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local parent = (gethui and gethui()) or coreGui
	screenGui.Parent = parent
	return screenGui
end

lucide = loadLucide()
logoAsset, logoAspect = loadLogo()

