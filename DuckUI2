--#region container (rows + elements)

function Container.new(window, parent, meta, bin)
	local self = setmetatable({}, Container)
	self.window = window
	self.frame = parent
	self.meta = meta
	self.rows = 0
	self.bin = bin or window.connections
	return self
end

---Track a connection so it is released with its owner.
function Container:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.bin, connection)
	return connection
end

function Container:row(height)
	local row = frame({
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = self.rows,
		Parent = self.frame,
	})
	if self.rows > 0 then
		frame({ Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Divider, Parent = row })
	end
	self.rows += 1
	return row
end

function Container:register(name, row)
	if self.meta then
		table.insert(self.window.searchIndex, { Name = name, Tab = self.meta.tab, SubTab = self.meta.subTab, Row = row })
	end
end

function Container:flagFor(config)
	if config.Flag == false then
		return nil
	end
	return config.Flag or config.Name
end

function Container:initial(flag, config)
	local stored = flag and Library.Flags[flag]
	if stored ~= nil then
		return stored, false
	end
	return config.Default, true
end

local function finishElement(state, flag, config)
	state.Callbacks = {}
	function state:OnChanged(callback)
		table.insert(self.Callbacks, callback)
	end
	function state:Fire()
		if flag then
			Library.Flags[flag] = self.Value
		end
		if config.Callback then
			task.spawn(config.Callback, self.Value)
		end
		for _, callback in self.Callbacks do
			task.spawn(callback, self.Value)
		end
	end
	if flag then
		Library.Options[flag] = state
	end
end

---Add a labelled checkbox, optionally with a settings popup.
function Container:AddToggle(config)
	local window = self.window
	local flag = self:flagFor(config)
	local row = self:row(46)
	local state = { Type = "Toggle", Value = false }
	finishElement(state, flag, config)
	self:register(config.Name, row)

	local box = frame({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Theme.Element,
		Parent = row,
	}, { corner(6) })
	local boxStroke = stroke(Theme.Stroke)
	boxStroke.Parent = box
	local check = icon("check", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		ImageColor3 = Color3.new(1, 1, 1),
		ImageTransparency = 1,
		Parent = box,
	})
	local text = label({
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -64, 1, 0),
		Text = config.Name,
		TextColor3 = Theme.TextDim,
		Parent = row,
	})
	local hasGear = config.Settings ~= nil
	local hit = button({
		Size = hasGear and UDim2.new(1, -34, 1, 0) or UDim2.fromScale(1, 1),
		Parent = row,
	})

	function state:Set(value, silent)
		value = value and true or false
		self.Value = value
		tween(box, 0.2, { BackgroundColor3 = value and Theme.Accent or Theme.Element })
		tween(boxStroke, 0.2, { Color = value and Theme.Accent or Theme.Stroke })
		tween(check, 0.28, {
			ImageTransparency = value and 0 or 1,
			Size = value and UDim2.fromOffset(14, 14) or UDim2.fromOffset(6, 6),
		}, Enum.EasingStyle.Back)
		tween(text, 0.2, { TextColor3 = value and Theme.Text or Theme.TextDim })
		if silent then
			if flag then
				Library.Flags[flag] = value
			end
		else
			self:Fire()
		end
	end

	hit.MouseButton1Click:Connect(function()
		state:Set(not state.Value)
		tween(box, 0.1, { Size = UDim2.fromOffset(16, 16) }):Wait()
		tween(box, 0.25, { Size = UDim2.fromOffset(20, 20) }, Enum.EasingStyle.Back)
	end)
	hit.MouseEnter:Connect(function()
		if not state.Value then
			tween(text, 0.15, { TextColor3 = Theme.TextSub })
		end
	end)
	hit.MouseLeave:Connect(function()
		if not state.Value then
			tween(text, 0.15, { TextColor3 = Theme.TextDim })
		end
	end)

	if hasGear then
		local gear = icon("settings", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(20, 20),
			Parent = row,
		}, "ImageButton")
		gear.MouseEnter:Connect(function()
			tween(gear, 0.3, { ImageColor3 = Theme.Text, Rotation = 60 }, Enum.EasingStyle.Back)
		end)
		gear.MouseLeave:Connect(function()
			tween(gear, 0.3, { ImageColor3 = Theme.TextDim, Rotation = 0 })
		end)
		gear.MouseButton1Click:Connect(function()
			local existing = window:findPopup(gear)
			if existing then
				window:closePopup(existing)
				return
			end
			local popup = window:openPopup(gear, 250, "right")
			label({
				Size = UDim2.new(1, 0, 0, 26),
				Text = config.Name,
				Font = Enum.Font.BuilderSansBold,
				TextColor3 = Theme.TextSub,
				LayoutOrder = -1,
				Parent = popup.Content,
			})
			config.Settings(Container.new(window, popup.Content, nil, popup.bin))
		end)
	end

	local initial, first = self:initial(flag, config)
	state:Set(initial == true, true)
	if first and initial == true then
		state:Fire()
	end
	return state
end

---Add a numeric slider.
function Container:AddSlider(config)
	local flag = self:flagFor(config)
	local min, max = config.Min or 0, config.Max or 100
	local increment = config.Increment or 1
	local suffix = config.Suffix or ""
	local row = self:row(56)
	local state = { Type = "Slider", Value = min }
	finishElement(state, flag, config)
	self:register(config.Name, row)

	label({
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, -80, 0, 20),
		Text = config.Name,
		TextColor3 = Theme.TextSub,
		Parent = row,
	})
	local valueBox = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 8),
		Size = UDim2.fromOffset(70, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.BuilderSansMedium,
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		ClearTextOnFocus = false,
		Text = "",
		Parent = row,
	})
	local track = frame({
		Position = UDim2.fromOffset(0, 37),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Theme.Element,
		Parent = row,
	}, { corner(3) })
	local fill = frame({
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = track,
	}, { corner(3) })
	local knob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = fill,
	}, { corner(8) })
	local hit = button({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 26),
		Parent = row,
	})

	function state:Set(value, silent)
		value = math.clamp(math.round((value - min) / increment) * increment + min, min, max)
		value = round(value, 4)
		self.Value = value
		valueBox.Text = tostring(value) .. suffix
		tween(fill, 0.12, { Size = UDim2.new((value - min) / (max - min), 0, 1, 0) }, Enum.EasingStyle.Quad)
		if silent then
			if flag then
				Library.Flags[flag] = value
			end
		else
			self:Fire()
		end
	end

	local dragging = false
	local function update()
		local alpha = math.clamp((userInputService:GetMouseLocation().X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		state:Set(min + (max - min) * alpha)
	end
	local function grow(size)
		tween(knob, 0.2, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Back)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			grow(14)
			update()
		end
	end)
	hit.MouseEnter:Connect(function()
		grow(12)
	end)
	hit.MouseLeave:Connect(function()
		if not dragging then
			grow(0)
		end
	end)
	self:connect(userInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update()
		end
	end)
	self:connect(userInputService.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			grow(0)
		end
	end)

	valueBox.Focused:Connect(function()
		valueBox.Text = tostring(state.Value)
	end)
	valueBox.FocusLost:Connect(function()
		local typed = tonumber(valueBox.Text:match("-?%d+%.?%d*"))
		state:Set(typed or state.Value)
	end)

	local initial, _ = self:initial(flag, config)
	state:Set(initial or min, true)
	return state
end

---Add a single or multi select dropdown.
function Container:AddDropdown(config)
	local window = self.window
	local flag = self:flagFor(config)
	local multi = config.Multi == true
	local row = self:row(76)
	local state = { Type = "Dropdown", Value = multi and {} or nil, Values = config.Values or {} }
	local selected = {}
	finishElement(state, flag, config)
	self:register(config.Name, row)

	label({
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 20),
		Text = config.Name,
		TextColor3 = Theme.TextSub,
		Parent = row,
	})
	local box = button({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Element,
		Parent = row,
	}, { corner(8) })
	local valueLabel = label({
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -44, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = box,
	})
	local arrow = icon("chevron-down", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Parent = box,
	})

	local function display()
		if multi then
			local names = {}
			for _, value in state.Values do
				if selected[value] then
					table.insert(names, value)
				end
			end
			valueLabel.Text = #names > 0 and table.concat(names, ", ") or "None"
		else
			valueLabel.Text = state.Value ~= nil and tostring(state.Value) or "None"
		end
	end

	function state:Set(value, silent)
		if multi then
			selected = {}
			for _, name in type(value) == "table" and value or {} do
				selected[name] = true
			end
			local ordered = {}
			for _, name in self.Values do
				if selected[name] then
					table.insert(ordered, name)
				end
			end
			self.Value = ordered
		else
			self.Value = value
		end
		display()
		if silent then
			if flag then
				Library.Flags[flag] = self.Value
			end
		else
			self:Fire()
		end
	end

	function state:Refresh(values)
		self.Values = values
		self:Set(multi and self.Value or self.Value, true)
	end

	box.MouseEnter:Connect(function()
		tween(box, 0.15, { BackgroundColor3 = Theme.ElementHover })
	end)
	box.MouseLeave:Connect(function()
		tween(box, 0.15, { BackgroundColor3 = Theme.Element })
	end)
	box.MouseButton1Click:Connect(function()
		tween(arrow, 0.25, { Rotation = 180 })
		window:openList(box, state.Values, function(value)
			if multi then
				return selected[value] == true
			end
			return state.Value == value
		end, function(value)
			if multi then
				selected[value] = not selected[value] or nil
				local list = {}
				for name in selected do
					table.insert(list, name)
				end
				state:Set(list)
			else
				state:Set(value)
			end
		end, multi, function()
			tween(arrow, 0.25, { Rotation = 0 })
		end)
	end)

	local initial = self:initial(flag, config)
	state:Set(initial, true)
	return state
end

