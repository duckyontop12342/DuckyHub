		Size = UDim2.fromOffset(92, 28),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Element,
		TextSize = 14,
		Parent = row,
	}, { corner(8) })
	local keyStroke = stroke(Theme.Stroke)
	keyStroke.Parent = keyButton

	local listening = false
	local function show()
		keyButton.Text = state.Value ~= Enum.KeyCode.Unknown and state.Value.Name or "None"
	end

	function state:Set(key, silent)
		self.Value = key or Enum.KeyCode.Unknown
		show()
		if silent then
			if flag then
				Library.Flags[flag] = self.Value
			end
		else
			self:Fire()
		end
	end

	keyButton.MouseButton1Click:Connect(function()
		listening = true
		keyButton.Text = "..."
		tween(keyStroke, 0.15, { Color = Theme.Accent })
	end)
	keyButton.MouseEnter:Connect(function()
		tween(keyButton, 0.15, { BackgroundColor3 = Theme.ElementHover })
	end)
	keyButton.MouseLeave:Connect(function()
		tween(keyButton, 0.15, { BackgroundColor3 = Theme.Element })
	end)

	self:connect(userInputService.InputBegan, function(input, processed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			tween(keyStroke, 0.15, { Color = Theme.Stroke })
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				state:Set(Enum.KeyCode.Unknown)
			else
				state:Set(input.KeyCode)
			end
		elseif not processed and state.Value ~= Enum.KeyCode.Unknown and input.KeyCode == state.Value and config.OnPress then
			task.spawn(config.OnPress)
		end
	end)

	local initial = self:initial(flag, config)
	state:Set(initial or Enum.KeyCode.Unknown, true)
	return state
end

