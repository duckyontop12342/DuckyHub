--#region config

---Serialize every registered option.
---@return table
function Library:GetConfig()
	local data = {}
	for flag, option in self.Options do
		local value = option.Value
		if option.Type == "ColorPicker" then
			value = value:ToHex()
		elseif option.Type == "Keybind" then
			value = value and value.Name or "None"
		end
		data[flag] = { Type = option.Type, Value = value }
	end
	return data
end

---Apply a serialized config.
---@param data table
function Library:SetConfig(data)
	for flag, entry in data do
		local option = self.Options[flag]
		if option then
			local value = entry.Value
			if option.Type == "ColorPicker" then
				value = Color3.fromHex(value)
			elseif option.Type == "Keybind" then
				value = Enum.KeyCode[value] or Enum.KeyCode.Unknown
			end
			pcall(option.Set, option, value)
		end
	end
end

function Library:SaveConfig(name)
	if not (writefile and makefolder and isfolder) then
		return false
	end
	if not isfolder(FOLDER) then
		makefolder(FOLDER)
	end
	if not isfolder(FOLDER .. "/configs") then
		makefolder(FOLDER .. "/configs")
	end
	writefile(FOLDER .. "/configs/" .. name .. ".json", httpService:JSONEncode(self:GetConfig()))
	return true
end

function Library:LoadConfig(name)
	local path = FOLDER .. "/configs/" .. name .. ".json"
	if not (isfile and isfile(path)) then
		return false
	end
	self:SetConfig(httpService:JSONDecode(readfile(path)))
	return true
end

function Library:ListConfigs()
	local names = {}
	if not (listfiles and isfolder and isfolder(FOLDER .. "/configs")) then
		return names
	end
	for _, path in listfiles(FOLDER .. "/configs") do
		local name = path:match("([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	return names
end

