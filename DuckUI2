---Show a toast notification.
---@param config table
function Library:Notify(config)
	local gui = getGui()
	local holder = gui:FindFirstChild("Notifications")
	if not holder then
		holder = create("Frame", {
			Name = "Notifications",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -20, 1, -20),
			Size = UDim2.new(0, 300, 1, -40),
			BackgroundTransparency = 1,
			Parent = gui,
		}, {
			create("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
			}),
		})
	end

	local duration = config.Duration or 4
	local wrapper = frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local card = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(330, 0),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = wrapper,
	}, { corner(12), stroke(Theme.Stroke) })

	local body = frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	}, { padding(14, 12, 14, 16), listLayout(4) })

	local head = frame({ Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1, Parent = body })
	icon(config.Icon or "info", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(0, 2), ImageColor3 = Theme.Accent, Parent = head })
	label({
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = config.Title or "Notification",
		Font = Enum.Font.BuilderSansBold,
		Parent = head,
	})
	if config.Content then
		label({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = config.Content,
			TextWrapped = true,
			TextColor3 = Theme.TextSub,
			TextSize = 14,
			LayoutOrder = 2,
			Parent = body,
		})
	end

	local bar = frame({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Theme.Accent,
		Parent = card,
	})

	tween(card, 0.45, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)
	tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	task.delay(duration, function()
		tween(card, 0.35, { Position = UDim2.fromOffset(330, 0), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.wait(0.4)
		wrapper:Destroy()
	end)
end

