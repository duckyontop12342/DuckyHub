---Create a sub page (shown in the top dropdown).
function Tab:AddSubTab(name)
	local window = self.window
	local subTab = setmetatable({ tab = self, name = name, nextSide = "Left" }, SubTab)
	subTab.page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = window.holder,
	})
	local inner = frame({
		Position = UDim2.fromOffset(16, 4),
		Size = UDim2.new(1, -32, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = subTab.page,
	}, { padding(0, 0, 0, 18) })
	subTab.left = frame({
		Size = UDim2.new(0.5, -9, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = inner,
	}, { listLayout(14) })
	subTab.right = frame({
		Position = UDim2.new(0.5, 9, 0, 0),
		Size = UDim2.new(0.5, -9, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = inner,
	}, { listLayout(14) })

	table.insert(self.subTabs, subTab)
	if window.activeTab == self and not self.active then
		window:selectTab(self, subTab, true)
	end
	return subTab
end

function Tab:AddSection(config)
	if not self.subTabs[1] then
		self:AddSubTab("Main")
	end
	return self.subTabs[1]:AddSection(config)
end

---Create a titled card.
function SubTab:AddSection(config)
	if type(config) == "string" then
		config = { Name = config }
	end
	local side = config.Side
	if not side then
		side = self.nextSide
		self.nextSide = side == "Left" and "Right" or "Left"
	end
	local column = side == "Right" and self.right or self.left
	local section = frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = #column:GetChildren(),
		Parent = column,
	}, { listLayout(8) })
	label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = config.Name,
		TextColor3 = Color3.fromRGB(205, 205, 210),
		LayoutOrder = 0,
		Parent = section,
	})
	local card = frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = 1,
		Parent = section,
	}, { corner(12), padding(16, 2, 16, 2), listLayout(0) })

	return Container.new(self.tab.window, card, { tab = self.tab, subTab = self })
end

