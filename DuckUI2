	end)
	swatch.MouseLeave:Connect(function()
		tween(swatch, 0.2, { Size = UDim2.fromOffset(24, 24) })
	end)

	swatch.MouseButton1Click:Connect(function()
		local existing = window:findPopup(swatch)
		if existing then
			window:closePopup(existing)
			return
		end
		local popup = window:openPopup(swatch, 224, "right")
		local content = popup.Content
		local picker = Container.new(window, content, nil, popup.bin)

		local svBox = frame({
			Size = UDim2.new(1, 0, 0, 130),
			BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
			LayoutOrder = 1,
			Parent = content,
		}, { corner(8) })
		local white = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = svBox }, {
			corner(8),
			create("UIGradient", { Transparency = NumberSequence.new(0, 1) }),
		})
		local black = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = svBox }, {
			corner(8),
			create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }),
		})
		local cursor = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = svBox,
		}, { corner(6), stroke(Color3.new(0, 0, 0), 1.5) })

		local hueBar = frame({
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = 2,
			Parent = content,
		}, {
			corner(7),
			create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
					ColorSequenceKeypoint.new(0.167, Color3.fromHSV(0.167, 1, 1)),
					ColorSequenceKeypoint.new(0.333, Color3.fromHSV(0.333, 1, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
					ColorSequenceKeypoint.new(0.667, Color3.fromHSV(0.667, 1, 1)),
					ColorSequenceKeypoint.new(0.833, Color3.fromHSV(0.833, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
				}),
			}),
		})
		local hueKnob = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(6, 20),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = hueBar,
		}, { corner(3), stroke(Color3.new(0, 0, 0), 1) })

		local hexBox = create("TextBox", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			Font = Enum.Font.BuilderSansMedium,
			TextSize = 14,
			TextColor3 = Theme.Text,
			ClearTextOnFocus = false,
			LayoutOrder = 3,
			Text = "",
			Parent = content,
		}, { corner(8) })

		local function refresh(animate)
			local color = Color3.fromHSV(hue, sat, val)
			svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
			cursor.Position = UDim2.fromScale(sat, 1 - val)
			hueKnob.Position = UDim2.fromScale(hue, 0.5)
			hexBox.Text = "#" .. color:ToHex():upper()
			state.Value = color
			tween(swatch, 0.1, { BackgroundColor3 = color })
			tween(ring, 0.1, { Color = color:Lerp(Color3.new(0, 0, 0), 0.45) })
			if animate then
				state:Fire()
			end
		end
		refresh(false)

		local mode = nil
		local function drag()
			local mouse = userInputService:GetMouseLocation()
			if mode == "sv" then
				sat = math.clamp((mouse.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
				val = 1 - math.clamp((mouse.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
			elseif mode == "hue" then
				hue = math.clamp((mouse.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
			end
			refresh(true)
		end
		local function press(target, name)
			target.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					mode = name
					drag()
				end
			end)
		end
		press(svBox, "sv")
		press(hueBar, "hue")
		picker:connect(userInputService.InputChanged, function(input)
			if mode and input.UserInputType == Enum.UserInputType.MouseMovement then
				drag()
			end
		end)
		picker:connect(userInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				mode = nil
			end
		end)
		hexBox.FocusLost:Connect(function()
			local success, color = pcall(Color3.fromHex, hexBox.Text)
			if success then
				hue, sat, val = color:ToHSV()
			end
			refresh(true)
		end)
	end)

	local initial = self:initial(flag, config)
	state:Set(initial or Color3.new(1, 1, 1), true)
	return state
end

