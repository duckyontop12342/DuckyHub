--#region create window

---Create the main window.
---@param config table
---@return table
function Library:CreateWindow(config)
	config = config or {}
	local gui = getGui()
	local window = setmetatable({
		tabs = {},
		popups = {},
		searchIndex = {},
		connections = {},
		open = true,
		pageToken = 0,
		gui = gui,
		toggleKey = config.ToggleKey or Enum.KeyCode.RightShift,
	}, Window)
	table.insert(Library.Windows, window)

	local size = config.Size or UDim2.fromOffset(1000, 625)
	local camera = workspace.CurrentCamera
	local fit = camera and math.min(1, (camera.ViewportSize.X - 40) / size.X.Offset, (camera.ViewportSize.Y - 40) / size.Y.Offset) or 1
	window.userScale = fit

	window.popupLayer = frame({
		Name = "Popups",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	})
	window.root = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = gui,
	}, { corner(14), stroke(Theme.Stroke) })
	local root = window.root
	window.scale = create("UIScale", { Scale = fit * 0.9, Parent = root })
	window.anim = create("NumberValue", { Value = 0.9 })
	window.anim.Changed:Connect(function(value)
		window.scale.Scale = value * window.userScale
	end)

	-- Drag handle sits below every control.
	local dragHandle = frame({ Size = UDim2.new(1, 0, 0, 64), BackgroundTransparency = 1, Parent = root })
	local dragging, dragStart, startPosition = false, nil, nil
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = userInputService:GetMouseLocation()
			startPosition = root.Position
		end
	end)
	table.insert(window.connections, userInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = userInputService:GetMouseLocation() - dragStart
			root.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		end
	end))
	table.insert(window.connections, userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- Sidebar.
	window.sidebar = frame({
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0),
		BackgroundTransparency = 1,
		Parent = root,
	})
	frame({
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Theme.Divider,
		Parent = root,
	})

	-- The logo is the title. No text title exists.
	local logoWidth = config.LogoWidth or (SIDEBAR_WIDTH - 44)
	local logoHeight = math.clamp(logoWidth / (logoAspect or 1), 28, 64)
	logoWidth = math.min(logoWidth, logoHeight * (logoAspect or 1))
	local logo = create("ImageLabel", {
		Position = UDim2.fromOffset(22, 34 - logoHeight / 2),
		Size = UDim2.fromOffset(logoWidth, logoHeight),
		BackgroundTransparency = 1,
		Image = logoAsset or "",
		ScaleType = Enum.ScaleType.Fit,
		Parent = window.sidebar,
	})
	task.spawn(function()
		while logo.Parent do
			tween(logo, 2.5, { Position = UDim2.fromOffset(22, 31 - logoHeight / 2) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut):Wait()
			tween(logo, 2.5, { Position = UDim2.fromOffset(22, 34 - logoHeight / 2) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut):Wait()
		end
	end)

	-- Search.
	local searchFrame = frame({
		Position = UDim2.fromOffset(12, 70),
		Size = UDim2.new(1, -24, 0, 38),
		BackgroundColor3 = Theme.Panel,
		Parent = window.sidebar,
	}, { corner(10) })
	local searchStroke = stroke(Theme.Stroke)
	searchStroke.Parent = searchFrame
	local searchIcon = icon("search", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Parent = searchFrame,
	})
	window.searchBox = create("TextBox", {
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -72, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.BuilderSansMedium,
		TextSize = 15,
		TextColor3 = Theme.Text,
		PlaceholderText = "Search",
		PlaceholderColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Text = "",
		Parent = searchFrame,
	})
	local clear = icon("x", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		ImageTransparency = 1,
		Active = false,
		Parent = searchFrame,
	}, "ImageButton")
	window.searchBox.Focused:Connect(function()
		tween(searchStroke, 0.2, { Color = Theme.Accent })
		tween(searchIcon, 0.2, { ImageColor3 = Theme.Accent })
	end)
	window.searchBox.FocusLost:Connect(function()
		tween(searchStroke, 0.2, { Color = Theme.Stroke })
		tween(searchIcon, 0.2, { ImageColor3 = Theme.TextDim })
	end)
	window.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local text = window.searchBox.Text
		tween(clear, 0.2, { ImageTransparency = text == "" and 1 or 0 })
		clear.Active = text ~= ""
		window:updateSearch(text)
	end)
	clear.MouseButton1Click:Connect(function()
		window.searchBox.Text = ""
	end)

	frame({
		Position = UDim2.fromOffset(12, 122),
		Size = UDim2.new(1, -24, 0, 1),
		BackgroundColor3 = Theme.Divider,
		Parent = window.sidebar,
	})

	-- Tabs.
	window.tabList = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 136),
		Size = UDim2.new(1, 0, 1, -148),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = window.sidebar,
	}, { listLayout(6), padding(12, 0, 12, 0) })
	window.indicator = frame({
		Size = UDim2.fromOffset(4, 18),
		Position = UDim2.fromOffset(0, 150),
		BackgroundColor3 = Theme.Accent,
		ZIndex = 5,
		Parent = window.sidebar,
	}, { create("UICorner", { CornerRadius = UDim.new(0, 2) }) })

	-- Content.
	local content = frame({
		Position = UDim2.fromOffset(SIDEBAR_WIDTH + 1, 0),
		Size = UDim2.new(1, -(SIDEBAR_WIDTH + 1), 1, 0),
		BackgroundTransparency = 1,
		Parent = root,
	})

	-- Square icon buttons: glyph is a centered child so it keeps its 20px size.
	local function iconButton(name, props)
		local holder = button(merge({
			Size = UDim2.fromOffset(44, 44),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Panel,
		}, props), { corner(12) })
		local glyph = icon(name, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			ImageColor3 = Color3.fromRGB(132, 132, 140),
			Parent = holder,
		})
		return holder, glyph
	end

	local folderButton = iconButton("folder-plus", { Position = UDim2.fromOffset(16, 16), Parent = content })

	local dropdownButton = button({
		Position = UDim2.fromOffset(72, 16),
		Size = UDim2.fromOffset(238, 44),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Panel,
		Parent = content,
	}, { corner(12) })
	window.dropdownText = label({
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -52, 1, 0),
		Text = "",
		TextColor3 = Theme.TextDim,
		Parent = dropdownButton,
	})
	local dropdownArrow = icon("chevron-down", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		ImageColor3 = Theme.TextSub,
		Parent = dropdownButton,
	})

	local settingsButton, settingsGlyph = iconButton("settings", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Parent = content,
	})

	for _, control in { folderButton, dropdownButton, settingsButton } do
		control.MouseEnter:Connect(function()
			tween(control, 0.15, { BackgroundColor3 = Theme.Element })
		end)
		control.MouseLeave:Connect(function()
			tween(control, 0.15, { BackgroundColor3 = Theme.Panel })
		end)
	end
	settingsButton.MouseEnter:Connect(function()
		tween(settingsGlyph, 0.4, { Rotation = 60 }, Enum.EasingStyle.Back)
	end)
	settingsButton.MouseLeave:Connect(function()
		tween(settingsGlyph, 0.4, { Rotation = 0 })
	end)

	-- Breadcrumb.
	local crumbs = frame({
		Position = UDim2.fromOffset(18, 70),
		Size = UDim2.fromOffset(400, 20),
		BackgroundTransparency = 1,
		Parent = content,
	})
	create("UIListLayout", {
		Parent = crumbs,
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	window.crumbRoot = label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1, Parent = crumbs })
	icon("chevron-right", { Size = UDim2.fromOffset(14, 14), LayoutOrder = 2, ImageColor3 = Theme.TextDim, Parent = crumbs })
	window.crumbLeaf = label({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 3,
		TextColor3 = Theme.TextDim,
		Parent = crumbs,
	})

	window.holder = create("CanvasGroup", {
		Position = UDim2.new(0, 0, 0, TOP_OFFSET),
		Size = UDim2.new(1, 0, 1, -TOP_OFFSET),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = content,
	})
	window.searchPage = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = window.holder,
	})
	window.searchInner = frame({
		Position = UDim2.fromOffset(16, 4),
		Size = UDim2.new(1, -32, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = window.searchPage,
	}, { listLayout(8), padding(0, 0, 0, 16) })

	-- Top bar behaviour.
	dropdownButton.MouseButton1Click:Connect(function()
		local tab = window.activeTab
		if not tab then
			return
		end
		if #tab.subTabs == 0 then
			return
		end
		local names, byName = {}, {}
		for _, subTab in tab.subTabs do
			table.insert(names, subTab.name)
			byName[subTab.name] = subTab
		end
		tween(dropdownArrow, 0.25, { Rotation = 180 })
		window:openList(dropdownButton, names, function(name)
			return tab.active and tab.active.name == name
		end, function(name)
			window:selectTab(tab, byName[name])
		end, false, function()
			tween(dropdownArrow, 0.25, { Rotation = 0 })
		end)
	end)

	settingsButton.MouseButton1Click:Connect(function()
		local existing = window:findPopup(settingsButton)
		if existing then
			window:closePopup(existing)
			return
		end
		local popup = window:openPopup(settingsButton, 260, "right")
		label({ Size = UDim2.new(1, 0, 0, 26), Text = "Menu Settings", Font = Enum.Font.BuilderSansBold, TextColor3 = Theme.TextSub, Parent = popup.Content })
		local menu = Container.new(window, popup.Content, nil, popup.bin)
		menu:AddKeybind({
			Name = "Menu Keybind",
			Flag = false,
			Default = window.toggleKey,
			Callback = function(key)
				if key ~= Enum.KeyCode.Unknown then
					window:SetToggleKey(key)
				end
			end,
		})
		menu:AddSlider({
			Name = "UI Scale",
			Flag = false,
			Min = 0.6,
			Max = 1.4,
			Increment = 0.05,
			Default = round(window.userScale, 2),
			Callback = function(value)
				window:SetScale(value)
			end,
		})
		menu:AddButton({
			Name = "Unload UI",
			Callback = function()
				window:Destroy()
			end,
		})
	end)

	folderButton.MouseButton1Click:Connect(function()
		local existing = window:findPopup(folderButton)
		if existing then
			window:closePopup(existing)
			return
		end
		local popup = window:openPopup(folderButton, 270, "left")
		label({ Size = UDim2.new(1, 0, 0, 26), Text = "Configs", Font = Enum.Font.BuilderSansBold, TextColor3 = Theme.TextSub, Parent = popup.Content })
		local configs = Container.new(window, popup.Content, nil, popup.bin)
		local nameBox = configs:AddTextbox({ Name = "Config Name", Flag = false, Default = "default" })
		local picker = configs:AddDropdown({ Name = "Saved Configs", Flag = false, Values = Library:ListConfigs() })
		configs:AddButton({
			Name = "Save Config",
			Callback = function()
				local name = nameBox.Value ~= "" and nameBox.Value or "default"
				local saved = Library:SaveConfig(name)
				Library:Notify({
					Title = saved and "Config saved" or "Save failed",
					Content = saved and name or "Executor has no filesystem access.",
					Icon = saved and "save" or "x",
				})
				picker:Refresh(Library:ListConfigs())
			end,
		})
		configs:AddButton({
			Name = "Load Config",
			Callback = function()
				local name = picker.Value or nameBox.Value
				local loaded = name and Library:LoadConfig(name)
				Library:Notify({
					Title = loaded and "Config loaded" or "Load failed",
					Content = loaded and name or "Pick a saved config first.",
					Icon = loaded and "folder-plus" or "x",
				})
			end,
		})
	end)

	-- Global input.
	table.insert(window.connections, userInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local mouse = userInputService:GetMouseLocation()
			for i = #window.popups, 1, -1 do
				local popup = window.popups[i]
				if isInside(popup.Frame, mouse) or isInside(popup.Anchor, mouse) then
					break
				end
				window:closePopup(popup)
			end
		elseif not processed and input.KeyCode == window.toggleKey then
			window:Toggle()
		end
	end))

	-- Entrance animation.
	tween(root, 0.45, { GroupTransparency = 0 })
	tween(window.anim, 0.6, { Value = 1 }, Enum.EasingStyle.Back)

	return window
end

--#endregion

---Stagger-in helper for tab buttons (called once after tabs are built).
function Window:Reveal()
	for index, tab in self.tabs do
		tab.text.TextTransparency = 1
		tab.icon.ImageTransparency = 1
		task.delay(0.08 * index, function()
			tween(tab.text, 0.4, { TextTransparency = 0 })
			tween(tab.icon, 0.4, { ImageTransparency = 0 })
		end)
	end
end

return Library
