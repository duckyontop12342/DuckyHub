-- click ripple for buttons (btn should have ClipsDescendants = true)
local function ripple(btn, input)
    local rel = (screenPos(input) - btn.AbsolutePosition) / scale.Scale
    local r = create("Frame", {
        Parent = btn, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rel.X, rel.Y),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7,
        BorderSizePixel = 0, ZIndex = btn.ZIndex + 1,
    }, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
    local d = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) / scale.Scale * 2.2
    tween(r, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.55, Enum.EasingStyle.Quad)
    task.delay(0.6, function() r:Destroy() end)
end

-- dialog: Window:Dialog({ Title, Content, Buttons = { { Name = "Cancel" }, { Name = "OK", Primary = true, Callback = fn } } })
function Window:Dialog(o)
    o = o or {}
    if Window._closePicker then Window._closePicker() end
    if Window._dialog then Window._dialog() end
    local shade = create("TextButton", {
        Parent = main, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 40,
    })
    local box = create("TextButton", { -- a button so clicks on the box don't fall through to the shade
        Parent = shade, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Text = "", AutoButtonColor = false,
        Size = UDim2.fromOffset(math.min(300, WIN_W - 40), 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
    }, {
        corner(10), stroke(Theme.Border, 1), padding(16),
        create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    local pop = create("UIScale", { Parent = box, Scale = 0.88 })
    text({
        Parent = box, Size = UDim2.new(1, 0, 0, 18), Text = o.Title or "Are you sure?", FontFace = FONT_BOLD,
        TextSize = 15, LayoutOrder = 1,
    })
    if o.Content then
        text({
            Parent = box, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = o.Content,
            TextColor3 = Theme.Desc, FontFace = FONT_SEMI, TextSize = 12, TextWrapped = true, LayoutOrder = 2,
        })
    end
    local row = create("Frame", {
        Parent = box, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 3,
    }, {
        create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
            Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        if Window._dialog == close then Window._dialog = nil end
        box.Visible = false
        tween(shade, { BackgroundTransparency = 1 }, 0.15)
        task.delay(0.16, function() shade:Destroy() end)
    end
    Window._dialog = close

    for i, b in ipairs(o.Buttons or { { Name = "OK", Primary = true } }) do
        local primary = b.Primary == true
        local btn = create("TextButton", {
            Parent = row, Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i,
            BackgroundColor3 = primary and Theme.Accent or Theme.Button, BorderSizePixel = 0, AutoButtonColor = false,
            Text = tostring(b.Name or "OK"), FontFace = FONT_BOLD, TextSize = 12, ClipsDescendants = true,
            TextColor3 = primary and Theme.OnAccent or Theme.Text,
        }, { corner(6), padding(0, 16, 0, 16) })
        btn.MouseEnter:Connect(function() if not primary then tween(btn, { BackgroundColor3 = Theme.ButtonHover }) end end)
        btn.MouseLeave:Connect(function() if not primary then tween(btn, { BackgroundColor3 = Theme.Button }) end end)
        btn.InputBegan:Connect(function(input) if isPress(input) then ripple(btn, input) end end)
        btn.MouseButton1Click:Connect(function()
            close()
            if b.Callback then task.spawn(b.Callback) end
        end)
    end
    shade.MouseButton1Click:Connect(function() if o.Dismissable ~= false then close() end end)

    tween(shade, { BackgroundTransparency = 0.45 }, 0.2)
    tween(pop, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
    return { Close = close }
end

