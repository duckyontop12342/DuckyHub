        -- slider ----------------------------------------------------------------
        function Tab:CreateSlider(o)
            local range = o.Range or { o.Min or 0, o.Max or 100 }
            local min, max = range[1], range[2]
            local inc = o.Increment or 1
            local suffix = o.Suffix or ""
            local c, head = card(o, 42)

            local val = text({
                Parent = head, Position = UDim2.new(1, -42, 0, 0), Size = UDim2.new(0, 42, 0, 15),
                TextXAlignment = Enum.TextXAlignment.Right, FontFace = FONT_BOLD, TextSize = 12,
            })

            local bar = create("Frame", { Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1 })
            local trk = create("Frame", {
                Parent = bar, Position = UDim2.new(0, 5, 0.5, -3), Size = UDim2.new(1, -10, 0, 6),
                BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
            }, { corner(3) })
            local fill = create("Frame", { Parent = trk, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, {
                corner(3),
                create("UIGradient", { Color = ColorSequence.new(Theme.AccentDim, Theme.Accent) }),
            })
            local knob = create("Frame", {
                Parent = trk, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                Size = UDim2.fromOffset(9, 15), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
            }, { corner(3) })

            local Slider = { Type = "Slider", CurrentValue = min, Flag = o.Flag }
            function Slider:Set(v, silent, nosave)
                v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
                v = tonumber(string.format("%.4f", v))
                self.CurrentValue = v
                local a = (v - min) / math.max(max - min, 1e-9)
                tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.08)
                tween(knob, { Position = UDim2.fromScale(a, 0.5) }, 0.08)
                val.Text = tostring(v) .. suffix
                if not silent and o.Callback then task.spawn(o.Callback, v) end
                if not nosave then saveConfig() end
            end
            function Slider:Get() return self.CurrentValue end
            function Slider:_ToConfig() return self.CurrentValue end
            function Slider:_FromConfig(v) if type(v) == "number" then self:Set(v) end end

            local dragging = false
            local function fromX(x)
                Slider:Set(min + (max - min) * math.clamp((x - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1))
            end
            bar.InputBegan:Connect(function(i)
                if isPress(i) then
                    dragging = true
                    tween(knob, { Size = UDim2.fromOffset(11, 17) }, 0.1)
                    fromX(i.Position.X)
                end
            end)
            connect(UserInputService.InputChanged, function(i) if dragging and isMove(i) then fromX(i.Position.X) end end)
            connect(UserInputService.InputEnded, function(i)
                if isPress(i) and dragging then
                    dragging = false
                    tween(knob, { Size = UDim2.fromOffset(9, 15) }, 0.12)
                end
            end)

            register(o, Slider)
            Slider:Set(pick(o, "CurrentValue", "Default") or min, true, true)
            return Slider
        end

        -- dropdown / multi dropdown -----------------------------------------------------
        function Tab:CreateDropdown(o)
            local c = card(o, 0)
            local multi = (o.MultipleOptions or o.Multi) and true or false
            local options = {}
            for _, v in ipairs(o.Options or {}) do table.insert(options, tostring(v)) end

            local ROW, MAXROWS, FOOT = 26, 6, 28
            local selected = {}
            local Dropdown = { Type = "Dropdown", CurrentOption = {}, Open = false, Flag = o.Flag }

            local wrap = create("Frame", {
                Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
            }, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

            local box = create("TextButton", {
                Parent = wrap, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = 0,
            }, { corner(5) })
            local boxStroke = stroke(Theme.Border, 1)
            boxStroke.Parent = box

            local shown = text({
                Parent = box, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -(multi and 64 or 34), 1, 0),
                TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = Theme.Desc, FontFace = FONT_SEMI,
            })
            local badge, badgeText
            if multi then
                badge = create("Frame", {
                    Parent = box, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -30, 0.5, 0),
                    Size = UDim2.fromOffset(20, 16), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Visible = false,
                }, { corner(8) })
                badgeText = text({
                    Parent = badge, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
                    FontFace = FONT_BOLD, TextSize = 10, TextColor3 = Theme.OnAccent, Text = "0",
                })
            end
            local arrow = icon({
                Parent = box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(14, 14),
            }, "chevron-down", Theme.Desc)

            local list = create("Frame", {
                Parent = wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                ClipsDescendants = true, LayoutOrder = 1, Visible = false,
            })
            local panel = create("Frame", {
                Parent = list, Position = UDim2.fromOffset(1, 5), Size = UDim2.new(1, -2, 1, -6),
                BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
            }, { corner(5), stroke(Theme.Border, 1) })

            local function visRows() return math.min(#options, MAXROWS) end

            local optScroll = create("ScrollingFrame", {
                Parent = panel, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 2),
                Size = UDim2.new(1, 0, 0, visRows() * ROW), ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent,
                CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            }, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

            local footer
            local function listHeight()
                return 5 + 2 + visRows() * ROW + (multi and FOOT or 0) + 2 + 1
            end

            local rows = {}

            local function ordered()
                local t = {}
                for _, opt in ipairs(options) do if selected[opt] then table.insert(t, opt) end end
                return t
            end

            local function visuals()
                local names = ordered()
                Dropdown.CurrentOption = names
                for opt, r in pairs(rows) do
                    local on = selected[opt] == true
                    tween(r.btn, { BackgroundTransparency = on and 0.93 or 1 }, 0.12)
                    if multi then
                        tween(r.label, { TextColor3 = on and Theme.Text or Theme.RowText })
                        tween(r.box, { BackgroundColor3 = on and Theme.Accent or Theme.Control })
                        tween(r.check, {
                            ImageTransparency = on and 0 or 1,
                            Size = on and UDim2.fromOffset(11, 11) or UDim2.fromOffset(4, 4),
                        }, 0.2, Enum.EasingStyle.Back)
                    else
                        tween(r.label, { TextColor3 = on and Theme.Accent or Theme.RowText })
                        tween(r.check, { ImageTransparency = on and 0 or 1 })
                    end
                end

                if #names == 0 then
                    shown.Text = multi and "None selected" or "Select..."
                    tween(shown, { TextColor3 = Theme.Desc })
                else
                    shown.Text = table.concat(names, ", ")
                    tween(shown, { TextColor3 = Theme.Text })
                end
                if badge then
                    local n = #names
                    badgeText.Text = tostring(n)
                    if n > 0 and not badge.Visible then
                        badge.Visible = true
                        badge.Size = UDim2.fromOffset(12, 10)
                        tween(badge, { Size = UDim2.fromOffset(20, 16) }, 0.25, Enum.EasingStyle.Back)
                    elseif n == 0 then
                        badge.Visible = false
                    end
                end
            end

            local function commit(silent, nosave)
                visuals()
                if not silent and o.Callback then task.spawn(o.Callback, Dropdown.CurrentOption) end
                if not nosave then saveConfig() end
            end

            local function setOpen(v)
                Dropdown.Open = v
                tween(arrow, { Rotation = v and 180 or 0, ImageColor3 = v and Theme.Accent or Theme.Desc }, 0.25, Enum.EasingStyle.Quint)
                tween(boxStroke, { Color = v and Theme.Accent or Theme.Border })
                if v then
                    list.Visible = true
                    tween(list, { Size = UDim2.new(1, 0, 0, listHeight()) }, 0.28, Enum.EasingStyle.Quint)
                else
                    tween(list, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quint).Completed:Connect(function()
                        if not Dropdown.Open then list.Visible = false end
                    end)
                end
            end

            local function rebuild()
                for _, r in pairs(rows) do r.btn:Destroy() end
                rows = {}
                optScroll.Size = UDim2.new(1, 0, 0, visRows() * ROW)
                if footer then footer.Position = UDim2.new(0, 0, 0, 2 + visRows() * ROW) end

                for i, opt in ipairs(options) do
                    local btn = create("TextButton", {
                        Parent = optScroll, Size = UDim2.new(1, 0, 0, ROW), BackgroundColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i,
                    })
                    local label = text({
                        Parent = btn, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -40, 1, 0),
                        Text = opt, FontFace = FONT_SEMI, TextSize = 12, TextColor3 = Theme.RowText,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    })
                    local r = { btn = btn, label = label }
                    if multi then
                        r.box = create("Frame", {
                            Parent = btn, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                            Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
                        }, { corner(3) })
                        r.check = icon({
                            Parent = r.box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                            Size = UDim2.fromOffset(4, 4), ImageTransparency = 1,
                        }, "check", Theme.OnAccent)
                    else
                        r.check = icon({
                            Parent = btn, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                            Size = UDim2.fromOffset(13, 13), ImageTransparency = 1,
                        }, "check", Theme.Accent)
                    end
                    btn.MouseEnter:Connect(function()
                        tween(btn, { BackgroundTransparency = selected[opt] and 0.88 or 0.95 }, 0.1)
                    end)
                    btn.MouseLeave:Connect(function()
                        tween(btn, { BackgroundTransparency = selected[opt] and 0.93 or 1 }, 0.1)
                    end)
                    btn.MouseButton1Click:Connect(function()
                        if multi then
                            if selected[opt] then selected[opt] = nil else selected[opt] = true end
                        else
                            table.clear(selected)
                            selected[opt] = true
                            setOpen(false)
                        end
                        commit()
                    end)
                    rows[opt] = r
                end
                visuals()
                if Dropdown.Open then list.Size = UDim2.new(1, 0, 0, listHeight()) end
            end

            if multi then
                footer = create("Frame", {
                    Parent = panel, BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 2 + visRows() * ROW),
                    Size = UDim2.new(1, 0, 0, FOOT),
                })
                create("Frame", {
                    Parent = footer, Size = UDim2.new(1, -16, 0, 1), Position = UDim2.fromOffset(8, 0),
                    BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
                })
                local function footBtn(label, xScale, fn)
                    local b = create("TextButton", {
                        Parent = footer, BackgroundTransparency = 1, Position = UDim2.new(xScale, 0, 0, 1),
                        Size = UDim2.new(0.5, 0, 1, -1), Text = label, FontFace = FONT_BOLD, TextSize = 11,
                        TextColor3 = Theme.Desc, AutoButtonColor = false,
                    })
                    b.MouseEnter:Connect(function() tween(b, { TextColor3 = Theme.Accent }) end)
                    b.MouseLeave:Connect(function() tween(b, { TextColor3 = Theme.Desc }) end)
                    b.MouseButton1Click:Connect(fn)
                end
                footBtn("Select all", 0, function()
                    for _, opt in ipairs(options) do selected[opt] = true end
                    commit()
                end)
                footBtn("Clear", 0.5, function()
                    table.clear(selected)
                    commit()
                end)
            end

            -- Dropdown:Set("One") or Dropdown:Set({ "One", "Two" })
            function Dropdown:Set(v, silent, nosave)
                table.clear(selected)
                local names = type(v) == "table" and v or { v }
                for _, n in ipairs(names) do
                    n = tostring(n)
                    if rows[n] then
                        selected[n] = true
                        if not multi then break end
                    end
                end
                commit(silent, nosave)
            end
            function Dropdown:Get() return self.CurrentOption end
            function Dropdown:Refresh(newOptions)
                options = {}
                for _, v in ipairs(newOptions or {}) do table.insert(options, tostring(v)) end
                for opt in pairs(selected) do
                    if not table.find(options, opt) then selected[opt] = nil end
                end
                rebuild()
            end
            function Dropdown:_ToConfig() return self.CurrentOption end
            function Dropdown:_FromConfig(v) self:Set(v) end

            box.MouseEnter:Connect(function()
                if not Dropdown.Open then tween(boxStroke, { Color = Theme.Control }) end
            end)
            box.MouseLeave:Connect(function()
                if not Dropdown.Open then tween(boxStroke, { Color = Theme.Border }) end
            end)
            box.MouseButton1Click:Connect(function() setOpen(not Dropdown.Open) end)
            connect(UserInputService.InputBegan, function(input)
                if Dropdown.Open and isPress(input) and not inside(wrap, UserInputService:GetMouseLocation()) then
                    setOpen(false)
                end
            end)

            rebuild()
            register(o, Dropdown)
            Dropdown:Set(pick(o, "CurrentOption", "Default") or {}, true, true)
            return Dropdown
        end

