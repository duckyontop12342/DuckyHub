                    ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
                    ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
                    ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
                    ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
                }),
            }),
        })
        local hueCursor = create("Frame", {
            Parent = hue, ZIndex = 22, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 16),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, { corner(2) })

        local preview = create("Frame", {
            Parent = popup, ZIndex = 21, Position = UDim2.fromOffset(10, 150), Size = UDim2.fromOffset(24, 24),
            BackgroundColor3 = Color3.fromHSV(h, s, v), BorderSizePixel = 0,
        }, { corner(6) })
        local hex = create("TextBox", {
            Parent = popup, ZIndex = 21, Position = UDim2.fromOffset(42, 150), Size = UDim2.fromOffset(PW - 52, 24),
            BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Text = "", PlaceholderText = "#RRGGBB",
            PlaceholderColor3 = Theme.Desc, TextColor3 = Theme.Text, FontFace = FONT_SEMI, TextSize = 12,
            ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
        }, { corner(5), padding(0, 8, 0, 8) })

        local Picker = { Type = "ColorPicker", Color = Color3.fromHSV(h, s, v), Flag = o.Flag }

        local function toHex(c3)
            return string.format("#%02X%02X%02X", math.floor(c3.R * 255 + 0.5), math.floor(c3.G * 255 + 0.5), math.floor(c3.B * 255 + 0.5))
        end
        local function visuals()
            Picker.Color = Color3.fromHSV(h, s, v)
            swatch.BackgroundColor3 = Picker.Color
            preview.BackgroundColor3 = Picker.Color
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svCursor.Position = UDim2.fromScale(s, 1 - v)
            hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
            if not hex:IsFocused() then hex.Text = toHex(Picker.Color) end
        end
        local function fire()
            if o.Callback then task.spawn(o.Callback, Picker.Color) end
            saveConfig()
        end

        function Picker:Set(color, silent, nosave)
            h, s, v = Color3.toHSV(color)
            visuals()
            if not silent and o.Callback then task.spawn(o.Callback, Picker.Color) end
            if not nosave then saveConfig() end
        end
        function Picker:Get() return self.Color end
        function Picker:_ToConfig()
            local c3 = self.Color
            return { math.floor(c3.R * 255 + 0.5), math.floor(c3.G * 255 + 0.5), math.floor(c3.B * 255 + 0.5) }
        end
        function Picker:_FromConfig(t)
            if type(t) == "table" and #t >= 3 then self:Set(Color3.fromRGB(t[1], t[2], t[3])) end
        end

        local mode
        local function drag(pos)
            if mode == "sv" then
                s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
                v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
            elseif mode == "hue" then
                h = math.clamp((pos.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
            end
            visuals()
            fire()
        end
        sv.InputBegan:Connect(function(i) if isPress(i) then mode = "sv"; drag(screenPos(i)) end end)
        hue.InputBegan:Connect(function(i) if isPress(i) then mode = "hue"; drag(screenPos(i)) end end)
        connect(UserInputService.InputChanged, function(i) if mode and isMove(i) then drag(screenPos(i)) end end)
        connect(UserInputService.InputEnded, function(i) if isPress(i) then mode = nil end end)

        hex.FocusLost:Connect(function()
            local txt = hex.Text:gsub("[#%s]", "")
            if #txt == 6 and tonumber(txt, 16) then
                local n = tonumber(txt, 16)
                Picker:Set(Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256))
            else
                visuals()
            end
        end)

        local function close()
            popup.Visible = false
            catcher.Visible = false
            if Window._closePicker == close then Window._closePicker = nil end
        end
        swatch.MouseButton1Click:Connect(function()
            if popup.Visible then close(); return end
            if Window._closePicker then Window._closePicker() end
            local rel = (swatch.AbsolutePosition - main.AbsolutePosition) / scale.Scale
            local x = math.clamp(rel.X + 22 - PW, 8, WIN_W - PW - 8)
            local y = rel.Y + 28
            if y + PH > WIN_H - 8 then y = rel.Y - PH - 6 end
            popup.Position = UDim2.fromOffset(x, math.max(y, 8))
            catcher.Visible = true
            popup.Visible = true
            Window._closePicker = close
            visuals()
        end)
        catcher.MouseButton1Click:Connect(close)
        catcher.InputBegan:Connect(function(i) if isPress(i) then close() end end)

        register(o, Picker)
        visuals()
        return Picker
    end

    -- keybind -----------------------------------------------------------------------
    function Tab:CreateKeybind(o)
        local _, head = card(o, 84)
        local key = parseKey(pick(o, "CurrentKeybind", "Default") or "Q", Enum.KeyCode.Q)
        local Keybind = { Type = "Keybind", CurrentKeybind = key.Name, Flag = o.Flag }

        local box = create("TextButton", {
            Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Field,
            BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        }, { corner(5), padding(0, 10, 0, 10) })
        local lab = text({
            Parent = box, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            TextXAlignment = Enum.TextXAlignment.Center, Text = key.Name, FontFace = FONT_BOLD, TextSize = 11,
        })

        local listening, held = false, false

        local function setKey(kc, silent, nosave)
            key = kc
            Keybind.CurrentKeybind = kc.Name
            lab.Text = kc.Name
            if not silent and o.ChangedCallback then task.spawn(o.ChangedCallback, kc.Name) end
            if not nosave then saveConfig() end
        end

        function Keybind:Set(v, silent, nosave) setKey(parseKey(v, key), silent, nosave) end
        function Keybind:Get() return self.CurrentKeybind end
        function Keybind:_ToConfig() return self.CurrentKeybind end
        function Keybind:_FromConfig(v) self:Set(v) end -- fires ChangedCallback so loaded binds apply

        box.MouseButton1Click:Connect(function()
            listening = true
            Window._capturing = true
            lab.Text = "Press a key..."
            tween(box, { BackgroundColor3 = Theme.Track })
            tween(lab, { TextColor3 = Theme.Accent })
        end)
        box.MouseEnter:Connect(function() if not listening then tween(box, { BackgroundColor3 = Theme.Track }) end end)
        box.MouseLeave:Connect(function() if not listening then tween(box, { BackgroundColor3 = Theme.Field }) end end)

        connect(UserInputService.InputBegan, function(input, gpe)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if listening then
                listening = false
                task.defer(function() Window._capturing = false end)
                tween(box, { BackgroundColor3 = Theme.Field })
                tween(lab, { TextColor3 = Theme.Text })
                if input.KeyCode == Enum.KeyCode.Escape then
                    lab.Text = key.Name
                else
                    setKey(input.KeyCode)
                end
                return
            end
            if gpe or Window._capturing or UserInputService:GetFocusedTextBox() then return end
            if input.KeyCode == key then
                if o.HoldToInteract then
                    held = true
                    if o.Callback then task.spawn(o.Callback, true) end
                elseif o.Callback then
                    task.spawn(o.Callback, key.Name)
                end
            end
        end)
        connect(UserInputService.InputEnded, function(input)
            if held and input.KeyCode == key then
                held = false
                if o.Callback then task.spawn(o.Callback, false) end
            end
        end)

        register(o, Keybind)
        return Keybind
    end

    -- text input --------------------------------------------------------------------
    function Tab:CreateInput(o)
        local c = card(o, 0)
        local field = create("TextBox", {
            Parent = c, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
            Text = tostring(pick(o, "CurrentValue", "Default") or ""),
            PlaceholderText = o.PlaceholderText or "Type here...", PlaceholderColor3 = Theme.Desc,
            TextColor3 = Theme.Text, FontFace = FONT_SEMI, TextSize = 12, ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
        }, { corner(5), padding(0, 12, 0, 12) })

        local Input = { Type = "Input", CurrentValue = field.Text, Flag = o.Flag }
        local stroke_ = stroke(Theme.Border, 1)
        stroke_.Parent = field
        if o.Numeric or o.MaxLength then
            field:GetPropertyChangedSignal("Text"):Connect(function()
                local t = field.Text
                if o.Numeric then t = t:gsub("[^%d%.%-]", "") end
                if o.MaxLength then t = t:sub(1, o.MaxLength) end
                if t ~= field.Text then field.Text = t end
            end)
        end
        function Input:Set(t, silent, nosave)
            field.Text = tostring(t)
            self.CurrentValue = field.Text
            if not silent and o.Callback then task.spawn(o.Callback, self.CurrentValue) end
            if not nosave then saveConfig() end
        end
        function Input:Get() return self.CurrentValue end
        function Input:_ToConfig() return self.CurrentValue end
        function Input:_FromConfig(v) self:Set(tostring(v)) end

        field.Focused:Connect(function() tween(field, { BackgroundColor3 = Theme.Track }); tween(stroke_, { Color = Theme.Accent }) end)
        field.FocusLost:Connect(function()
            tween(field, { BackgroundColor3 = Theme.Field }); tween(stroke_, { Color = Theme.Border })
            Input.CurrentValue = field.Text
            if o.Callback then task.spawn(o.Callback, field.Text) end
            saveConfig()
            if o.RemoveTextAfterFocusLost then field.Text = "" end
        end)

        register(o, Input)
        return Input
    end

