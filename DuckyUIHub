-- notifications -------------------------------------------------------------

local notifGui, notifHolder, notifOrder = nil, nil, 0

local function ensureNotifHolder()
    if notifGui and notifGui.Parent then return notifHolder end
    notifGui = create("ScreenGui", {
        Name = "DuckyNotifications", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, Parent = protectedParent(),
    })
    notifHolder = create("Frame", {
        Parent = notifGui, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 290, 1, -32),
    }, {
        create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }),
    })
    return notifHolder
end

-- Ducky:Notify({ Title, Content, Duration = 5, Image = "bird" })
function Ducky:Notify(o)
    o = o or {}
    local holder = ensureNotifHolder()
    notifOrder += 1
    local duration = o.Duration or 5
    local hasIcon = o.Image ~= nil

    local wrapper = create("Frame", {
        Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = notifOrder,
    })
    local card = create("Frame", {
        Parent = wrapper, Position = UDim2.new(0, 320, 0, 0), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
        ClipsDescendants = true,
    }, { corner(8), stroke(Theme.Border, 1) })

    create("Frame", { -- accent bar
        Parent = card, Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    })
    if hasIcon then
        icon({ Parent = card, Position = UDim2.fromOffset(16, 13), Size = UDim2.fromOffset(18, 18) }, o.Image, Theme.Accent)
    end

    local body = create("Frame", {
        Parent = card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    }, {
        padding(12, 14, 14, hasIcon and 44 or 16),
        create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    text({
        Parent = body, Size = UDim2.new(1, 0, 0, 16), Text = o.Title or "Notification",
        FontFace = FONT_BOLD, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 0,
    })
    if o.Content and o.Content ~= "" then
        text({
            Parent = body, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Text = o.Content, TextColor3 = Theme.Desc, TextSize = 12, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1,
        })
    end

    local progress = create("Frame", {
        Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(card, { Position = UDim2.new(0, 320, 0, 0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.32, function() wrapper:Destroy() end)
    end

    local hit = create("TextButton", { Parent = card, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 5 })
    hit.MouseButton1Click:Connect(close)

    tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Quint)
    tween(progress, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, close)

    return { Close = close }
end

function Ducky:Destroy()
    if Ducky._window then Ducky._window:Destroy() end
end

function Ducky:LoadConfiguration()
    if Ducky._window then return Ducky._window:LoadConfiguration() end
    return false
end

-- window -------------------------------------------------------------------

function Ducky:CreateWindow(opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}

    for k, v in pairs(opts.Theme or {}) do Theme[k] = v end
    loadLucide()

    local name      = opts.Name or "Ducky"
    local logoText  = opts.Logo or opts.Title or "Ducky"
    local keybind   = parseKey(opts.Keybind or opts.ToggleUIKeybind, Enum.KeyCode.RightShift)
    local winSize   = opts.Size or Vector2.new(620, 360)
    local WIN_W, WIN_H = winSize.X, winSize.Y

    local cs  = opts.ConfigurationSaving
    local cfg = {
        enabled = cs and cs.Enabled == true,
        folder  = cs and cs.FolderName,
        file    = ((cs and cs.FileName) or "Config") .. ".json",
    }
    local function cfgPath()
        return cfg.folder and (cfg.folder .. "/" .. cfg.file) or cfg.file
    end

    local parent = protectedParent()
    local old = parent:FindFirstChild("DuckyUI")
    if old then old:Destroy() end
    table.clear(Ducky.Flags)

    local Window = { Tabs = {}, Connections = {}, Flags = Ducky.Flags, Open = true, Loaded = false, Actions = 0 }
    Ducky._window = Window

    local function connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(Window.Connections, c)
        return c
    end

    local gui = create("ScreenGui", {
        Name = "DuckyUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parent,
    })
    Window.Gui = gui

    local main = create("CanvasGroup", {
        Name = "Main", Parent = gui, BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
        Size = UDim2.fromOffset(WIN_W, WIN_H), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 1, Visible = false,
    }, { corner(8), stroke(Theme.Border, 1) })
    local scale = create("UIScale", { Parent = main, Scale = 0.9 })
    Window.Main = main

    -- configuration saving ---------------------------------------------------
    local saveToken, loadingConfig = 0, false

    local function saveConfig()
        if not cfg.enabled or loadingConfig then return end
        saveToken += 1
        local token = saveToken
        task.delay(0.4, function()
            if token ~= saveToken then return end
            local data = {}
            for flag, el in pairs(Ducky.Flags) do
                if el._ToConfig then data[flag] = el:_ToConfig() end
            end
            pcall(function()
                if cfg.folder and makefolder and isfolder and not isfolder(cfg.folder) then makefolder(cfg.folder) end
                writefile(cfgPath(), HttpService:JSONEncode(data))
            end)
        end)
    end

    function Window:LoadConfiguration()
        if not cfg.enabled then return false end
        local ok, data = pcall(function()
            if not (isfile and isfile(cfgPath())) then return nil end
            return HttpService:JSONDecode(readfile(cfgPath()))
        end)
        if not ok or type(data) ~= "table" then return false end
        loadingConfig = true
        for flag, value in pairs(data) do
            local el = Ducky.Flags[flag]
            if el and el._FromConfig then pcall(el._FromConfig, el, value) end
        end
        loadingConfig = false
        return true
    end

    -- sidebar -------------------------------------------------------------
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Size = UDim2.new(0, SIDEBAR_W, 1, 0) })
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Position = UDim2.fromOffset(SIDEBAR_W, 0), Size = UDim2.new(0, 1, 1, 0) })

    local logoArea = create("Frame", {
        Parent = main, BackgroundTransparency = 1, Size = UDim2.fromOffset(SIDEBAR_W, 76), Active = true,
    })
    local logo = text({
        Parent = logoArea, Position = UDim2.fromOffset(6, 18), Size = UDim2.new(1, -12, 0, 30),
        TextXAlignment = Enum.TextXAlignment.Center, Text = logoText, TextScaled = true,
        FontFace = FONT_ITAL,
    }, nil)
    create("UITextSizeConstraint", { Parent = logo, MaxTextSize = 24, MinTextSize = 10 })
    create("UIGradient", { Parent = logo, Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) })

    -- underline that fades out to the right
    local underline = create("Frame", {
        Parent = logoArea, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50),
        Size = UDim2.fromOffset(LOGO_W, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, {
        create("UIGradient", {
            Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.5, 0.35),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    local tabList = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 80), Size = UDim2.new(0, SIDEBAR_W, 1, -80),
    }, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }) })

    local pages = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(SIDEBAR_W + 12, 16),
        Size = UDim2.new(1, -(SIDEBAR_W + 12 + 44), 1, -32),
    })

    -- drag --------------------------------------------------------------------
    do
        local dragArea = create("Frame", { Parent = main, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), ZIndex = 0, Active = true })
        local dragging, startPos, startInput
        local function begin(frame)
            connect(frame.InputBegan, function(input)
                if isPress(input) then dragging, startPos, startInput = true, main.Position, input.Position end
            end)
        end
        begin(dragArea)
        begin(logoArea)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) then
                local d = input.Position - startInput
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    -- custom scrollbar --------------------------------------------------------
    local track = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.new(1, -34, 0, 16), Size = UDim2.new(0, 10, 1, -32),
    })
    local thumb = create("Frame", {
        Parent = track, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40), Visible = false,
    }, {
        corner(5),
        create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) }),
    })
    local thumbHit = create("TextButton", { Parent = thumb, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "" })

    local currentTab, currentPage
    local barConns = {}

    local function updateBar()
        local s = currentPage and currentPage.Scroll
        if not s then thumb.Visible = false; return end
        local view, canvas = s.AbsoluteWindowSize.Y, s.AbsoluteCanvasSize.Y
        if canvas <= view + 1 then thumb.Visible = false; return end
        thumb.Visible = true
        local trackH = track.AbsoluteSize.Y
        local h = math.max(30, trackH * view / canvas)
        local a = math.clamp(s.CanvasPosition.Y / (canvas - view), 0, 1)
        thumb.Size = UDim2.new(1, 0, 0, h)
        thumb.Position = UDim2.new(0, 0, 0, (trackH - h) * a)
    end

    local function bindBar(scroll)
        for _, c in ipairs(barConns) do c:Disconnect() end
        table.clear(barConns)
        for _, prop in ipairs({ "CanvasPosition", "AbsoluteCanvasSize", "AbsoluteWindowSize" }) do
            table.insert(barConns, scroll:GetPropertyChangedSignal(prop):Connect(updateBar))
        end
        updateBar()
    end

    do
        local dragging, startY, startCanvas
        thumbHit.InputBegan:Connect(function(input)
            if isPress(input) and currentPage then
                dragging, startY, startCanvas = true, input.Position.Y, currentPage.Scroll.CanvasPosition.Y
            end
        end)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) and currentPage then
                local s = currentPage.Scroll
                local trackRange = track.AbsoluteSize.Y - thumb.AbsoluteSize.Y
                local maxScroll = s.AbsoluteCanvasSize.Y - s.AbsoluteWindowSize.Y
                if trackRange > 0 then
                    s.CanvasPosition = Vector2.new(0, startCanvas + (input.Position.Y - startY) / trackRange * maxScroll)
                end
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    -- top-right actions -------------------------------------------------------
    function Window:AddAction(o)
        local y = 18 + Window.Actions * 24
        Window.Actions += 1
        local b = create("TextButton", {
            Parent = main, BackgroundTransparency = 1, Text = "",
            Position = UDim2.new(1, -22, 0, y), Size = UDim2.fromOffset(16, 16),
        })
        local ico = icon({ Parent = b, Size = UDim2.fromScale(1, 1) }, o.Icon or "settings", Theme.TabIdle)
        b.MouseEnter:Connect(function() tween(ico, { ImageColor3 = Theme.Accent }) end)
        b.MouseLeave:Connect(function() tween(ico, { ImageColor3 = Theme.TabIdle }) end)
        b.MouseButton1Down:Connect(function() tween(ico, { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1) }, 0.08) end)
        b.MouseButton1Up:Connect(function() tween(ico, { Size = UDim2.fromScale(1, 1), Position = UDim2.new() }, 0.15, Enum.EasingStyle.Back) end)
        b.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
    end

    function Window:Notify(o) return Ducky:Notify(o) end

    -- selection ---------------------------------------------------------------
    local function refreshTabs()
        for _, tab in ipairs(Window.Tabs) do
            local active = tab == currentTab
            local color = active and Theme.Accent or Theme.TabIdle
            tween(tab.Fill, { BackgroundTransparency = active and 0 or 1 }, 0.25)
            tween(tab.Bar, { Size = UDim2.new(0, 3, active and 0.55 or 0, 0) }, 0.25, Enum.EasingStyle.Quint)
            tween(tab.Label, { TextColor3 = color })
            tween(tab.Icon, { ImageColor3 = color, Position = UDim2.new(0.5, -11, 0, 15) })
        end
    end

    local function select(tab)
        local previous = currentPage
        local page = tab.Page
        currentTab, currentPage = tab, page
        for _, t in ipairs(Window.Tabs) do
            if t.Page ~= page then t.Page.Frame.Visible = false end
        end
        if page ~= previous then
            page.Frame.Position = UDim2.fromOffset(0, 14)
            page.Frame.GroupTransparency = 1
            page.Frame.Visible = true
            tween(page.Frame, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quint)
        end
        bindBar(page.Scroll)
        refreshTabs()
    end

    -- items -------------------------------------------------------------------------
    local function installItems(Tab, page)
        local scroll = page.Scroll
        local order = 0

        local function register(o, ctrl)
            if o.Flag then Ducky.Flags[o.Flag] = ctrl end
        end

        -- card with title (+ optional description). `reserve` = px kept free on the right of the head for a control
        local function card(o, reserve)
            reserve = reserve or 0
            order += 1
            local cols = o.Columns or 1
            local c = create("Frame", {
                Parent = scroll, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
                Size = columnWidth(cols), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order,
            }, {
                corner(6), padding(10, 12, 10, 12),
                create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
            })
            c.MouseEnter:Connect(function() tween(c, { BackgroundColor3 = Theme.CardHover }) end)
            c.MouseLeave:Connect(function() tween(c, { BackgroundColor3 = Theme.Card }) end)

            local head = create("Frame", {
                Parent = c, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, o.Description and 31 or 16), LayoutOrder = 0,
            })
            local title = text({
                Parent = head, Size = UDim2.new(1, -reserve, 0, 15), Text = o.Name or "Item",
                FontFace = FONT_BOLD, TextSize = cols >= 3 and 12 or 13, TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local desc
            if o.Description then
                desc = text({
                    Parent = head, Position = UDim2.fromOffset(0, 17), Size = UDim2.new(1, -reserve, 0, 13),
                    Text = o.Description, TextColor3 = Theme.Desc, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
            return c, head, title, desc
        end

