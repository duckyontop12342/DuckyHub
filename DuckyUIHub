        function Tab:CreateKeybind(o)
            local _, head = card(o, 84)
            local key = parseKey(pick(o, "CurrentKeybind", "Default") or "Q", Enum.KeyCode.Q)
            local Keybind = { Type = "Keybind", CurrentKeybind = key.Name, Flag = o.Flag }

            local box = create("TextButton", {
                Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            }, { corner(5), padding(0, 10, 0, 10) })
            local lab = text({
                Parent = box, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
                TextXAlignment = Enum.TextXAlignment.Center, Text = key.Name, FontFace = FONT_BOLD, TextSize = 11,
            })

            local listening, held = false, false

            local function setKey(kc, silent, nosave)
                key = kc
                Keybind.CurrentKeybind = kc.Name
                lab.Text = kc.Name
                if not silent and o.ChangedCallback then task.spawn(o.ChangedCallback, kc.Name) end
                if not nosave then saveConfig() end
            end

            function Keybind:Set(v, silent, nosave) setKey(parseKey(v, key), silent, nosave) end
            function Keybind:Get() return self.CurrentKeybind end
            function Keybind:_ToConfig() return self.CurrentKeybind end
            function Keybind:_FromConfig(v) self:Set(v, true) end

            box.MouseButton1Click:Connect(function()
                listening = true
                lab.Text = "..."
                tween(box, { BackgroundColor3 = Theme.Track })
                tween(lab, { TextColor3 = Theme.Accent })
            end)
            box.MouseEnter:Connect(function() if not listening then tween(box, { BackgroundColor3 = Theme.Track }) end end)
            box.MouseLeave:Connect(function() if not listening then tween(box, { BackgroundColor3 = Theme.Field }) end end)

            connect(UserInputService.InputBegan, function(input, gpe)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if listening then
                    listening = false
                    tween(box, { BackgroundColor3 = Theme.Field })
                    tween(lab, { TextColor3 = Theme.Text })
                    if input.KeyCode == Enum.KeyCode.Escape then
                        lab.Text = key.Name
                    else
                        setKey(input.KeyCode)
                    end
                    return
                end
                if gpe or UserInputService:GetFocusedTextBox() then return end
                if input.KeyCode == key then
                    if o.HoldToInteract then
                        held = true
                        if o.Callback then task.spawn(o.Callback, true) end
                    elseif o.Callback then
                        task.spawn(o.Callback, key.Name)
                    end
                end
            end)
            connect(UserInputService.InputEnded, function(input)
                if held and input.KeyCode == key then
                    held = false
                    if o.Callback then task.spawn(o.Callback, false) end
                end
            end)

            register(o, Keybind)
            return Keybind
        end

