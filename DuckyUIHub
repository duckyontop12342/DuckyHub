local restPos = main.Position

local function show()
    Window.Open = true
    Window.Loaded = true
    setPill(true)
    main.Position = restPos + UDim2.fromOffset(0, 18)
    scale.Scale = baseScale * 0.95
    main.Visible = true
    underline.Size = UDim2.fromOffset(0, 2)
    tween(main, { GroupTransparency = 0, Position = restPos }, 0.4, Enum.EasingStyle.Quint)
    tween(scale, { Scale = baseScale }, 0.45, Enum.EasingStyle.Quint)
    tween(underline, { Size = UDim2.fromOffset(LOGO_W, 2) }, 0.7, Enum.EasingStyle.Quint)
    task.delay(0.05, updateBar)
    task.delay(0.45, updateBar)
end

local function hide()
    if Window._closePicker then Window._closePicker() end
    if Window._dialog then Window._dialog() end
    hideTip()
    Window.Open = false
    setPill(false)
    restPos = main.Position
    tween(main, { GroupTransparency = 1, Position = restPos + UDim2.fromOffset(0, 12) }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    tween(scale, { Scale = baseScale * 0.96 }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In).Completed:Connect(function()
        if not Window.Open then
            main.Visible = false
            main.Position = restPos
        end
    end)
end

function Window:Toggle()
    if not Window.Loaded then return end
    if Window.Open then hide() else show() end
end
function Window:Show() if Window.Loaded and not Window.Open then show() end end
function Window:Hide() if Window.Loaded and Window.Open then hide() end end

function Window:OnDestroy(fn) table.insert(Window.DestroyCallbacks, fn) end
function Window:SetKeybind(k) keybind = parseKey(k, keybind) end

function Window:Destroy()
    for _, fn in ipairs(Window.DestroyCallbacks) do pcall(fn) end
    for _, c in ipairs(Window.Connections) do c:Disconnect() end
    hideTip()
    gui:Destroy()
    if Ducky._window == Window then Ducky._window = nil end
end

