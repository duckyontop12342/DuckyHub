-- loading screen: animated spinner, title, progress bar with % (matches the window style)
if opts.LoadingEnabled == false then
    task.defer(show)
else
    local duration = opts.LoadingTime or 2.6
    -- spinner styles: "Sphere" (default), "Dots", "Arc", "Pulse", "Bars", "Orbit", or "Random"
    local STYLES = { "Sphere", "Dots", "Arc", "Pulse", "Bars", "Orbit" }
    local style = opts.LoadingStyle or "Sphere"
    if style == "Random" or not table.find(STYLES, style) then
        style = style == "Random" and STYLES[math.random(1, #STYLES)] or "Sphere"
    end
    local round = function() return create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) end
    local CY = 64

    local function buildSpinner(host)
        local center = UDim2.new(0.5, 0, 0, CY)
        local half = Vector2.new(0.5, 0.5)

        if style == "Sphere" then
            -- 3D particle globe: perspective, lighting from the top-left, and a tilted ring of dust
            local R = 46
            local rng = Random.new(11)
            local white = Color3.new(1, 1, 1)
            local light = Vector3.new(-0.5, -0.6, 0.62).Unit

            local pts = {}
            local function addPoint(x, y, z, kind)
                local d = create("Frame", {
                    Parent = host, AnchorPoint = half, BorderSizePixel = 0, BackgroundColor3 = white,
                    Size = UDim2.fromOffset(2, 2), Position = center, BackgroundTransparency = 1,
                }, { round() })
                table.insert(pts, {
                    x = x, y = y, z = z, kind = kind, d = d,
                    sx = rng:NextNumber(-1, 1) * 1.8, sy = rng:NextNumber(-1, 1) * 1.8,
                    tw = rng:NextNumber(0, 6.28), sp = rng:NextNumber(1.5, 3.5),
                })
            end
            for _ = 1, 300 do -- globe: uniform in angle, so denser at the poles
                local theta = rng:NextNumber(0, math.pi * 2)
                local phi = rng:NextNumber(0, math.pi)
                addPoint(math.sin(phi) * math.cos(theta), math.cos(phi), math.sin(phi) * math.sin(theta), 0)
            end
            for i = 1, 90 do -- ring of dust, on a plane around the globe
                local a = i / 90 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
                local rr = 1.38 + rng:NextNumber(-0.07, 0.07)
                addPoint(math.cos(a) * rr, rng:NextNumber(-0.02, 0.02), math.sin(a) * rr, 1)
            end

            local t0
            return function(now)
                t0 = t0 or now
                local form = math.clamp((now - t0) / 1.2, 0, 1)
                form = 1 - (1 - form) ^ 3
                local yaw = now * 0.8
                local pitch = 0.42 + math.sin(now * 0.45) * 0.1
                local cp, sp = math.cos(pitch), math.sin(pitch)
                local breathe = 1 + math.sin(now * 2) * 0.02
                local accent = Theme.Accent
                local dim = accent:Lerp(Color3.new(0, 0, 0), 0.55)

                for _, p in ipairs(pts) do
                    local ryaw = p.kind == 1 and (yaw * -1.6) or yaw
                    local cy_, sy_ = math.cos(ryaw), math.sin(ryaw)
                    local x1 = p.x * cy_ + p.z * sy_
                    local z1 = -p.x * sy_ + p.z * cy_
                    local y2 = p.y * cp - z1 * sp
                    local z2 = p.y * sp + z1 * cp

                    local persp = 1.9 / (1.9 - z2 * 0.55) -- nearer dots are bigger and pushed outwards
                    local px = x1 * persp * form + p.sx * (1 - form)
                    local py = y2 * persp * form + p.sy * (1 - form)

                    local depth = math.clamp((z2 + 1.4) / 2.8, 0, 1)
                    local shade
                    if p.kind == 0 then
                        local n = Vector3.new(x1, y2, z2)
                        shade = math.clamp(n:Dot(light) * 0.5 + 0.55, 0, 1) -- lit side vs dark side
                    else
                        shade = depth
                    end

                    local d = p.d
                    d.Position = UDim2.new(0.5, px * R * breathe, 0, CY + py * R * breathe)
                    local sz = (1.1 + depth * 2.6) * (p.kind == 1 and 0.8 or 1)
                    d.Size = UDim2.fromOffset(sz, sz)
                    d.ZIndex = 2 + math.floor(depth * 100)
                    local twinkle = 0.7 + 0.3 * (0.5 + 0.5 * math.sin(now * p.sp + p.tw))
                    d.BackgroundTransparency = math.clamp(1 - (0.12 + depth * 0.8) * twinkle * form, 0, 1)
                    d.BackgroundColor3 = dim:Lerp(accent, math.min(1, shade * 1.4)):Lerp(white, math.max(0, shade - 0.65) * 1.6)
                end
            end
        elseif style == "Arc" then
            local ring = create("Frame", {
                Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(42, 42),
                BackgroundTransparency = 1,
            }, { round(), stroke(Theme.Track, 3) })
            local arcF = create("Frame", { Parent = ring, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, { round() })
            local st = create("UIStroke", { Parent = arcF, Color = Color3.new(1, 1, 1), Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
            local g = create("UIGradient", {
                Parent = st, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.15),
                    NumberSequenceKeypoint.new(0.65, 1), NumberSequenceKeypoint.new(1, 1),
                }),
            })
            return function(now) g.Rotation = (now * 330) % 360 end

        elseif style == "Pulse" then
            local rings = {}
            for i = 1, 3 do
                local r = create("Frame", {
                    Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(8, 8),
                    BackgroundTransparency = 1,
                }, { round() })
                rings[i] = { frame = r, stroke = create("UIStroke", { Parent = r, Color = Theme.Accent, Thickness = 2 }) }
            end
            create("Frame", {
                Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(10, 10),
                BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
            }, { round() })
            return function(now)
                for i, r in ipairs(rings) do
                    local p = (now * 0.8 + (i - 1) / 3) % 1
                    local sz = 12 + 50 * p
                    r.frame.Size = UDim2.fromOffset(sz, sz)
                    r.stroke.Transparency = 0.15 + 0.85 * p
                end
            end

        elseif style == "Bars" then
            local bars = {}
            for i = 1, 5 do
                bars[i] = create("Frame", {
                    Parent = host, AnchorPoint = half, Position = UDim2.new(0.5, (i - 3) * 10, 0, CY),
                    Size = UDim2.fromOffset(5, 10), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
                }, { corner(2) })
            end
            return function(now)
                for i, b in ipairs(bars) do
                    local k = (math.sin(now * 5 - i * 0.7) + 1) / 2
                    b.Size = UDim2.fromOffset(5, 8 + 26 * k)
                    b.BackgroundTransparency = 0.5 * (1 - k)
                end
            end

        elseif style == "Orbit" then
            create("Frame", {
                Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(44, 44),
                BackgroundTransparency = 1,
            }, { round(), stroke(Theme.Track, 1) })
            local core = create("Frame", {
                Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(8, 8),
                BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
            }, { round() })
            local sats = {}
            for i = 1, 3 do
                local sz = 10 - (i - 1) * 2
                sats[i] = create("Frame", {
                    Parent = host, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(sz, sz),
                    BackgroundColor3 = Theme.Accent, BackgroundTransparency = (i - 1) * 0.3, BorderSizePixel = 0,
                }, { round() })
            end
            return function(now)
                for i, d in ipairs(sats) do
                    local a = now * 3.2 - (i - 1) * 0.35
                    d.Position = UDim2.new(0.5, math.cos(a) * 22, 0, CY + math.sin(a) * 22)
                end
                local k = (math.sin(now * 4) + 1) / 2
                core.Size = UDim2.fromOffset(6 + 4 * k, 6 + 4 * k)
            end
        end

        -- "Dots": bright head with a fading tail going round
        local dots = {}
        for i = 1, 12 do
            local a = (i - 1) / 12 * math.pi * 2 - math.pi / 2
            dots[i] = create("Frame", {
                Parent = host, AnchorPoint = half, BorderSizePixel = 0,
                Position = UDim2.new(0.5, math.cos(a) * 20, 0, CY + math.sin(a) * 20),
                Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Theme.Accent,
            }, { round() })
        end
        return function(now)
            for i, d in ipairs(dots) do
                local phase = (now * 1.1 - (i - 1) / 12) % 1
                local sz = 3 + 6 * (1 - phase)
                d.Size = UDim2.fromOffset(sz, sz)
                d.BackgroundTransparency = 0.1 + 0.8 * phase
            end
        end
    end

    local backdrop, card

    local ok = pcall(function()
        backdrop = create("Frame", {
            Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
        })
        card = create("CanvasGroup", {
            Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(340, 246), BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
            GroupTransparency = 1,
        }, { corner(10), stroke(Theme.Border, 1) })
        local lscale = create("UIScale", { Parent = card, Scale = 0.94 })

        local spin = buildSpinner(card)

        local ltitle = text({
            Parent = card, Position = UDim2.fromOffset(20, 124), Size = UDim2.new(1, -40, 0, 30),
            TextXAlignment = Enum.TextXAlignment.Center, Text = opts.LoadingTitle or name,
            TextScaled = true, FontFace = FONT_ITAL,
        })
        create("UITextSizeConstraint", { Parent = ltitle, MaxTextSize = 24, MinTextSize = 12 })
        create("UIGradient", { Parent = ltitle, Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) })

        local lunder = create("Frame", {
            Parent = card, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 156),
            Size = UDim2.fromOffset(0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, {
            create("UIGradient", {
                Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1),
                }),
            }),
        })

        text({
            Parent = card, Position = UDim2.fromOffset(20, 164), Size = UDim2.new(1, -40, 0, 16),
            TextXAlignment = Enum.TextXAlignment.Center, Text = opts.LoadingSubtitle or "Loading interface",
            TextColor3 = Theme.Desc, FontFace = FONT_SEMI, TextSize = 12,
        })

        local barTrack = create("Frame", {
            Parent = card, Position = UDim2.new(0, 30, 0, 196), Size = UDim2.new(1, -60, 0, 6),
            BackgroundColor3 = Theme.Track, BorderSizePixel = 0,
        }, { corner(3) })
        local barFill = create("Frame", {
            Parent = barTrack, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, {
            corner(3),
            create("UIGradient", { Color = ColorSequence.new(Theme.AccentDim, Theme.Accent) }),
        })
        local status = text({
            Parent = card, Position = UDim2.fromOffset(30, 208), Size = UDim2.new(0.6, 0, 0, 14),
            Text = "Starting...", TextColor3 = Theme.Desc, FontFace = FONT_SEMI, TextSize = 11,
        })
        local pct = text({
            Parent = card, Position = UDim2.new(1, -80, 0, 206), Size = UDim2.fromOffset(50, 16),
            TextXAlignment = Enum.TextXAlignment.Right, Text = "0%", FontFace = FONT_BOLD, TextSize = 13,
            TextColor3 = Theme.Text,
        })

        tween(backdrop, { BackgroundTransparency = 0.5 }, 0.3)
        tween(card, { GroupTransparency = 0 }, 0.3)
        tween(lscale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
        tween(lunder, { Size = UDim2.fromOffset(110, 2) }, 0.8, Enum.EasingStyle.Quint)

        task.spawn(function()
            local start = os.clock()
            while card.Parent do
                local now = os.clock()
                local t = math.clamp((now - start) / duration, 0, 1)
                local p = t < 0.5 and 2 * t * t or 1 - (-2 * t + 2) ^ 2 / 2
                barFill.Size = UDim2.fromScale(p, 1)
                pct.Text = string.format("%d%%", math.floor(p * 100 + 0.5))
                status.Text = p < 0.34 and "Loading icons..." or p < 0.7 and "Building interface..." or p < 1 and "Almost ready..." or "Ready"

                spin(now)

                if t >= 1 then break end
                task.wait()
            end
        end)
    end)

    task.spawn(function()
        task.wait(duration + 0.4)
        pcall(function()
            if card then tween(card, { GroupTransparency = 1 }, 0.25) end
            if backdrop then tween(backdrop, { BackgroundTransparency = 1 }, 0.3) end
        end)
        task.wait(0.32)
        pcall(function()
            if card then card:Destroy() end
            if backdrop then backdrop:Destroy() end
        end)
        show() -- always runs, even if the loader failed to build
    end)
    if not ok then warn("[Ducky] loading screen failed to build, continuing without it") end
end

return Window
end

return Ducky
