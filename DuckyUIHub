-- Window:CreateTab("Name", "icon")  or  Window:CreateTab({ Name = "Name", Icon = "icon" })
function Window:CreateTab(a, b)
    local o = type(a) == "table" and a or { Name = a, Icon = b }

    local button = create("TextButton", {
        Parent = tabList, Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, LayoutOrder = #Window.Tabs + 1,
    })
    local fill = create("Frame", {
        Parent = button, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, {
        create("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    local indicator = create("Frame", { -- accent bar on the left edge of the active tab
        Parent = button, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    }, { corner(2) })
    local ico = icon({
        Parent = button, Position = UDim2.new(0.5, -11, 0, 15), Size = UDim2.fromOffset(22, 22),
    }, o.Icon or "circle", Theme.TabIdle)
    local label = text({
        Parent = button, Position = UDim2.fromOffset(0, 43), Size = UDim2.new(1, 0, 0, 14),
        Text = string.upper(o.Name or "Tab"), TextXAlignment = Enum.TextXAlignment.Center,
        FontFace = FONT_BOLD, TextSize = 10, TextColor3 = Theme.TabIdle, TextTruncate = Enum.TextTruncate.AtEnd,
    })

    -- page
    local group = create("CanvasGroup", {
        Parent = pages, BackgroundTransparency = 1, Visible = false, Size = UDim2.fromScale(1, 1),
    })
    local scroll = create("ScrollingFrame", {
        Parent = group, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, {
        create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Wraps = true,
            Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        padding(0, 0, 8, 0),
    })
    local empty = text({ -- shown when a search matches nothing on this page
        Parent = scroll, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 1e6, Visible = false,
        TextXAlignment = Enum.TextXAlignment.Center, Text = "No results", TextColor3 = Theme.Desc,
        FontFace = FONT_SEMI, TextSize = 12,
    })

    local Tab = {
        Name = o.Name or "Tab", Fill = fill, Icon = ico, Label = label, Indicator = indicator, Button = button,
        Page = { Frame = group, Scroll = scroll, Items = {}, Empty = empty },
    }
    function Tab:Select() select(Tab) end
    table.insert(Window.Tabs, Tab)
    installItems(Tab, Tab.Page)

    button.MouseEnter:Connect(function()
        if currentTab ~= Tab then
            tween(label, { TextColor3 = Theme.TabHover })
            tween(ico, { ImageColor3 = Theme.TabHover, Position = UDim2.new(0.5, -11, 0, 12) }, 0.2, Enum.EasingStyle.Back)
        end
    end)
    button.MouseLeave:Connect(function()
        if currentTab ~= Tab then
            tween(label, { TextColor3 = Theme.TabIdle })
            tween(ico, { ImageColor3 = Theme.TabIdle, Position = UDim2.new(0.5, -11, 0, 15) }, 0.2)
        end
    end)
    button.MouseButton1Click:Connect(function() select(Tab) end)

    if not currentTab then select(Tab) end
    return Tab
end
Window.AddTab = Window.CreateTab

-- Window:SelectTab("Combat") or Window:SelectTab(tabObject)
function Window:SelectTab(t)
    for _, tab in ipairs(Window.Tabs) do
        if tab == t or tab.Name == t then select(tab); return true end
    end
    return false
end

-- ready-made settings page: theme presets, custom accent, UI keybind, config + unload
function Window:CreateSettingsTab(so)
    so = so or {}
    local Tab = Window:CreateTab(so.Name or "Settings", so.Icon or "settings")
    Tab:CreateSection("Appearance")
    local names = {}
    for n in pairs(PRESETS) do table.insert(names, n) end
    table.sort(names)
    local accentToken = 0
    local function setAccentSoon(c) -- debounced so dragging the picker stays smooth
        accentToken += 1
        local t = accentToken
        task.delay(0.06, function() if t == accentToken then Window:SetAccent(c) end end)
    end
    Tab:CreateDropdown({
        Name = "Theme", Description = "Recolour the whole interface", Options = names, Columns = 2,
        CurrentOption = Window.Preset, Flag = "DuckySettings_Theme",
        Callback = function(sel) if sel[1] and PRESETS[sel[1]] then Window.Preset = sel[1]; Window:SetAccent(PRESETS[sel[1]]) end end,
    })
    Tab:CreateColorPicker({
        Name = "Custom accent", Description = "Pick any colour you like", Columns = 2, Color = Theme.Accent,
        Callback = setAccentSoon,
    })
    Tab:CreateKeybind({
        Name = "Toggle UI", Description = "Key that shows / hides this window", CurrentKeybind = keybind.Name,
        Flag = "DuckySettings_Keybind", ChangedCallback = function(k) Window:SetKeybind(k) end,
    })
    Tab:CreateSection("Configuration")
    Tab:CreateButton({
        Name = "Save configuration", Description = cfg.enabled and ("Saved to " .. cfgPath()) or "Saving is disabled for this script",
        ButtonText = "Save now", Icon = "save", Columns = 2,
        Callback = function()
            saveConfig(true)
            Ducky:Notify({ Title = "Saved", Content = "Your settings were saved.", Type = "success", Duration = 3 })
        end,
    })
    Tab:CreateButton({
        Name = "Load configuration", Description = "Re-apply the last saved settings", ButtonText = "Load", Icon = "folder-open", Columns = 2,
        Callback = function()
            local ok = Window:LoadConfiguration()
            Ducky:Notify({
                Title = ok and "Loaded" or "Nothing to load", Type = ok and "success" or "warning", Duration = 3,
                Content = ok and "Settings restored." or "No saved configuration was found.",
            })
        end,
    })
    Tab:CreateSection("Danger zone")
    Tab:CreateButton({
        Name = "Unload", Description = "Close the UI and disconnect everything", ButtonText = "Unload", Icon = "power",
        Callback = function()
            Window:Dialog({
                Title = "Unload " .. name .. "?", Content = "The window will close and all features will stop.",
                Buttons = { { Name = "Cancel" }, { Name = "Unload", Primary = true, Callback = function() Window:Destroy() end } },
            })
        end,
    })
    return Tab
end

