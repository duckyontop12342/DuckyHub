--[[
    Ducky UI Library
    Icon sidebar, description cards, grid columns, animations. Orange theme.
    Icons: Lucide (via latte-soft/lucide-roblox, uploaded sprite sheets - no file functions needed)

    local Ducky  = loadstring(game:HttpGet("https://raw.githubusercontent.com/<you>/Ducky/main/Library.lua"))()
    local Window = Ducky:CreateWindow({ Title = "Ducky", Keybind = Enum.KeyCode.RightShift })
    local Tab    = Window:AddTab({ Name = "Assist", Icon = "skull" })

    Every item takes { Name, Description, Columns = 1|2|3|4, Flag, Callback }

    Tab:AddToggle({ Style = "Switch" | "Checkbox", Default })
    Tab:AddSlider({ Min, Max, Default, Increment, Suffix })
    Tab:AddDropdown({ Options = {...}, Default = "x", Multi = false })   -- Multi: Default = { "a", "b" }
    Tab:AddColorPicker({ Default = Color3 })
    Tab:AddButton({ ButtonText = "Run" })
    Tab:AddLabel({ Name })

    Window:AddAction({ Icon = "settings", Callback = fn })   -- small icons top right
    Window:Toggle()  Window:Destroy()  Window.Flags[flag]

    Full docs: see README.md
]]

