local TweenService     = game:GetService("TweenService")
local CoreGui          = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local Theme = {
    Window    = Color3.fromRGB(14, 14, 17),
    Sidebar   = Color3.fromRGB(18, 18, 22),
    Border    = Color3.fromRGB(32, 32, 38),
    Card      = Color3.fromRGB(21, 21, 26),
    CardHover = Color3.fromRGB(26, 26, 32),
    Field     = Color3.fromRGB(14, 14, 17),
    Control   = Color3.fromRGB(58, 58, 68),
    Accent    = Color3.fromRGB(255, 166, 0),
    AccentDim = Color3.fromRGB(176, 104, 0),
    Text      = Color3.fromRGB(255, 255, 255),
    Desc      = Color3.fromRGB(112, 114, 130),
