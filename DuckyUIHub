local function refreshTabs()
    for _, tab in ipairs(Window.Tabs) do
        local active = tab == currentTab
        local color = active and Theme.Accent or Theme.TabIdle
        tween(tab.Fill, { BackgroundTransparency = active and 0 or 1 }, 0.2)
        tween(tab.Label, { TextColor3 = color })
        tween(tab.Icon, { ImageColor3 = color, Position = UDim2.new(0.5, -11, 0, 15) })
        tween(tab.Indicator, { Size = UDim2.fromOffset(3, active and 34 or 0) }, 0.35, Enum.EasingStyle.Quint)
    end
end

-- search: hides every element on the page whose name doesn't contain the query
local function applyFilter(page, query)
    query = string.lower(query or "")
    local any = false
    for _, item in ipairs(page.Items) do
        local show
        if query == "" then
            show = true
        elseif item.kind == "card" then
            show = string.find(item.text, query, 1, true) ~= nil
        else
            show = false -- sections, labels and dividers hide while searching
        end
        item.frame.Visible = show
        if show then any = true end
    end
    page.Empty.Visible = query ~= "" and not any
    page.Scroll.CanvasPosition = Vector2.new()
end

local function select(tab)
    if Window._closePicker then Window._closePicker() end
    local previous = currentPage
    local page = tab.Page
    if previous and previous ~= page then applyFilter(previous, "") end
    if searchBox and searchBox.Text ~= "" then searchBox.Text = "" end
    applyFilter(page, "")
    currentTab, currentPage = tab, page
    for _, t in ipairs(Window.Tabs) do
        if t.Page ~= page then t.Page.Frame.Visible = false end
    end
    if page ~= previous then
        page.Frame.Position = UDim2.fromOffset(0, 14)
        page.Frame.GroupTransparency = 1
        page.Frame.Visible = true
        tween(page.Frame, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quint)
        setHeaderTitle(tab.Name)
        headerTitle.Position = UDim2.fromOffset(0, 6)
        headerTitle.TextTransparency = 1
        tween(headerTitle, { Position = UDim2.fromOffset(0, 0), TextTransparency = 0 }, 0.3, Enum.EasingStyle.Quint)
    end
    bindBar(page.Scroll)
    refreshTabs()
end

if searchBox then
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if currentPage then applyFilter(currentPage, searchBox.Text) end
    end)
end

