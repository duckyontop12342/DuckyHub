local function installItems(Tab, page)
    local scroll = page.Scroll
    local order = 0
    scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        if Window._closePicker then Window._closePicker() end
    end)

    local function register(o, ctrl)
        if o.Flag then Ducky.Flags[o.Flag] = ctrl end
    end

    -- card with title (+ optional description). `reserve` = px kept free on the right of the head for a control
    local function card(o, reserve)
        reserve = reserve or 0
        order += 1
        local cols = o.Columns or 1
        local c = create("Frame", {
            Parent = scroll, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
            Size = columnWidth(cols), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order,
        }, {
            corner(6), padding(10, 12, 10, 12),
            create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)) }),
            create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
        })
        local edge = stroke(Theme.Border, 1)
        edge.Transparency = 0.4
        edge.Parent = c
        c.MouseEnter:Connect(function()
            tween(c, { BackgroundColor3 = Theme.CardHover }); tween(edge, { Transparency = 0 })
        end)
        c.MouseLeave:Connect(function()
            tween(c, { BackgroundColor3 = Theme.Card }); tween(edge, { Transparency = 0.4 })
        end)
        table.insert(page.Items, {
            frame = c, kind = "card", text = string.lower(tostring(o.Name or "") .. " " .. tostring(o.Description or "")),
        })
        if o.Tooltip then Window._tooltip(c, o.Tooltip) end

        local head = create("Frame", {
            Parent = c, BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, o.Description and 29 or 16), LayoutOrder = 0,
        })
        local title = text({
            Parent = head, Size = UDim2.new(1, -reserve, 0, 15), Text = o.Name or "Item",
            FontFace = FONT_BOLD, TextSize = cols >= 3 and 12 or 13, TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local desc
        if o.Description then
            desc = text({
                Parent = head, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -reserve, 0, 13),
                Text = o.Description, TextColor3 = Theme.Desc, TextSize = 11, FontFace = FONT_SEMI, TextTruncate = Enum.TextTruncate.AtEnd,
            })
        end
        return c, head, title, desc
    end

    local function overlay(parentObj)
        return create("TextButton", {
            Parent = parentObj, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 3,
        })
    end

    -- section header ---------------------------------------------------------
    function Tab:CreateSection(a)
        order += 1
        local label = type(a) == "table" and (a.Name or "") or tostring(a or "")
        local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order })
        table.insert(page.Items, { frame = f, kind = "other" })
        local l = text({
            Parent = f, Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
            Text = string.upper(label), FontFace = FONT_BOLD, TextSize = 11, TextColor3 = Theme.RowText,
        })
        -- line that starts after the text and fades out to the right
        local line = create("Frame", {
            Parent = f, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 60, 0, 12),
            Size = UDim2.new(1, -60, 0, 1), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
        }, {
            create("UIGradient", {
                Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
            }),
        })
        local function place()
            local w = l.TextBounds.X + 12
            line.Position = UDim2.new(0, w, 0, 12)
            line.Size = UDim2.new(1, -w, 0, 1)
        end
        l:GetPropertyChangedSignal("TextBounds"):Connect(place)
        place()
        return { Set = function(_, t) l.Text = string.upper(tostring(t)) end }
    end

    function Tab:CreateDivider()
        order += 1
        local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = order })
        table.insert(page.Items, { frame = f, kind = "other" })
        create("Frame", {
            Parent = f, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
        })
    end

    -- label: Tab:CreateLabel("text", "icon", Color3) or Tab:CreateLabel({ Name, Icon, Color })
    function Tab:CreateLabel(a, iconName, color)
        order += 1
        local t = type(a) == "table" and (a.Name or a.Text or "") or tostring(a or "")
        if type(a) == "table" then iconName = iconName or a.Icon; color = color or a.Color end
        local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order })
        table.insert(page.Items, { frame = f, kind = "other" })
        local x = 0
        if iconName then
            icon({ Parent = f, Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(14, 14) }, iconName, color or Theme.Desc)
            x = 20
        end
