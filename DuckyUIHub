-- notifications -------------------------------------------------------------

local notifGui, notifHolder, notifOrder = nil, nil, 0

local function ensureNotifHolder()
    if notifGui and notifGui.Parent then return notifHolder end
    notifGui = create("ScreenGui", {
        Name = "DuckyNotifications", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, Parent = protectedParent(),
    })
    local width = 340
    pcall(function() width = math.min(340, workspace.CurrentCamera.ViewportSize.X - 24) end)
    notifHolder = create("Frame", {
        Parent = notifGui, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -12, 1, -12), Size = UDim2.new(0, width, 1, -24),
    }, {
        create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }),
    })
    return notifHolder
end

-- Ducky:Notify({ Title, Content, Type = "info"|"success"|"error"|"warning", Duration = 5,
--                Image = "bird" (overrides the type icon), Button = "Got it", Callback = function() end })
local NOTIF = {
    info    = { bg = Color3.fromRGB(26, 26, 28), edge = Color3.fromRGB(46, 46, 50) },
    success = { bg = Color3.fromRGB(33, 44, 29), edge = Color3.fromRGB(56, 74, 48), color = Color3.fromRGB(150, 255, 70), mark = "check", dark = true },
    error   = { bg = Color3.fromRGB(44, 25, 27), edge = Color3.fromRGB(74, 40, 42), color = Color3.fromRGB(255, 62, 55), mark = "x" },
    warning = { bg = Color3.fromRGB(46, 39, 21), edge = Color3.fromRGB(78, 66, 32), color = Color3.fromRGB(255, 214, 10), mark = "triangle-alert", dark = true },
}

function Ducky:Notify(o)
    o = o or {}
    local holder = ensureNotifHolder()
    notifOrder += 1
    local duration = o.Duration or 5
    local kind = NOTIF[o.Type or "info"] or NOTIF.info
    local hasButton = o.Button ~= nil

    local wrapper = create("Frame", {
        Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = notifOrder,
    })
    local card = create("Frame", {
        Parent = wrapper, Position = UDim2.new(0, 360, 0, 0), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = kind.bg, BorderSizePixel = 0,
    }, {
        corner(18), stroke(kind.edge, 1),
        create("UIGradient", { -- faint diagonal sheen like the reference
            Rotation = 25,
            Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 225, 225)),
        }),
    })

    -- icon
    local iconHolder = create("Frame", {
        Parent = card, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 18, 0.5, 0),
        Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1,
    })
    if o.Image ~= nil then
        icon({ Parent = iconHolder, Size = UDim2.fromScale(1, 1) }, o.Image, Theme.Text)
    elseif kind.mark then
        local disc = create("Frame", {
            Parent = iconHolder, Size = UDim2.fromScale(1, 1), BackgroundColor3 = kind.color, BorderSizePixel = 0,
        }, { corner(13) })
        icon({
            Parent = disc, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(14, 14),
        }, kind.mark, kind.dark and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1))
    else
        icon({ Parent = iconHolder, Size = UDim2.fromScale(1, 1) }, "at-sign", Theme.Text)
    end

    local body = create("Frame", {
        Parent = card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    }, {
        padding(15, hasButton and 108 or 18, 15, 58),
        create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    text({
        Parent = body, Size = UDim2.new(1, 0, 0, 18), Text = o.Title or "Notification",
        FontFace = FONT_BOLD, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 0,
    })
    if o.Content and o.Content ~= "" then
        text({
            Parent = body, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Text = o.Content, TextColor3 = Color3.fromRGB(150, 150, 150), FontFace = FONT_SEMI, TextSize = 12,
            TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1,
        })
    end

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(card, { Position = UDim2.new(0, 360, 0, 0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.32, function() wrapper:Destroy() end)
    end

    if hasButton then
        local btn = create("TextButton", {
            Parent = card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
            Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, BorderSizePixel = 0,
            Text = "", AutoButtonColor = false,
        }, { corner(10), padding(0, 14, 0, 14) })
        text({
            Parent = btn, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            Text = tostring(o.Button), FontFace = FONT_SEMI, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center,
        })
        btn.MouseEnter:Connect(function() tween(btn, { BackgroundTransparency = 0.82 }) end)
        btn.MouseLeave:Connect(function() tween(btn, { BackgroundTransparency = 0.9 }) end)
        btn.MouseButton1Click:Connect(function()
            if o.Callback then task.spawn(o.Callback) end
            close()
        end)
    else
        local hit = create("TextButton", { Parent = card, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 5 })
        hit.MouseButton1Click:Connect(close)
    end

    tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.45, Enum.EasingStyle.Quint)
    task.delay(duration, close)

    return { Close = close }
end

function Ducky:Destroy()
    if Ducky._window then Ducky._window:Destroy() end
end

function Ducky:SetAccent(c)
    if Ducky._window then Ducky._window:SetAccent(c) end
end

function Ducky:LoadConfiguration()
    if Ducky._window then return Ducky._window:LoadConfiguration() end
    return false
end

-- window -------------------------------------------------------------------

function Ducky:CreateWindow(opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}

    for k, v in pairs(opts.Theme or {}) do Theme[k] = v end
    loadLucide()

    local name      = opts.Name or "Ducky"
    local logoText  = opts.Logo or opts.Title or "Ducky"
    local keybind   = parseKey(opts.Keybind or opts.ToggleUIKeybind, Enum.KeyCode.RightShift)
    local winSize   = opts.Size or Vector2.new(620, 360)
    local WIN_W, WIN_H = winSize.X, winSize.Y

    local cs  = opts.ConfigurationSaving
    local cfg = {
        enabled = cs and cs.Enabled == true,
        folder  = cs and cs.FolderName,
        file    = ((cs and cs.FileName) or "Config") .. ".json",
    }
    local function cfgPath()
        return cfg.folder and (cfg.folder .. "/" .. cfg.file) or cfg.file
    end

    local parent = protectedParent()
    local old = parent:FindFirstChild("DuckyUI")
    if old then old:Destroy() end
    table.clear(Ducky.Flags)

    local Window = { Tabs = {}, Connections = {}, DestroyCallbacks = {}, Flags = Ducky.Flags, Open = true, Loaded = false, Actions = 0 }
    Ducky._window = Window

    local function connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(Window.Connections, c)
        return c
    end

    local gui = create("ScreenGui", {
        Name = "DuckyUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parent,
    })
    Window.Gui = gui

    local main = create("CanvasGroup", {
        Name = "Main", Parent = gui, BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
        Size = UDim2.fromOffset(WIN_W, WIN_H), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 1, Visible = false, Active = true,
    }, { corner(8), stroke(Theme.Border, 1) })
    local scale = create("UIScale", { Parent = main, Scale = 0.9 })

    -- phones / small screens: shrink the whole window to fit the viewport (and follow rotation)
    local function computeFit()
        local cam = workspace.CurrentCamera
        if not cam then return 1 end
        local vp = cam.ViewportSize
        return math.clamp(math.min((vp.X - 16) / WIN_W, (vp.Y - 16) / WIN_H, 1), 0.5, 1)
    end
    local baseScale = computeFit()
    scale.Scale = baseScale * 0.9
    Window.Main = main

    -- configuration saving ---------------------------------------------------
    local saveToken, loadingConfig = 0, false

    local function saveConfig()
        if not cfg.enabled or loadingConfig then return end
        saveToken += 1
        local token = saveToken
        task.delay(0.4, function()
            if token ~= saveToken then return end
            local data = {}
            for flag, el in pairs(Ducky.Flags) do
                if el._ToConfig then data[flag] = el:_ToConfig() end
            end
            pcall(function()
                if cfg.folder and makefolder and isfolder and not isfolder(cfg.folder) then makefolder(cfg.folder) end
                writefile(cfgPath(), HttpService:JSONEncode(data))
            end)
        end)
    end

    function Window:LoadConfiguration()
        if not cfg.enabled then return false end
        local ok, data = pcall(function()
            if not (isfile and isfile(cfgPath())) then return nil end
            return HttpService:JSONDecode(readfile(cfgPath()))
        end)
        if not ok or type(data) ~= "table" then return false end
        loadingConfig = true
        for flag, value in pairs(data) do
            local el = Ducky.Flags[flag]
            if el and el._FromConfig then pcall(el._FromConfig, el, value) end
        end
        loadingConfig = false
        return true
    end

    -- sidebar -------------------------------------------------------------
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Size = UDim2.new(0, SIDEBAR_W, 1, 0) })
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Position = UDim2.fromOffset(SIDEBAR_W, 0), Size = UDim2.new(0, 1, 1, 0) })

    local logoArea = create("Frame", {
        Parent = main, BackgroundTransparency = 1, Size = UDim2.fromOffset(SIDEBAR_W, 76), Active = true,
    })
    local logo = text({
        Parent = logoArea, Position = UDim2.fromOffset(6, 18), Size = UDim2.new(1, -12, 0, 30),
        TextXAlignment = Enum.TextXAlignment.Center, Text = logoText, TextScaled = true,
        FontFace = FONT_ITAL,
    }, nil)
    create("UITextSizeConstraint", { Parent = logo, MaxTextSize = 24, MinTextSize = 10 })
    create("UIGradient", { Parent = logo, Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) })

    -- underline that fades out to the right
    local underline = create("Frame", {
        Parent = logoArea, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50),
        Size = UDim2.fromOffset(LOGO_W, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, {
        create("UIGradient", {
            Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.5, 0.35),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    local tabList = create("ScrollingFrame", {
        Parent = main, BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 80), Size = UDim2.new(0, SIDEBAR_W, 1, -80),
        ScrollBarThickness = 0, ScrollBarImageTransparency = 1,
        ScrollingDirection = Enum.ScrollingDirection.Y, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ClipsDescendants = true,
    }, {
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) }),
        padding(0, 0, 8, 0),
    })

    local pages = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(SIDEBAR_W + 12, 16),
        Size = UDim2.new(1, -(SIDEBAR_W + 12 + 28), 1, -32),
    })

    -- drag --------------------------------------------------------------------
    do
        local dragArea = create("Frame", { Parent = main, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UserInputService.TouchEnabled and 26 or 14), ZIndex = 0, Active = true })
        local dragging, startPos, startInput
        local function begin(frame)
            connect(frame.InputBegan, function(input)
                if isPress(input) then dragging, startPos, startInput = true, main.Position, input.Position end
            end)
        end
        begin(dragArea)
        begin(logoArea)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) then
                local d = input.Position - startInput
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    -- custom scrollbar --------------------------------------------------------
    local track = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.new(1, -16, 0, 16), Size = UDim2.new(0, 5, 1, -32),
    })
    local thumb = create("Frame", {
        Parent = track, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40), Visible = false, BackgroundTransparency = 0.3,
    }, {
        corner(3),
        create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) }),
    })
    local thumbHit = create("TextButton", { Parent = thumb, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "" })

    local currentTab, currentPage
    local barConns = {}

    local function updateBar()
        local s = currentPage and currentPage.Scroll
        if not s then thumb.Visible = false; return end
        local view, canvas = s.AbsoluteWindowSize.Y, s.AbsoluteCanvasSize.Y
        if canvas <= view + 1 then thumb.Visible = false; return end
        thumb.Visible = true
        local trackH = track.AbsoluteSize.Y
        local h = math.max(30, trackH * view / canvas)
        local a = math.clamp(s.CanvasPosition.Y / (canvas - view), 0, 1)
        thumb.Size = UDim2.new(1, 0, 0, h)
        thumb.Position = UDim2.new(0, 0, 0, (trackH - h) * a)
    end

    local function bindBar(scroll)
        for _, c in ipairs(barConns) do c:Disconnect() end
        table.clear(barConns)
        for _, prop in ipairs({ "CanvasPosition", "AbsoluteCanvasSize", "AbsoluteWindowSize" }) do
            table.insert(barConns, scroll:GetPropertyChangedSignal(prop):Connect(updateBar))
        end
        updateBar()
    end

    do
        local dragging, startY, startCanvas
        thumbHit.InputBegan:Connect(function(input)
            if isPress(input) and currentPage then
                dragging, startY, startCanvas = true, input.Position.Y, currentPage.Scroll.CanvasPosition.Y
            end
        end)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) and currentPage then
                local s = currentPage.Scroll
                local trackRange = track.AbsoluteSize.Y - thumb.AbsoluteSize.Y
                local maxScroll = s.AbsoluteCanvasSize.Y - s.AbsoluteWindowSize.Y
                if trackRange > 0 then
                    s.CanvasPosition = Vector2.new(0, startCanvas + (input.Position.Y - startY) / trackRange * maxScroll)
                end
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    -- top-right actions -------------------------------------------------------
    function Window:AddAction(o)
        local y = 18 + Window.Actions * 24
        Window.Actions += 1
        local b = create("TextButton", {
            Parent = main, BackgroundTransparency = 1, Text = "",
            Position = UDim2.new(1, -22, 0, y), Size = UDim2.fromOffset(16, 16),
        })
        local ico = icon({ Parent = b, Size = UDim2.fromScale(1, 1) }, o.Icon or "settings", Theme.TabIdle)
        b.MouseEnter:Connect(function() tween(ico, { ImageColor3 = Theme.Accent }) end)
        b.MouseLeave:Connect(function() tween(ico, { ImageColor3 = Theme.TabIdle }) end)
        b.MouseButton1Down:Connect(function() tween(ico, { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1) }, 0.08) end)
        b.MouseButton1Up:Connect(function() tween(ico, { Size = UDim2.fromScale(1, 1), Position = UDim2.new() }, 0.15, Enum.EasingStyle.Back) end)
        b.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
    end

    function Window:Notify(o) return Ducky:Notify(o) end

    -- recolours the whole UI: everything currently using the old accent switches to the new one
    function Window:SetAccent(c)
        local old, oldDim, oldOn = Theme.Accent, Theme.AccentDim, Theme.OnAccent
        local hh, ss, vv = Color3.toHSV(c)
        local dim = Color3.fromHSV(hh, ss, vv * 0.8)
        local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
        local on = lum > 0.55 and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(255, 255, 255)
        Theme.Accent, Theme.AccentDim, Theme.OnAccent = c, dim, on
        local function map(col)
            if col == old then return c elseif col == oldDim then return dim elseif col == oldOn then return on end
            return col
        end
        for _, d in ipairs(gui:GetDescendants()) do
            pcall(function()
                if d:IsA("UIGradient") then
                    local kps = {}
                    for _, kp in ipairs(d.Color.Keypoints) do
                        table.insert(kps, ColorSequenceKeypoint.new(kp.Time, map(kp.Value)))
                    end
                    d.Color = ColorSequence.new(kps)
                elseif d:IsA("UIStroke") then
                    d.Color = map(d.Color)
                elseif d:IsA("ScrollingFrame") then
                    d.ScrollBarImageColor3 = map(d.ScrollBarImageColor3)
                elseif d:IsA("ImageLabel") then
                    d.ImageColor3 = map(d.ImageColor3)
                elseif d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    d.TextColor3 = map(d.TextColor3)
                end
                if d:IsA("GuiObject") then d.BackgroundColor3 = map(d.BackgroundColor3) end
            end)
        end
    end

    -- selection ---------------------------------------------------------------
    local function refreshTabs()
        for _, tab in ipairs(Window.Tabs) do
            local active = tab == currentTab
            local color = active and Theme.Accent or Theme.TabIdle
            tween(tab.Fill, { BackgroundTransparency = active and 0 or 1 }, 0.2)
            tween(tab.Label, { TextColor3 = color })
            tween(tab.Icon, { ImageColor3 = color, Position = UDim2.new(0.5, -11, 0, 15) })
        end
    end

    local function select(tab)
        if Window._closePicker then Window._closePicker() end
        local previous = currentPage
        local page = tab.Page
        currentTab, currentPage = tab, page
        for _, t in ipairs(Window.Tabs) do
            if t.Page ~= page then t.Page.Frame.Visible = false end
        end
        if page ~= previous then
            page.Frame.Position = UDim2.fromOffset(0, 14)
            page.Frame.GroupTransparency = 1
            page.Frame.Visible = true
            tween(page.Frame, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quint)
        end
        bindBar(page.Scroll)
        refreshTabs()
    end

    -- items -------------------------------------------------------------------------
    local function installItems(Tab, page)
        local scroll = page.Scroll
        local order = 0
        scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            if Window._closePicker then Window._closePicker() end
        end)

        local function register(o, ctrl)
            if o.Flag then Ducky.Flags[o.Flag] = ctrl end
        end

        -- card with title (+ optional description). `reserve` = px kept free on the right of the head for a control
        local function card(o, reserve)
            reserve = reserve or 0
            order += 1
            local cols = o.Columns or 1
            local c = create("Frame", {
                Parent = scroll, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
                Size = columnWidth(cols), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order,
            }, {
                corner(6), padding(10, 12, 10, 12),
                create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
            })
            c.MouseEnter:Connect(function() tween(c, { BackgroundColor3 = Theme.CardHover }) end)
            c.MouseLeave:Connect(function() tween(c, { BackgroundColor3 = Theme.Card }) end)

            local head = create("Frame", {
                Parent = c, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, o.Description and 29 or 16), LayoutOrder = 0,
            })
            local title = text({
                Parent = head, Size = UDim2.new(1, -reserve, 0, 15), Text = o.Name or "Item",
                FontFace = FONT_BOLD, TextSize = cols >= 3 and 12 or 13, TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local desc
            if o.Description then
                desc = text({
                    Parent = head, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -reserve, 0, 13),
                    Text = o.Description, TextColor3 = Theme.Desc, TextSize = 11, FontFace = FONT_SEMI, TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
            return c, head, title, desc
        end

        local function overlay(parentObj)
            return create("TextButton", {
                Parent = parentObj, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 3,
            })
        end

        -- section header ---------------------------------------------------------
        function Tab:CreateSection(a)
            order += 1
            local label = type(a) == "table" and (a.Name or "") or tostring(a or "")
            local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order })
            local l = text({
                Parent = f, Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
                Text = string.upper(label), FontFace = FONT_BOLD, TextSize = 11, TextColor3 = Theme.RowText,
            })
            -- line that starts after the text and fades out to the right
            local line = create("Frame", {
                Parent = f, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 60, 0, 12),
                Size = UDim2.new(1, -60, 0, 1), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
            }, {
                create("UIGradient", {
                    Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
                }),
            })
            local function place()
                local w = l.TextBounds.X + 12
                line.Position = UDim2.new(0, w, 0, 12)
                line.Size = UDim2.new(1, -w, 0, 1)
            end
            l:GetPropertyChangedSignal("TextBounds"):Connect(place)
            place()
            return { Set = function(_, t) l.Text = string.upper(tostring(t)) end }
        end

        function Tab:CreateDivider()
            order += 1
            local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = order })
            create("Frame", {
                Parent = f, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
            })
        end

        -- label: Tab:CreateLabel("text", "icon", Color3) or Tab:CreateLabel({ Name, Icon, Color })
        function Tab:CreateLabel(a, iconName, color)
            order += 1
            local t = type(a) == "table" and (a.Name or a.Text or "") or tostring(a or "")
            if type(a) == "table" then iconName = iconName or a.Icon; color = color or a.Color end
            local f = create("Frame", { Parent = scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order })
            local x = 0
            if iconName then
                icon({ Parent = f, Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(14, 14) }, iconName, color or Theme.Desc)
                x = 20
            end
            local l = text({
                Parent = f, Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x, 1, 0),
                Text = t, TextColor3 = color or Theme.Desc, FontFace = FONT_SEMI,
            })
            return { Set = function(_, v) l.Text = tostring(v) end }
        end

        function Tab:CreateParagraph(o)
            local c, _, title = card({ Name = o.Title or o.Name or "", Columns = o.Columns })
            local body = text({
                Parent = c, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                Text = o.Content or o.Text or "", TextColor3 = Theme.Desc, TextSize = 12, TextWrapped = true,
                TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1,
            })
            return {
                Set = function(_, v)
                    if type(v) == "table" then
                        if v.Title then title.Text = v.Title end
                        if v.Content then body.Text = v.Content end
                    end
                end,
            }
        end

        -- toggle ---------------------------------------------------------------
        function Tab:CreateToggle(o)
            local _, head = card(o, 44)
            local checkbox = o.Style == "Checkbox"
            local Toggle = { Type = "Toggle", CurrentValue = false, Flag = o.Flag }
            local apply

            if checkbox then
                local box = create("Frame", {
                    Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
                }, { corner(4) })
                local check = icon({
                    Parent = box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(4, 4), ImageTransparency = 1,
                }, "check", Theme.OnAccent)
                apply = function(v)
                    tween(box, { BackgroundColor3 = v and Theme.Accent or Theme.Control })
                    tween(check, { ImageTransparency = v and 0 or 1, Size = v and UDim2.fromOffset(13, 13) or UDim2.fromOffset(4, 4) }, 0.22, Enum.EasingStyle.Back)
                end
            else
                local W, K = 40, 16
                local state = false
                local sw = create("Frame", {
                    Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(W, 22), BackgroundColor3 = Theme.Track, BorderSizePixel = 0,
                }, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
                local knob = create("Frame", {
                    Parent = sw, Position = UDim2.new(0, 3, 0.5, -K / 2), Size = UDim2.fromOffset(K, K),
                    BackgroundColor3 = Color3.fromRGB(150, 150, 150), BorderSizePixel = 0,
                }, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
                local function geo(stretch)
                    local w = stretch and 22 or K
                    local x = state and (W - 3 - w) or 3
                    return UDim2.fromOffset(w, K), UDim2.new(0, x, 0.5, -K / 2)
                end
                apply = function(v)
                    state = v
                    local size, pos = geo(false)
                    tween(sw, { BackgroundColor3 = v and Theme.Accent or Theme.Track }, 0.22)
                    tween(knob, {
                        Size = size, Position = pos,
                        BackgroundColor3 = v and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150),
                    }, 0.32, Enum.EasingStyle.Quint)
                end
                Toggle._press = function(down)
                    local size, pos = geo(down)
                    tween(knob, { Size = size, Position = pos }, 0.12)
                end
            end

            function Toggle:Set(v, silent, nosave)
                self.CurrentValue = v and true or false
                apply(self.CurrentValue)
                if not silent and o.Callback then task.spawn(o.Callback, self.CurrentValue) end
                if not nosave then saveConfig() end
            end
            function Toggle:Get() return self.CurrentValue end
            function Toggle:_ToConfig() return self.CurrentValue end
            function Toggle:_FromConfig(v) self:Set(v == true) end

            local hit = overlay(head)
            hit.MouseButton1Click:Connect(function() Toggle:Set(not Toggle.CurrentValue) end)
            hit.MouseButton1Down:Connect(function() if Toggle._press then Toggle._press(true) end end)
            hit.MouseButton1Up:Connect(function() if Toggle._press then Toggle._press(false) end end)
            hit.MouseLeave:Connect(function() if Toggle._press then Toggle._press(false) end end)
            register(o, Toggle)
            Toggle:Set(pick(o, "CurrentValue", "Default") or false, true, true)
            return Toggle
        end

        -- button: title on top, full-width button underneath (like the reference)
        function Tab:CreateButton(o)
            local c, _, title = card(o, 0)
            local btn = create("TextButton", {
                Parent = c, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Theme.Button, BorderSizePixel = 0,
                Text = o.ButtonText or "Run", FontFace = FONT_BOLD, TextSize = 12, TextColor3 = Theme.Text,
                AutoButtonColor = false, LayoutOrder = 1,
            }, { corner(5) })
            local hovering = false
            btn.MouseEnter:Connect(function() hovering = true; tween(btn, { BackgroundColor3 = Theme.ButtonHover }) end)
            btn.MouseLeave:Connect(function() hovering = false; tween(btn, { BackgroundColor3 = Theme.Button }) end)
            -- press: flashes to the accent colour, then fades back
            btn.MouseButton1Down:Connect(function()
                tween(btn, { BackgroundColor3 = Theme.Accent }, 0.08)
                tween(btn, { TextColor3 = Theme.OnAccent }, 0.08)
            end)
            local function release()
                tween(btn, { BackgroundColor3 = hovering and Theme.ButtonHover or Theme.Button }, 0.45, Enum.EasingStyle.Quad)
                tween(btn, { TextColor3 = Theme.Text }, 0.45, Enum.EasingStyle.Quad)
            end
            btn.MouseButton1Up:Connect(release)
            btn.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
            return {
                Set = function(_, n) title.Text = tostring(n) end,
                SetText = function(_, n) btn.Text = tostring(n) end,
            }
        end

        -- slider ----------------------------------------------------------------
        function Tab:CreateSlider(o)
            local range = o.Range or { o.Min or 0, o.Max or 100 }
            local min, max = range[1], range[2]
            local inc = o.Increment or 1
            local suffix = o.Suffix or ""
            local c, head = card(o, 50)

            local val = text({
                Parent = head, Position = UDim2.new(1, -50, 0, 0), Size = UDim2.new(0, 50, 0, 15),
                TextXAlignment = Enum.TextXAlignment.Right, FontFace = FONT_BOLD, TextSize = 12,
            })

            local bar = create("Frame", { Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1 })
            local trk = create("Frame", {
                Parent = bar, Position = UDim2.new(0, 0, 0.5, -4), Size = UDim2.new(1, 0, 0, 8),
                BackgroundColor3 = Theme.Track, BorderSizePixel = 0,
            }, { corner(4) })
            local fill = create("Frame", { Parent = trk, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, {
                corner(4),
                create("UIGradient", { Color = ColorSequence.new(Theme.AccentDim, Theme.Accent) }),
            })
            local knob = create("Frame", {
                Parent = trk, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                Size = UDim2.fromOffset(10, 14), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2,
            }, { corner(4) })

            local Slider = { Type = "Slider", CurrentValue = min, Flag = o.Flag }
            function Slider:Set(v, silent, nosave)
                v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
                v = tonumber(string.format("%.4f", v))
                self.CurrentValue = v
                local a = (v - min) / math.max(max - min, 1e-9)
                tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.08)
                tween(knob, { Position = UDim2.new(a, math.floor((0.5 - a) * 10), 0.5, 0) }, 0.08)
                val.Text = tostring(v) .. suffix
                if not silent and o.Callback then task.spawn(o.Callback, v) end
                if not nosave then saveConfig() end
            end
            function Slider:Get() return self.CurrentValue end
            function Slider:_ToConfig() return self.CurrentValue end
            function Slider:_FromConfig(v) if type(v) == "number" then self:Set(v) end end

            local dragging = false
            local function fromX(x)
                Slider:Set(min + (max - min) * math.clamp((x - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1))
            end
            bar.InputBegan:Connect(function(i)
                if isPress(i) then
                    dragging = true
                    scroll.ScrollingEnabled = false
                    tween(knob, { Size = UDim2.fromOffset(12, 16) }, 0.1)
                    fromX(i.Position.X)
                end
            end)
            connect(UserInputService.InputChanged, function(i) if dragging and isMove(i) then fromX(i.Position.X) end end)
            connect(UserInputService.InputEnded, function(i)
                if isPress(i) and dragging then
                    dragging = false
                    scroll.ScrollingEnabled = true
                    tween(knob, { Size = UDim2.fromOffset(10, 14) }, 0.12)
                end
            end)

            register(o, Slider)
            Slider:Set(pick(o, "CurrentValue", "Default") or min, true, true)
            return Slider
        end

        -- dropdown: a field that opens a list (multi stays open while you tick items)
        function Tab:CreateDropdown(o)
            local c = card(o, 0)
            local multi = (o.MultipleOptions or o.Multi) and true or false
            local options = {}
            for _, v in ipairs(o.Options or {}) do table.insert(options, tostring(v)) end

            local ROW = 34
            local MAXROWS = o.MaxRows or 6
            local selected = {}
            local Dropdown = { Type = "Dropdown", CurrentOption = {}, Open = false, Flag = o.Flag }

            local wrap = create("Frame", {
                Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
            }, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

            local box, shown, arrow
            do
                box = create("TextButton", {
                    Parent = wrap, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Field,
                    BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = 0,
                }, { corner(5) })
                shown = text({
                    Parent = box, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -36, 1, 0),
                    TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = Theme.Desc, FontFace = FONT_SEMI,
                })
                local disc = create("Frame", {
                    Parent = box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -18, 0.5, 0),
                    Size = UDim2.fromOffset(20, 20), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
                }, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
                arrow = icon({
                    Parent = disc, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(12, 12),
                }, "chevron-down", Theme.Text)
            end

            local function visRows() return math.max(1, math.min(#options, MAXROWS)) end
            local function panelH() return visRows() * ROW + 8 end
            local function listH() return panelH() + 5 end

            local list = create("Frame", {
                Parent = wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                ClipsDescendants = true, LayoutOrder = 1, Visible = false,
            })
            local panel = create("Frame", {
                Parent = list, Position = UDim2.fromOffset(0, 5), Size = UDim2.new(1, 0, 0, panelH()),
                BackgroundColor3 = Theme.Button, BorderSizePixel = 0,
            }, { corner(10) })
            local optScroll = create("ScrollingFrame", {
                Parent = panel, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 4),
                Size = UDim2.new(1, 0, 0, visRows() * ROW), ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent,
                CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            }, { create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

            local rows = {}

            local function ordered()
                local t = {}
                for _, opt in ipairs(options) do if selected[opt] then table.insert(t, opt) end end
                return t
            end

            local function visuals()
                local names = ordered()
                Dropdown.CurrentOption = names
                for opt, r in pairs(rows) do
                    local on = selected[opt] == true
                    tween(r.btn, { BackgroundTransparency = on and 0.95 or 1 }, 0.15)
                    tween(r.label, { TextColor3 = on and Theme.Text or Theme.RowText })
                    if r.icon then tween(r.icon, { ImageColor3 = on and Theme.Accent or Theme.Desc }) end
                    tween(r.check, { ImageTransparency = on and 0 or 1, Size = on and UDim2.fromOffset(15, 15) or UDim2.fromOffset(6, 6) }, 0.22, Enum.EasingStyle.Back)
                end
                if shown then
                    if #names == 0 then
                        shown.Text = "Select..."
                        tween(shown, { TextColor3 = Theme.Desc })
                    else
                        shown.Text = (multi and #names > 2) and (#names .. " selected") or table.concat(names, ", ")
                        tween(shown, { TextColor3 = Theme.RowText })
                    end
                end
            end

            local function commit(silent, nosave)
                visuals()
                if not silent and o.Callback then task.spawn(o.Callback, Dropdown.CurrentOption) end
                if not nosave then saveConfig() end
            end

            local function setOpen(v)
                Dropdown.Open = v
                tween(arrow, { Rotation = v and 180 or 0 }, 0.25, Enum.EasingStyle.Quint)
                if v then
                    list.Visible = true
                    tween(list, { Size = UDim2.new(1, 0, 0, listH()) }, 0.28, Enum.EasingStyle.Quint)
                else
                    tween(list, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quint).Completed:Connect(function()
                        if not Dropdown.Open then list.Visible = false end
                    end)
                end
            end

            local function rebuild()
                for _, r in pairs(rows) do r.btn:Destroy() end
                rows = {}
                optScroll.Size = UDim2.new(1, 0, 0, visRows() * ROW)
                panel.Size = UDim2.new(1, 0, 0, panelH())
                if Dropdown.Open then list.Size = UDim2.new(1, 0, 0, listH()) end

                for i, opt in ipairs(options) do
                    local btn = create("TextButton", {
                        Parent = optScroll, Size = UDim2.new(1, 0, 0, ROW), BackgroundColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = i,
                    })
                    local optIcon = o.Icons and o.Icons[i]
                    local ico
                    if optIcon then
                        ico = icon({
                            Parent = btn, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0),
                            Size = UDim2.fromOffset(16, 16),
                        }, optIcon, Theme.Desc)
                    end
                    local label = text({
                        Parent = btn, Position = UDim2.fromOffset(optIcon and 40 or 14, 0),
                        Size = UDim2.new(1, -(optIcon and 70 or 44), 1, 0),
                        Text = opt, FontFace = FONT_SEMI, TextSize = 12, TextColor3 = Theme.RowText,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    })
                    local ck = icon({
                        Parent = btn, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
                        Size = UDim2.fromOffset(6, 6), ImageTransparency = 1,
                    }, "check", Theme.Accent)
                    if i < #options then
                        create("Frame", {
                            Parent = btn, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
                            Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
                        })
                    end
                    btn.MouseEnter:Connect(function()
                        if not selected[opt] then tween(btn, { BackgroundTransparency = 0.96 }, 0.1) end
                    end)
                    btn.MouseLeave:Connect(function()
                        if not selected[opt] then tween(btn, { BackgroundTransparency = 1 }, 0.1) end
                    end)
                    btn.MouseButton1Click:Connect(function()
                        if multi then
                            if selected[opt] then selected[opt] = nil else selected[opt] = true end
                        else
                            table.clear(selected)
                            selected[opt] = true
                            setOpen(false)
                        end
                        commit()
                    end)
                    rows[opt] = { btn = btn, label = label, icon = ico, check = ck }
                end
                visuals()
            end

            -- Dropdown:Set("One") or Dropdown:Set({ "One", "Two" })
            function Dropdown:Set(v, silent, nosave)
                table.clear(selected)
                local names = type(v) == "table" and v or { v }
                for _, n in ipairs(names) do
                    n = tostring(n)
                    if rows[n] then
                        selected[n] = true
                        if not multi then break end
                    end
                end
                commit(silent, nosave)
            end
            function Dropdown:Get() return self.CurrentOption end
            function Dropdown:Refresh(newOptions)
                options = {}
                for _, v in ipairs(newOptions or {}) do table.insert(options, tostring(v)) end
                for opt in pairs(selected) do
                    if not table.find(options, opt) then selected[opt] = nil end
                end
                rebuild()
            end
            function Dropdown:_ToConfig() return self.CurrentOption end
            function Dropdown:_FromConfig(v) self:Set(v) end

            if box then
                box.MouseEnter:Connect(function() if not Dropdown.Open then tween(box, { BackgroundColor3 = Theme.Track }) end end)
                box.MouseLeave:Connect(function() tween(box, { BackgroundColor3 = Theme.Field }) end)
                box.MouseButton1Click:Connect(function() setOpen(not Dropdown.Open) end)
                connect(UserInputService.InputBegan, function(input)
                    if Dropdown.Open and isPress(input) and not inside(wrap, screenPos(input)) then
                        setOpen(false)
                    end
                end)
            end

            rebuild()
            Dropdown.Open = false
            list.Visible = false
            list.Size = UDim2.new(1, 0, 0, 0)
            register(o, Dropdown)
            Dropdown:Set(pick(o, "CurrentOption", "Default") or {}, true, true)
            return Dropdown
        end

