        -- toggle ---------------------------------------------------------------
        function Tab:CreateToggle(o)
            local _, head = card(o, 44)
            local checkbox = o.Style == "Checkbox"
            local Toggle = { Type = "Toggle", CurrentValue = false, Flag = o.Flag }
            local apply

            if checkbox then
                local box = create("Frame", {
                    Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
                }, { corner(4) })
                local check = icon({
                    Parent = box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(4, 4), ImageTransparency = 1,
                }, "check", Theme.OnAccent)
                apply = function(v)
                    tween(box, { BackgroundColor3 = v and Theme.Accent or Theme.Control })
                    tween(check, { ImageTransparency = v and 0 or 1, Size = v and UDim2.fromOffset(13, 13) or UDim2.fromOffset(4, 4) }, 0.22, Enum.EasingStyle.Back)
                end
            else
                local sw = create("Frame", {
                    Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(34, 18), BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
                }, { corner(9) })
                local knob = create("Frame", {
                    Parent = sw, Position = UDim2.new(0, 3, 0.5, -6), Size = UDim2.fromOffset(12, 12),
                    BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                }, { corner(6) })
                apply = function(v)
                    tween(sw, { BackgroundColor3 = v and Theme.Accent or Theme.Control })
                    tween(knob, {
                        Position = v and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
                        BackgroundColor3 = v and Theme.OnAccent or Color3.new(1, 1, 1),
                    }, 0.22, Enum.EasingStyle.Back)
                end
            end

            function Toggle:Set(v, silent, nosave)
                self.CurrentValue = v and true or false
                apply(self.CurrentValue)
                if not silent and o.Callback then task.spawn(o.Callback, self.CurrentValue) end
                if not nosave then saveConfig() end
            end
            function Toggle:Get() return self.CurrentValue end
            function Toggle:_ToConfig() return self.CurrentValue end
            function Toggle:_FromConfig(v) self:Set(v == true) end

            overlay(head).MouseButton1Click:Connect(function() Toggle:Set(not Toggle.CurrentValue) end)
            register(o, Toggle)
            Toggle:Set(pick(o, "CurrentValue", "Default") or false, true, true)
            return Toggle
        end

