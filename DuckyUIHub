    Ducky UI Library  v2
    Black & yellow. Rayfield-style API. Icon sidebar, loading screen, notifications, config saving.
    Icons: Lucide (latte-soft/lucide-roblox sprite sheets - no file functions needed)

    local Ducky  = loadstring(game:HttpGet("https://raw.githubusercontent.com/<you>/Ducky/main/Library.lua"))()

    local Window = Ducky:CreateWindow({
        Name = "My Hub",
        LoadingTitle = "My Hub", LoadingSubtitle = "by me",
        ConfigurationSaving = { Enabled = true, FolderName = "MyHub", FileName = "Config" },
    })

    local Tab = Window:CreateTab("Combat", "skull")
    Tab:CreateSection("Aim")
    Tab:CreateToggle({ Name = "Enabled", CurrentValue = false, Flag = "Enabled", Callback = function(Value) end })

    Ducky:LoadConfiguration()

    Full docs: README.md
]]

