local function accentSet(c)
local hh, ss, vv = Color3.toHSV(c)
local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
return c, Color3.fromHSV(hh, ss, vv * 0.8), lum > 0.55 and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(255, 255, 255)
end

