local FAMILY    = "rbxasset://fonts/families/Nunito.json"
local FONT_REG  = Font.new(FAMILY, Enum.FontWeight.SemiBold)
local FONT_BOLD = Font.new(FAMILY, Enum.FontWeight.Bold)
local FONT_ITAL = Font.new(FAMILY, Enum.FontWeight.Bold, Enum.FontStyle.Italic)

