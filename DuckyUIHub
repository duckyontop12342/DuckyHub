    end

    -- tabs ----------------------------------------------------------------------------
    -- Window:CreateTab("Name", "icon")  or  Window:CreateTab({ Name = "Name", Icon = "icon" })
    function Window:CreateTab(a, b)
        local o = type(a) == "table" and a or { Name = a, Icon = b }

        local button = create("TextButton", {
            Parent = tabList, Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, LayoutOrder = #Window.Tabs + 1,
        })
        local fill = create("Frame", {
            Parent = button, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1, BorderSizePixel = 0,
        }, {
            create("UIGradient", {
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(1, 1),
                }),
            }),
        })
        local bar = create("Frame", {
            Parent = button, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        }, { corner(2) })

        local ico = icon({
            Parent = button, Position = UDim2.new(0.5, -11, 0, 15), Size = UDim2.fromOffset(22, 22),
        }, o.Icon or "circle", Theme.TabIdle)
        local label = text({
            Parent = button, Position = UDim2.fromOffset(0, 43), Size = UDim2.new(1, 0, 0, 14),
            Text = string.upper(o.Name or "Tab"), TextXAlignment = Enum.TextXAlignment.Center,
            FontFace = FONT_BOLD, TextSize = 10, TextColor3 = Theme.TabIdle, TextTruncate = Enum.TextTruncate.AtEnd,
        })

        -- page
        local group = create("CanvasGroup", {
            Parent = pages, BackgroundTransparency = 1, Visible = false, Size = UDim2.fromScale(1, 1),
        })
        local scroll = create("ScrollingFrame", {
            Parent = group, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
            ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        }, {
            create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Wraps = true,
                Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder,
            }),
            padding(0, 0, 8, 0),
        })

        local Tab = {
            Fill = fill, Bar = bar, Icon = ico, Label = label,
            Page = { Frame = group, Scroll = scroll },
        }
        table.insert(Window.Tabs, Tab)
        installItems(Tab, Tab.Page)

        button.MouseEnter:Connect(function()
            if currentTab ~= Tab then
                tween(label, { TextColor3 = Theme.TabHover })
                tween(ico, { ImageColor3 = Theme.TabHover, Position = UDim2.new(0.5, -11, 0, 12) }, 0.2, Enum.EasingStyle.Back)
            end
        end)
        button.MouseLeave:Connect(function()
            if currentTab ~= Tab then
                tween(label, { TextColor3 = Theme.TabIdle })
                tween(ico, { ImageColor3 = Theme.TabIdle, Position = UDim2.new(0.5, -11, 0, 15) }, 0.2)
            end
        end)
        button.MouseButton1Click:Connect(function() select(Tab) end)

        if not currentTab then select(Tab) end
        return Tab
    end
    Window.AddTab = Window.CreateTab

    -- show / hide ---------------------------------------------------------------------
    local function show()
        Window.Open = true
        Window.Loaded = true
        main.Visible = true
        underline.Size = UDim2.fromOffset(0, 2)
        tween(main, { GroupTransparency = 0 }, 0.25)
        tween(scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
        tween(underline, { Size = UDim2.fromOffset(LOGO_W, 2) }, 0.7, Enum.EasingStyle.Quint)
        task.delay(0.05, updateBar)
        task.delay(0.45, updateBar)
    end

    local function hide()
        Window.Open = false
        tween(main, { GroupTransparency = 1 }, 0.2)
        tween(scale, { Scale = 0.92 }, 0.2).Completed:Connect(function()
            if not Window.Open then main.Visible = false end
        end)
    end

    function Window:Toggle()
        if not Window.Loaded then return end
        if Window.Open then hide() else show() end
    end
    function Window:Show() if Window.Loaded and not Window.Open then show() end end
    function Window:Hide() if Window.Loaded and Window.Open then hide() end end

    function Window:Destroy()
        for _, c in ipairs(Window.Connections) do c:Disconnect() end
        gui:Destroy()
        if Ducky._window == Window then Ducky._window = nil end
    end

    connect(UserInputService.InputBegan, function(input, gpe)
        if not gpe and input.KeyCode == keybind then Window:Toggle() end
    end)

    -- floating toggle button for touch devices
    if opts.ToggleButton == true or (opts.ToggleButton == nil and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
        local tb = create("TextButton", {
            Parent = gui, Size = UDim2.fromOffset(42, 42), Position = UDim2.fromOffset(14, 72),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        }, { corner(21) })
        icon({
            Parent = tb, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(22, 22),
        }, "bird", Theme.OnAccent)
        tb.MouseButton1Click:Connect(function() Window:Toggle() end)
    end

    -- loading screen ---------------------------------------------------------------------
    if opts.LoadingEnabled == false then
        task.defer(show)
    else
        local duration = opts.LoadingTime or 1.9
        local loader = create("CanvasGroup", {
            Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(340, 196), BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
            GroupTransparency = 1,
        }, { corner(12), stroke(Theme.Border, 1) })
        local lscale = create("UIScale", { Parent = loader, Scale = 0.88 })

        local ltitle = text({
            Parent = loader, Position = UDim2.fromOffset(20, 26), Size = UDim2.new(1, -40, 0, 42),
            TextXAlignment = Enum.TextXAlignment.Center, Text = opts.LoadingTitle or name,
            TextScaled = true, FontFace = FONT_ITAL,
        })
        create("UITextSizeConstraint", { Parent = ltitle, MaxTextSize = 32, MinTextSize = 12 })
        create("UIGradient", { Parent = ltitle, Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) })

        local lunder = create("Frame", {
            Parent = loader, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 72),
            Size = UDim2.fromOffset(0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, {
            create("UIGradient", {
                Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1),
                }),
            }),
        })

        text({
            Parent = loader, Position = UDim2.fromOffset(20, 84), Size = UDim2.new(1, -40, 0, 16),
            TextXAlignment = Enum.TextXAlignment.Center, Text = opts.LoadingSubtitle or "Loading interface...",
            TextColor3 = Theme.Desc, FontFace = FONT_SEMI, TextSize = 12,
        })

        local spin = icon({
            Parent = loader, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 114),
            Size = UDim2.fromOffset(18, 18),
        }, "loader", Theme.Accent)
        TweenService:Create(spin, TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = 360 }):Play()

        local status = text({
            Parent = loader, Position = UDim2.fromOffset(20, 138), Size = UDim2.new(1, -40, 0, 14),
            TextXAlignment = Enum.TextXAlignment.Center, Text = "Initializing...",
            TextColor3 = Theme.Desc, FontFace = FONT_REG, TextSize = 11,
        })

        local lbar = create("Frame", {
            Parent = loader, Position = UDim2.new(0, 36, 0, 166), Size = UDim2.new(1, -72, 0, 4),
            BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
        }, { corner(2) })
        local lfill = create("Frame", {
            Parent = lbar, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, {
            corner(2),
            create("UIGradient", { Color = ColorSequence.new(Theme.AccentDim, Theme.Accent) }),
        })

        task.spawn(function()
            tween(loader, { GroupTransparency = 0 }, 0.3)
            tween(lscale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
            tween(lunder, { Size = UDim2.fromOffset(130, 2) }, 0.9, Enum.EasingStyle.Quint)
            tween(lfill, { Size = UDim2.fromScale(1, 1) }, duration, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)

            local steps = {
                { 0.30, "Loading icons..." },
                { 0.60, "Building interface..." },
                { 0.88, "Almost ready..." },
            }
            local start = os.clock()
            for _, st in ipairs(steps) do
                local wait = start + st[1] * duration - os.clock()
                if wait > 0 then task.wait(wait) end
                status.Text = st[2]
            end
            local rest = start + duration - os.clock()
            if rest > 0 then task.wait(rest) end
            status.Text = "Ready"
            task.wait(0.25)

            tween(loader, { GroupTransparency = 1 }, 0.3)
            tween(lscale, { Scale = 1.06 }, 0.3)
            task.wait(0.32)
            loader:Destroy()
            show()
        end)
    end
do
        local dragArea = create("Frame", { Parent = main, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), ZIndex = 0, Active = true })
