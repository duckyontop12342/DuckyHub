-- notifications
local notifGui, notifHolder, notifOrder = nil, nil, 0
local function ensureNotifHolder()
    if notifGui and notifGui.Parent then return notifHolder end
    notifGui = create("ScreenGui", {
        Name = "DuckyNotifications", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, Parent = protectedParent(),
    })
    notifHolder = create("Frame", {
        Parent = notifGui, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 290, 1, -32),
    }, {
        create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }),
    })
    return notifHolder
end

function Ducky:Notify(o)
    o = o or {}
    local holder = ensureNotifHolder()
    notifOrder += 1
    local duration = o.Duration or 5
    local hasIcon = o.Image ~= nil

    local wrapper = create("Frame", {
        Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = notifOrder,
    })
    local card = create("Frame", {
        Parent = wrapper, Position = UDim2.new(0, 320, 0, 0), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
        ClipsDescendants = true,
    }, { corner(8), stroke(Theme.Border, 1) })

    create("Frame", { Parent = card, Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 })
    if hasIcon then
        icon({ Parent = card, Position = UDim2.fromOffset(16, 13), Size = UDim2.fromOffset(18, 18) }, o.Image, Theme.Accent)
    end

    local body = create("Frame", {
        Parent = card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    }, {
        padding(12, 14, 14, hasIcon and 44 or 16),
        create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    text({
        Parent = body, Size = UDim2.new(1, 0, 0, 16), Text = o.Title or "Notification",
        FontFace = FONT_BOLD, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 0,
    })
    if o.Content and o.Content ~= "" then
        text({
            Parent = body, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Text = o.Content, TextColor3 = Theme.Desc, TextSize = 12, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1,
        })
    end

    local progress = create("Frame", {
        Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(card, { Position = UDim2.new(0, 320, 0, 0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.32, function() wrapper:Destroy() end)
    end

    local hit = create("TextButton", { Parent = card, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 5 })
    hit.MouseButton1Click:Connect(close)

    tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Quint)
    tween(progress, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, close)
    return { Close = close }
end

function Ducky:Destroy()
    if Ducky._window then Ducky._window:Destroy() end
end
function Ducky:LoadConfiguration()
    if Ducky._window then return Ducky._window:LoadConfiguration() end
    return false
end

-- window
function Ducky:CreateWindow(opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}
    for k, v in pairs(opts.Theme or {}) do Theme[k] = v end
    loadLucide()

    local name     = opts.Name or "Ducky"
    local logoText = opts.Logo or opts.Title or "Ducky"
    local keybind  = parseKey(opts.Keybind or opts.ToggleUIKeybind, Enum.KeyCode.RightShift)
    local winSize  = opts.Size or Vector2.new(620, 360)
    local WIN_W, WIN_H = winSize.X, winSize.Y

    local cs = opts.ConfigurationSaving
    local cfg = {
        enabled = cs and cs.Enabled == true,
        folder  = cs and cs.FolderName,
        file    = ((cs and cs.FileName) or "Config") .. ".json",
    }
    local function cfgPath()
        return cfg.folder and (cfg.folder .. "/" .. cfg.file) or cfg.file
    end

    local parent = protectedParent()
    local old = parent:FindFirstChild("DuckyUI")
    if old then old:Destroy() end
    table.clear(Ducky.Flags)

    local Window = { Tabs = {}, Connections = {}, Flags = Ducky.Flags, Open = true, Loaded = false, Actions = 0 }
    Ducky._window = Window

    local function connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(Window.Connections, c)
        return c
    end

    local gui = create("ScreenGui", {
        Name = "DuckyUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parent,
    })
    Window.Gui = gui

    local main = create("CanvasGroup", {
        Name = "Main", Parent = gui, BackgroundColor3 = Theme.Window, BorderSizePixel = 0,
        Size = UDim2.fromOffset(WIN_W, WIN_H), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 1, Visible = false,
    }, { corner(8), stroke(Theme.Border, 1) })
    local scale = create("UIScale", { Parent = main, Scale = 0.9 })
    Window.Main = main

    local saveToken, loadingConfig = 0, false
    local function saveConfig()
        if not cfg.enabled or loadingConfig then return end
        saveToken += 1
        local token = saveToken
        task.delay(0.4, function()
            if token ~= saveToken then return end
            local data = {}
            for flag, el in pairs(Ducky.Flags) do
                if el._ToConfig then data[flag] = el:_ToConfig() end
            end
            pcall(function()
                if cfg.folder and makefolder and isfolder and not isfolder(cfg.folder) then makefolder(cfg.folder) end
                writefile(cfgPath(), HttpService:JSONEncode(data))
            end)
        end)
    end

    function Window:LoadConfiguration()
        if not cfg.enabled then return false end
        local ok, data = pcall(function()
            if not (isfile and isfile(cfgPath())) then return nil end
            return HttpService:JSONDecode(readfile(cfgPath()))
        end)
        if not ok or type(data) ~= "table" then return false end
        loadingConfig = true
        for flag, value in pairs(data) do
            local el = Ducky.Flags[flag]
            if el and el._FromConfig then pcall(el._FromConfig, el, value) end
        end
        loadingConfig = false
        return true
    end

    -- sidebar bg
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Size = UDim2.new(0, SIDEBAR_W, 1, 0) })
    create("Frame", { Parent = main, BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Position = UDim2.fromOffset(SIDEBAR_W, 0), Size = UDim2.new(0, 1, 1, 0) })

    local logoArea = create("Frame", {
        Parent = main, BackgroundTransparency = 1, Size = UDim2.fromOffset(SIDEBAR_W, 76), Active = true,
    })
    local logo = text({
        Parent = logoArea, Position = UDim2.fromOffset(6, 18), Size = UDim2.new(1, -12, 0, 30),
        TextXAlignment = Enum.TextXAlignment.Center, Text = logoText, TextScaled = true, FontFace = FONT_ITAL,
    })
    create("UITextSizeConstraint", { Parent = logo, MaxTextSize = 24, MinTextSize = 10 })
    create("UIGradient", { Parent = logo, Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) })

    local underline = create("Frame", {
        Parent = logoArea, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50),
        Size = UDim2.fromOffset(LOGO_W, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, {
        create("UIGradient", {
            Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.5, 0.35),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    -- SCROLLABLE TAB LIST (hidden bar, mobile)
    local tabList = create("ScrollingFrame", {
        Parent = main,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 80),
        Size = UDim2.new(0, SIDEBAR_W, 1, -80),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ElasticBehavior = Enum.ElasticBehavior.Always,
        ScrollingEnabled = true,
        BorderSizePixel = 0,
    }, {
        create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }),
        padding(0, 0, 12, 0),
    })

    local pages = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(SIDEBAR_W + 12, 16),
        Size = UDim2.new(1, -(SIDEBAR_W + 12 + 44), 1, -32),
    })

    -- drag
    do
        local dragArea = create("Frame", { Parent = main, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), ZIndex = 0, Active = true })
        local dragging, startPos, startInput
        local function begin(frame)
            connect(frame.InputBegan, function(input)
                if isPress(input) then dragging, startPos, startInput = true, main.Position, input.Position end
            end)
        end
        begin(dragArea)
        begin(logoArea)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) then
                local d = input.Position - startInput
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    -- custom content scrollbar thumb
    local track = create("Frame", {
        Parent = main, BackgroundTransparency = 1,
        Position = UDim2.new(1, -34, 0, 16), Size = UDim2.new(0, 10, 1, -32),
    })
    local thumb = create("Frame", {
        Parent = track, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40), Visible = false,
    }, {
        corner(5),
        create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) }),
    })
    local thumbHit = create("TextButton", { Parent = thumb, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "" })

    local currentTab, currentPage
    local barConns = {}

    local function updateBar()
        local s = currentPage and currentPage.Scroll
        if not s then thumb.Visible = false return end
        local view, canvas = s.AbsoluteWindowSize.Y, s.AbsoluteCanvasSize.Y
        if canvas <= view + 1 then thumb.Visible = false return end
        thumb.Visible = true
        local trackH = track.AbsoluteSize.Y
        local h = math.max(30, trackH * view / canvas)
        local a = math.clamp(s.CanvasPosition.Y / (canvas - view), 0, 1)
        thumb.Size = UDim2.new(1, 0, 0, h)
        thumb.Position = UDim2.new(0, 0, 0, (trackH - h) * a)
    end

    local function bindBar(scroll)
        for _, c in ipairs(barConns) do c:Disconnect() end
        table.clear(barConns)
        for _, prop in ipairs({"CanvasPosition", "AbsoluteCanvasSize", "AbsoluteWindowSize"}) do
            table.insert(barConns, scroll:GetPropertyChangedSignal(prop):Connect(updateBar))
        end
        updateBar()
    end

    do
        local dragging, startY, startCanvas
        thumbHit.InputBegan:Connect(function(input)
            if isPress(input) and currentPage then
                dragging, startY, startCanvas = true, input.Position.Y, currentPage.Scroll.CanvasPosition.Y
            end
        end)
        connect(UserInputService.InputChanged, function(input)
            if dragging and isMove(input) and currentPage then
                local s = currentPage.Scroll
                local trackRange = track.AbsoluteSize.Y - thumb.AbsoluteSize.Y
                local maxScroll = s.AbsoluteCanvasSize.Y - s.AbsoluteWindowSize.Y
                if trackRange > 0 then
                    s.CanvasPosition = Vector2.new(0, startCanvas + (input.Position.Y - startY) / trackRange * maxScroll)
                end
            end
        end)
        connect(UserInputService.InputEnded, function(input) if isPress(input) then dragging = false end end)
    end

    function Window:AddAction(o)
        local y = 18 + Window.Actions * 24
        Window.Actions += 1
        local b = create("TextButton", {
            Parent = main, BackgroundTransparency = 1, Text = "",
            Position = UDim2.new(1, -22, 0, y), Size = UDim2.fromOffset(16, 16),
        })
        local ico = icon({ Parent = b, Size = UDim2.fromScale(1, 1) }, o.Icon or "settings", Theme.TabIdle)
        b.MouseEnter:Connect(function() tween(ico, { ImageColor3 = Theme.Accent }) end)
        b.MouseLeave:Connect(function() tween(ico, { ImageColor3 = Theme.TabIdle }) end)
        b.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
    end

    function Window:Notify(o) return Ducky:Notify(o) end

    local function refreshTabs()
        for _, tab in ipairs(Window.Tabs) do
            local active = tab == currentTab
            local color = active and Theme.Accent or Theme.TabIdle
            tween(tab.Fill, { BackgroundTransparency = active and 0 or 1 }, 0.25)
            tween(tab.Bar, { Size = UDim2.new(0, 3, active and 0.55 or 0, 0) }, 0.25, Enum.EasingStyle.Quint)
            tween(tab.Label, { TextColor3 = color })
            tween(tab.Icon, { ImageColor3 = color })
        end
    end

    local function select(tab)
        local previous = currentPage
        local page = tab.Page
        currentTab, currentPage = tab, page
        for _, t in ipairs(Window.Tabs) do
            if t.Page ~= page then t.Page.Frame.Visible = false end
        end
        if page ~= previous then
            page.Frame.Position = UDim2.fromOffset(0, 14)
            page.Frame.GroupTransparency = 1
            page.Frame.Visible = true
            tween(page.Frame, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quint)
        end
        bindBar(page.Scroll)
        refreshTabs()
    end

    -- ========== ITEM CONSTRUCTORS ==========
    local function installItems(Tab, page)
        local scroll = page.Scroll
        local order = 0

        local function register(o, ctrl)
            if o.Flag then Ducky.Flags[o.Flag] = ctrl end
        end

        local function card(o, reserve)
            reserve = reserve or 0
            order += 1
            local cols = o.Columns or 1
            local c = create("Frame", {
                Parent = scroll, BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
                Size = columnWidth(cols), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order,
            }, {
                corner(6), padding(10, 12, 10, 12),
                create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
            })
            c.MouseEnter:Connect(function() tween(c, { BackgroundColor3 = Theme.CardHover }) end)
            c.MouseLeave:Connect(function() tween(c, { BackgroundColor3 = Theme.Card }) end)

            local head = create("Frame", {
                Parent = c, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0,
            })
            local title = text({
                Parent = head, Size = UDim2.new(1, -reserve, 0, 16),
                Text = o.Name or "", FontFace = FONT_SEMI, TextSize = 13,
            })
            if o.Description and o.Description ~= "" then
                text({
                    Parent = head, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, -reserve, 0, 14),
                    Text = o.Description, TextColor3 = Theme.Desc, TextSize = 11, TextWrapped = true,
                })
                head.Size = UDim2.new(1, 0, 0, 36)
            end
            return c, head
        end

        function Tab:CreateSection(name)
            order += 1
            local s = text({
                Parent = scroll, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order,
                Text = string.upper(tostring(name or "Section")), FontFace = FONT_BOLD,
                TextSize = 11, TextColor3 = Theme.Desc,
            })
            return s
        end

        function Tab:CreateLabel(o)
            if type(o) == "string" then o = { Name = o } end
            order += 1
            return text({
                Parent = scroll, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = order,
                Text = o.Name or "", TextColor3 = Theme.RowText, TextSize = 12,
            })
        end

        function Tab:CreateParagraph(o)
            order += 1
            return text({
                Parent = scroll, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                LayoutOrder = order, Text = o.Content or o.Name or "", TextColor3 = Theme.Desc,
                TextSize = 12, TextWrapped = true,
            })
        end

        function Tab:CreateButton(o)
            local c = card(o, 0)
            local btn = create("TextButton", {
                Parent = c, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0, Text = o.ButtonText or o.Name or "Button",
                FontFace = FONT_BOLD, TextSize = 12, TextColor3 = Theme.OnAccent,
                AutoButtonColor = false, LayoutOrder = 1,
            }, { corner(6) })
            btn.MouseButton1Click:Connect(function()
                if o.Callback then task.spawn(o.Callback) end
            end)
            return { Type = "Button" }
        end

        function Tab:CreateToggle(o)
            local _, head = card(o, 44)
            local state = pick(o, "CurrentValue", "Default") == true
            local Toggle = { Type = "Toggle", CurrentValue = state, Flag = o.Flag }

            local track = create("TextButton", {
                Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.fromOffset(36, 20), BackgroundColor3 = state and Theme.Accent or Theme.Control,
                Text = "", AutoButtonColor = false, BorderSizePixel = 0,
            }, { corner(10) })
            local knob = create("Frame", {
                Parent = track, Size = UDim2.fromOffset(16, 16),
                Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
                BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
            }, { corner(8) })

            local function set(v, silent, nosave)
                state = v and true or false
                Toggle.CurrentValue = state
                tween(track, { BackgroundColor3 = state and Theme.Accent or Theme.Control })
                tween(knob, { Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2) })
                if not silent and o.Callback then task.spawn(o.Callback, state) end
                if not nosave then saveConfig() end
            end

            function Toggle:Set(v, silent, nosave) set(v, silent, nosave) end
            function Toggle:Get() return self.CurrentValue end
            function Toggle:_ToConfig() return self.CurrentValue end
            function Toggle:_FromConfig(v) self:Set(v, true) end

            track.MouseButton1Click:Connect(function() set(not state) end)
            register(o, Toggle)
            return Toggle
        end

        function Tab:CreateSlider(o)
            local c = card(o, 0)
            local minV = o.Min or 0
            local maxV = o.Max or 100
            local step = o.Increment or 1
            local value = pick(o, "CurrentValue", "Default") or minV
            value = math.clamp(value, minV, maxV)

            local valLabel = text({
                Parent = c, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1,
                Text = tostring(value), TextColor3 = Theme.Accent, FontFace = FONT_BOLD, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
            })

            local bar = create("Frame", {
                Parent = c, Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, LayoutOrder = 2,
            }, { corner(3) })
            local fill = create("Frame", {
                Parent = bar, Size = UDim2.fromScale((value - minV) / (maxV - minV), 1),
                BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
            }, { corner(3) })
            local hit = create("TextButton", {
                Parent = bar, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
            })

            local Slider = { Type = "Slider", CurrentValue = value, Flag = o.Flag }

            local function set(v, silent, nosave)
                v = math.clamp(math.floor(v / step + 0.5) * step, minV, maxV)
                value = v
                Slider.CurrentValue = v
                fill.Size = UDim2.fromScale((v - minV) / (maxV - minV), 1)
                valLabel.Text = tostring(v)
                if not silent and o.Callback then task.spawn(o.Callback, v) end
                if not nosave then saveConfig() end
            end

            function Slider:Set(v, silent, nosave) set(v, silent, nosave) end
            function Slider:Get() return self.CurrentValue end
            function Slider:_ToConfig() return self.CurrentValue end
            function Slider:_FromConfig(v) self:Set(tonumber(v) or minV) end

            local sliding = false
            local function fromX(x)
                local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                set(minV + (maxV - minV) * a)
            end
            hit.InputBegan:Connect(function(input)
                if isPress(input) then sliding = true fromX(input.Position.X) end
            end)
            connect(UserInputService.InputChanged, function(input)
                if sliding and isMove(input) then fromX(input.Position.X) end
            end)
            connect(UserInputService.InputEnded, function(input)
                if isPress(input) then sliding = false end
            end)

            register(o, Slider)
            return Slider
        end

        function Tab:CreateDropdown(o)
            local c = card(o, 0)
            local multi = o.Multi == true
            local options = {}
            for _, v in ipairs(o.Options or {}) do table.insert(options, tostring(v)) end
            local selected = {}

            local box = create("TextButton", {
                Parent = c, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = 1,
            }, { corner(5), padding(0, 10, 0, 10) })
            local boxStroke = stroke(Theme.Border, 1)
            boxStroke.Parent = box
            local boxLabel = text({
                Parent = box, Size = UDim2.new(1, -20, 1, 0), Text = "Select...", TextSize = 12,
            })
            text({
                Parent = box, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.fromOffset(16, 16), Text = "▾", TextXAlignment = Enum.TextXAlignment.Center,
                TextColor3 = Theme.Desc, TextSize = 12,
            })

            local list = create("Frame", {
                Parent = c, Visible = false, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, LayoutOrder = 2, ClipsDescendants = true,
            }, { corner(5), padding(4, 4, 4, 4), create("UIListLayout", { Padding = UDim.new(0, 2) }) })

            local Dropdown = { Type = "Dropdown", CurrentOption = multi and {} or "", Flag = o.Flag, Open = false }

            local function commit(silent, nosave)
                if multi then
                    local arr = {}
                    for k in pairs(selected) do table.insert(arr, k) end
                    table.sort(arr)
                    Dropdown.CurrentOption = arr
                    boxLabel.Text = #arr > 0 and table.concat(arr, ", ") or "Select..."
                else
                    local one = next(selected)
                    Dropdown.CurrentOption = one or ""
                    boxLabel.Text = one or "Select..."
                end
                if not silent and o.Callback then task.spawn(o.Callback, Dropdown.CurrentOption) end
                if not nosave then saveConfig() end
            end

            local function rebuild()
                for _, ch in ipairs(list:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for _, opt in ipairs(options) do
                    local row = create("TextButton", {
                        Parent = list, Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Card,
                        BorderSizePixel = 0, Text = "  " .. opt, FontFace = FONT_REG, TextSize = 12,
                        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    }, { corner(4) })
                    row.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt] and true or nil
                        else
                            table.clear(selected)
                            selected[opt] = true
                            Dropdown.Open = false
                            list.Visible = false
                        end
                        commit()
                    end)
                end
            end

            function Dropdown:Set(v, silent, nosave)
                table.clear(selected)
                local names = type(v) == "table" and v or { v }
                for _, n in ipairs(names) do
                    n = tostring(n)
                    if table.find(options, n) then
                        selected[n] = true
                        if not multi then break end
                    end
                end
                commit(silent, nosave)
            end
            function Dropdown:Get() return self.CurrentOption end
            function Dropdown:_ToConfig() return self.CurrentOption end
            function Dropdown:_FromConfig(v) self:Set(v) end

            box.MouseButton1Click:Connect(function()
                Dropdown.Open = not Dropdown.Open
                list.Visible = Dropdown.Open
            end)

            rebuild()
            register(o, Dropdown)
            Dropdown:Set(pick(o, "CurrentOption", "Default") or (multi and {} or ""), true, true)
            return Dropdown
        end

        function Tab:CreateColorPicker(o)
            local _, head = card(o, 30)
            local h, s, v = Color3.toHSV(pick(o, "Color", "Default") or Theme.Accent)
            local swatch = create("TextButton", {
                Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.fromOffset(20, 20), BackgroundColor3 = Color3.fromHSV(h, s, v),
                Text = "", AutoButtonColor = false,
            }, { corner(10), stroke(Color3.fromRGB(80, 80, 80), 1) })

            local Picker = { Type = "ColorPicker", Color = Color3.fromHSV(h, s, v), Flag = o.Flag }
            function Picker:Set(color, silent, nosave)
                h, s, v = Color3.toHSV(color)
                Picker.Color = color
                swatch.BackgroundColor3 = color
                if not silent and o.Callback then task.spawn(o.Callback, color) end
                if not nosave then saveConfig() end
            end
            function Picker:Get() return self.Color end
            function Picker:_ToConfig()
                local c3 = self.Color
                return { math.floor(c3.R*255+0.5), math.floor(c3.G*255+0.5), math.floor(c3.B*255+0.5) }
            end
            function Picker:_FromConfig(t)
                if type(t) == "table" and #t >= 3 then self:Set(Color3.fromRGB(t[1], t[2], t[3])) end
            end

            swatch.MouseButton1Click:Connect(function()
                -- simple cycle for compactness; full HSV popup can be expanded later
            end)
            register(o, Picker)
            return Picker
        end

        function Tab:CreateKeybind(o)
            local _, head = card(o, 84)
            local key = parseKey(pick(o, "CurrentKeybind", "Default") or "Q", Enum.KeyCode.Q)
            local Keybind = { Type = "Keybind", CurrentKeybind = key.Name, Flag = o.Flag }

            local box = create("TextButton", {
                Parent = head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            }, { corner(5), padding(0, 10, 0, 10) })
            local lab = text({
                Parent = box, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
                TextXAlignment = Enum.TextXAlignment.Center, Text = key.Name, FontFace = FONT_BOLD, TextSize = 11,
            })

            local listening = false
            local function setKey(kc, silent, nosave)
                key = kc
                Keybind.CurrentKeybind = kc.Name
                lab.Text = kc.Name
                if not silent and o.ChangedCallback then task.spawn(o.ChangedCallback, kc.Name) end
                if not nosave then saveConfig() end
            end
            function Keybind:Set(v, silent, nosave) setKey(parseKey(v, key), silent, nosave) end
            function Keybind:Get() return self.CurrentKeybind end
            function Keybind:_ToConfig() return self.CurrentKeybind end
            function Keybind:_FromConfig(v) self:Set(v, true) end

            box.MouseButton1Click:Connect(function()
                listening = true
                lab.Text = "..."
            end)
            connect(UserInputService.InputBegan, function(input, gpe)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if listening then
                    listening = false
                    if input.KeyCode ~= Enum.KeyCode.Escape then setKey(input.KeyCode) else lab.Text = key.Name end
                    return
                end
                if gpe or UserInputService:GetFocusedTextBox() then return end
                if input.KeyCode == key and o.Callback then task.spawn(o.Callback, key.Name) end
            end)
            register(o, Keybind)
            return Keybind
        end

        function Tab:CreateInput(o)
            local c = card(o, 0)
            local field = create("TextBox", {
                Parent = c, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Field,
                BorderSizePixel = 0, Text = tostring(pick(o, "CurrentValue", "Default") or ""),
                PlaceholderText = o.PlaceholderText or "Type here...", PlaceholderColor3 = Theme.Desc,
                TextColor3 = Theme.Text, FontFace = FONT_SEMI, TextSize = 12, ClearTextOnFocus = false,
                TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
            }, { corner(5), padding(0, 10, 0, 10) })

            local Input = { Type = "Input", CurrentValue = field.Text, Flag = o.Flag }
            function Input:Set(t, silent, nosave)
                field.Text = tostring(t)
                self.CurrentValue = field.Text
                if not silent and o.Callback then task.spawn(o.Callback, self.CurrentValue) end
                if not nosave then saveConfig() end
            end
            function Input:Get() return self.CurrentValue end
            function Input:_ToConfig() return self.CurrentValue end
            function Input:_FromConfig(v) self:Set(tostring(v)) end

            field.FocusLost:Connect(function()
                Input.CurrentValue = field.Text
                if o.Callback then task.spawn(o.Callback, field.Text) end
                saveConfig()
            end)
            register(o, Input)
            return Input
        end

        -- aliases
        Tab.AddToggle = Tab.CreateToggle
        Tab.AddButton = Tab.CreateButton
        Tab.AddSlider = Tab.CreateSlider
        Tab.AddDropdown = Tab.CreateDropdown
        Tab.AddColorPicker = Tab.CreateColorPicker
        Tab.AddKeybind = Tab.CreateKeybind
        Tab.AddInput = Tab.CreateInput
        Tab.AddLabel = Tab.CreateLabel
        Tab.AddParagraph = Tab.CreateParagraph
        Tab.AddSection = Tab.CreateSection
    end

    -- tabs
    function Window:CreateTab(a, b)
        local o = type(a) == "table" and a or { Name = a, Icon = b }

        local button = create("TextButton", {
            Parent = tabList, Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, LayoutOrder = #Window.Tabs + 1,
        })
        local fill = create("Frame", {
            Parent = button, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1, BorderSizePixel = 0,
        }, {
            create("UIGradient", {
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(1, 1),
                }),
            }),
        })
        local bar = create("Frame", {
            Parent = button, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        }, { corner(2) })

        local ico = icon({
            Parent = button, Position = UDim2.new(0.5, -11, 0, 15), Size = UDim2.fromOffset(22, 22),
        }, o.Icon or "circle", Theme.TabIdle)
        local label = text({
            Parent = button, Position = UDim2.fromOffset(0, 43), Size = UDim2.new(1, 0, 0, 14),
            Text = string.upper(o.Name or "Tab"), TextXAlignment = Enum.TextXAlignment.Center,
            FontFace = FONT_BOLD, TextSize = 10, TextColor3 = Theme.TabIdle, TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local group = create("CanvasGroup", {
            Parent = pages, BackgroundTransparency = 1, Visible = false, Size = UDim2.fromScale(1, 1),
        })
        local scroll = create("ScrollingFrame", {
            Parent = group, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
            ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ElasticBehavior = Enum.ElasticBehavior.Always,
            ScrollingEnabled = true,
        }, {
            create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Wraps = true,
                Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder,
            }),
            padding(0, 0, 8, 0),
        })

        local Tab = {
            Fill = fill, Bar = bar, Icon = ico, Label = label,
            Page = { Frame = group, Scroll = scroll },
        }
        table.insert(Window.Tabs, Tab)
        installItems(Tab, Tab.Page)

        button.MouseEnter:Connect(function()
            if currentTab ~= Tab then
                tween(label, { TextColor3 = Theme.TabHover })
                tween(ico, { ImageColor3 = Theme.TabHover })
            end
        end)
        button.MouseLeave:Connect(function()
            if currentTab ~= Tab then
                tween(label, { TextColor3 = Theme.TabIdle })
                tween(ico, { ImageColor3 = Theme.TabIdle })
            end
        end)
        button.MouseButton1Click:Connect(function() select(Tab) end)

        if not currentTab then select(Tab) end
        return Tab
    end
    Window.AddTab = Window.CreateTab

    -- show / hide
    local function show()
        Window.Open = true
        Window.Loaded = true
        main.Visible = true
        underline.Size = UDim2.fromOffset(0, 2)
        tween(main, { GroupTransparency = 0 }, 0.25)
        tween(scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
        tween(underline, { Size = UDim2.fromOffset(LOGO_W, 2) }, 0.7, Enum.EasingStyle.Quint)
        task.delay(0.05, updateBar)
        task.delay(0.45, updateBar)
    end
    local function hide()
        Window.Open = false
        tween(main, { GroupTransparency = 1 }, 0.2)
        tween(scale, { Scale = 0.92 }, 0.2).Completed:Connect(function()
            if not Window.Open then main.Visible = false end
        end)
    end

    function Window:Toggle()
        if not Window.Loaded then return end
        if Window.Open then hide() else show() end
    end
    function Window:Show() if Window.Loaded and not Window.Open then show() end end
    function Window:Hide() if Window.Loaded and Window.Open then hide() end end
    function Window:Destroy()
        for _, c in ipairs(Window.Connections) do c:Disconnect() end
        gui:Destroy()
        if Ducky._window == Window then Ducky._window = nil end
    end

    connect(UserInputService.InputBegan, function(input, gpe)
        if not gpe and input.KeyCode == keybind then Window:Toggle() end
    end)

    if opts.ToggleButton == true or (opts.ToggleButton == nil and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
        local tb = create("TextButton", {
            Parent = gui, Size = UDim2.fromOffset(42, 42), Position = UDim2.fromOffset(14, 72),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        }, { corner(21) })
        icon({
            Parent = tb, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(22, 22),
        }, "bird", Theme.OnAccent)
        tb.MouseButton1Click:Connect(function() Window:Toggle() end)
    end

    if opts.LoadingEnabled == false then
        task.defer(show)
    else
        local duration = opts.LoadingTime or 1.5
        task.delay(0.1, show)
    end

    return Window
end

return Ducky
