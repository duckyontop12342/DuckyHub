function Ducky:CreateWindow(opts)
if type(opts) == "string" then opts = { Name = opts } end
opts = opts or {}

local presetName = "Ducky"
if type(opts.Theme) == "string" and PRESETS[opts.Theme] then
    presetName = opts.Theme
    Theme.Accent, Theme.AccentDim, Theme.OnAccent = accentSet(PRESETS[opts.Theme])
elseif type(opts.Theme) == "table" then
    for k, v in pairs(opts.Theme) do Theme[k] = v end
end
if typeof(opts.Accent) == "Color3" then
    presetName = nil
    Theme.Accent, Theme.AccentDim, Theme.OnAccent = accentSet(opts.Accent)
end
loadLucide()

local name      = opts.Name or "Ducky"
