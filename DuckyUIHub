            tween(tab.Bar, { Size = UDim2.new(0, 3, active and 0.55 or 0, 0) }, 0.25, Enum.EasingStyle.Quint)
            tween(tab.Label, { TextColor3 = color })
            tween(tab.Icon, { ImageColor3 = color, Position = UDim2.new(0.5, -11, 0, 15) })
        end
    end

