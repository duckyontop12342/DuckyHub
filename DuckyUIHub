        -- line graph (live): Graph:Push(n), Graph:Set({...}), Graph:Clear() -------------------
        function Tab:CreateLineGraph(o)
            local c, head = card(o, 80)
            local H = o.Height or 80
            local maxPts = math.max(2, o.MaxPoints or 40)
            local suffix = o.Suffix or ""
            local fixedMin, fixedMax = o.Min, o.Max

            local latest = text({
                Parent = head, Position = UDim2.new(1, -80, 0, 0), Size = UDim2.new(0, 80, 0, 15),
                TextXAlignment = Enum.TextXAlignment.Right, FontFace = FONT_BOLD, TextSize = 12,
                TextColor3 = Theme.Accent, Text = "-",
            })
            local plot = create("Frame", {
                Parent = c, Size = UDim2.new(1, 0, 0, H), BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
                ClipsDescendants = true, LayoutOrder = 1,
            }, { corner(5) })
            for i = 1, 3 do
                create("Frame", {
                    Parent = plot, Position = UDim2.new(0, 0, i / 4, 0), Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Track, BorderSizePixel = 0,
                })
            end
            local topLbl = text({
                Parent = plot, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(60, 12), Text = "",
                TextSize = 9, TextColor3 = Theme.Desc, FontFace = FONT_SEMI, ZIndex = 3,
            })
            local botLbl = text({
                Parent = plot, Position = UDim2.new(0, 6, 1, -14), Size = UDim2.fromOffset(60, 12), Text = "",
                TextSize = 9, TextColor3 = Theme.Desc, FontFace = FONT_SEMI, ZIndex = 3,
            })
            local dot = create("Frame", {
                Parent = plot, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7),
                BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Visible = false, ZIndex = 3,
            }, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })

            local segs, values = {}, {}
            local Graph = { Type = "LineGraph" }
            local function fmt(n) return tostring(math.floor(n * 10 + 0.5) / 10) end

            local function render()
                local n = #values
                local sx = plot.AbsoluteSize.X / scale.Scale
                local sy = plot.AbsoluteSize.Y / scale.Scale
                if n == 0 or sx <= 0 then
                    for _, s in ipairs(segs) do s.Visible = false end
                    dot.Visible = false
                    return
                end
                local lo, hi = fixedMin, fixedMax
                if not lo or not hi then
                    local mn, mx = math.huge, -math.huge
                    for _, v in ipairs(values) do mn = math.min(mn, v); mx = math.max(mx, v) end
                    if mx - mn < 1e-6 then mx = mx + 1; mn = mn - 1 end
                    local pad = (mx - mn) * 0.1
                    lo = lo or (mn - pad)
                    hi = hi or (mx + pad)
                end
                if hi <= lo then hi = lo + 1 end
                topLbl.Text = fmt(hi) .. suffix
                botLbl.Text = fmt(lo) .. suffix

                local step = sx / (maxPts - 1)
                local pts = {}
                for i, v in ipairs(values) do
                    pts[i] = Vector2.new(sx - (n - i) * step, 6 + (1 - math.clamp((v - lo) / (hi - lo), 0, 1)) * (sy - 12))
                end
                for i = 1, n - 1 do
                    local a, b = pts[i], pts[i + 1]
                    local seg = segs[i]
                    if not seg then
                        seg = create("Frame", {
                            Parent = plot, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Accent,
                            BorderSizePixel = 0, ZIndex = 2,
                        })
                        segs[i] = seg
                    end
                    local d = b - a
                    seg.Visible = true
                    seg.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                    seg.Size = UDim2.fromOffset(d.Magnitude + 1.5, 2)
                    seg.Rotation = math.deg(math.atan2(d.Y, d.X))
                end
                for i = n, #segs do segs[i].Visible = false end
                dot.Position = UDim2.fromOffset(pts[n].X, pts[n].Y)
                dot.Visible = true
                latest.Text = fmt(values[n]) .. suffix
            end
            plot:GetPropertyChangedSignal("AbsoluteSize"):Connect(render)

            function Graph:Push(v)
                table.insert(values, tonumber(v) or 0)
                while #values > maxPts do table.remove(values, 1) end
                render()
            end
            function Graph:Set(list)
                values = {}
                for _, v in ipairs(list or {}) do table.insert(values, tonumber(v) or 0) end
                while #values > maxPts do table.remove(values, 1) end
                render()
            end
            function Graph:Clear() values = {}; latest.Text = "-"; render() end
            function Graph:Get() return values end

            if o.Values then Graph:Set(o.Values) end
            return Graph
        end

        -- bar graph: Data = { { Name = "A", Value = 3 }, ... }   Graph:Set(data) -------------
        function Tab:CreateBarGraph(o)
            local c = card(o, 0)
            local H = o.Height or 100
            local area = create("Frame", {
                Parent = c, Size = UDim2.new(1, 0, 0, H), BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
                ClipsDescendants = true, LayoutOrder = 1,
            }, { corner(5) })
            local items = {}
            local Graph = { Type = "BarGraph" }

            function Graph:Set(data)
                for _, f in ipairs(items) do f:Destroy() end
                items = {}
                data = data or {}
                local n = #data
                if n == 0 then return end
                local mx = o.Max or 0
                if not o.Max then
                    for _, d in ipairs(data) do mx = math.max(mx, d.Value or d[2] or 0) end
                end
                if mx <= 0 then mx = 1 end
                local avail = H - 44
                for i, d in ipairs(data) do
                    local name, value = tostring(d.Name or d[1] or ""), d.Value or d[2] or 0
                    local col = create("Frame", {
                        Parent = area, BackgroundTransparency = 1,
                        Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, 0, 1, 0),
                    })
                    table.insert(items, col)
                    local h = math.max(2, math.clamp(value / mx, 0, 1) * avail)
                    local bar = create("Frame", {
                        Parent = col, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18),
                        Size = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                    }, {
                        corner(3),
                        create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Accent, Theme.AccentDim) }),
                    })
                    local vlabel = text({
                        Parent = col, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20),
                        Size = UDim2.new(1, 0, 0, 12), TextXAlignment = Enum.TextXAlignment.Center,
                        Text = tostring(math.floor(value * 10 + 0.5) / 10), FontFace = FONT_BOLD, TextSize = 10,
                    })
                    text({
                        Parent = col, Position = UDim2.new(0, 0, 1, -15), Size = UDim2.new(1, 0, 0, 12),
                        TextXAlignment = Enum.TextXAlignment.Center, Text = name, TextColor3 = Theme.Desc,
                        FontFace = FONT_SEMI, TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd,
                    })
                    tween(bar, { Size = UDim2.new(0.5, 0, 0, h) }, 0.4, Enum.EasingStyle.Quint)
                    tween(vlabel, { Position = UDim2.new(0.5, 0, 1, -20 - h) }, 0.4, Enum.EasingStyle.Quint)
                end
            end

            Graph:Set(o.Data)
            return Graph
        end

