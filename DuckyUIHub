local function hideTip() tipToken += 1; tipOwner = nil; tip.Visible = false end
function Window._tooltip(obj, str)
    obj.MouseEnter:Connect(function()
        tipToken += 1
        local token = tipToken
        tipOwner = obj
        task.delay(0.45, function()
            if token ~= tipToken or not Window.Open then return end
            tipText.Text = tostring(str)
            placeTip()
            tip.Visible = true
        end)
    end)
    obj.MouseLeave:Connect(function() if tipOwner == obj then hideTip() end end)
