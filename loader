---Real experience title; game.Name is often just "Ugc".
local function resolveGameName()
	local info = try(marketplaceService.GetProductInfo, marketplaceService, game.PlaceId)
	if type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
		return info.Name
	end
	local raw = try(function() return game.Name end)
	if type(raw) == "string" and raw ~= "" and raw:lower() ~= "ugc" then return raw end
	return "Place " .. tostring(game.PlaceId)
end

---Log nested loadstring failures for a short window so broken dependencies show up.
local function installTrace()
	if not TRACE_LOADSTRING then return end
	local env = try(getgenv)
	if type(env) ~= "table" or type(env.loadstring) ~= "function" then return end

	local original = env.loadstring
	local function traced(source, chunk)
		local compiled, err = original(source, chunk)
		if compiled == nil then
			local head = (tostring(source):sub(1, 80):gsub("%s+", " "))
			warn(string.format("[DuckyHub] nested loadstring failed: %s | head: %s", tostring(err), head))
		end
		return compiled, err
	end
	env.loadstring = traced

	delayFn(TRACE_SECONDS, function()
		if env.loadstring == traced then env.loadstring = original end
	end)
end

