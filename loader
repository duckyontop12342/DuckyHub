local function setBars(bars, on)
	for _, bar in ipairs(bars) do
		bar.BackgroundTransparency = 1
		bar.Visible = on
		if on then tween(bar, EASE, { BackgroundTransparency = 0 }) end
	end
end

local function paintRow(index, state, detail)
	local row = rows[index]
	if not row or not ui.fill then return end

	local ringColor = ({
		idle = THEME.ring, active = THEME.text, done = THEME.ok, error = THEME.bad,
	})[state]
	local titleColor = ({
		idle = THEME.dim, active = THEME.text, done = THEME.sub, error = THEME.bad,
	})[state]

	tween(row.title, FAST, { TextColor3 = titleColor })
	if detail ~= nil then
		row.detail.Text = detail
		row.detail.TextColor3 = (state == "error") and THEME.bad or THEME.dim
	end

	tween(row.ringStroke, FAST, { Color = ringColor })
	if state == "active" then
		row.ringGradient.Transparency = ARC
		spinner = row.ringGradient
	else
		row.ringGradient.Transparency = SOLID
		row.ringGradient.Rotation = 0
		if spinner == row.ringGradient then spinner = nil end
	end

	local filled = state == "done" or state == "error"
	local changed = row.state ~= state
	row.fillCircle.BackgroundColor3 = (state == "error") and THEME.bad or THEME.ok
	if filled and changed then
		row.fillCircle.Size = UDim2.fromOffset(6, 6)
		tween(row.fillCircle, EASE, { Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 0 })
	elseif not filled then
		tween(row.fillCircle, FAST, { BackgroundTransparency = 1 })
	end
	if changed then
		setBars(row.checkBars, state == "done")
		setBars(row.crossBars, state == "error")
	end

	tween(row.bg, EASE, { BackgroundTransparency = (state == "active") and 0.45 or 1 })
	row.state = state

	stepsDone, activeStep, errored = 0, nil, false
	for i, r in ipairs(rows) do
		if r.state == "done" then
			stepsDone = stepsDone + 1
		elseif r.state == "active" then
			activeStep = i
		elseif r.state == "error" then
			errored = true
		end
	end
	if state == "active" and changed then activeSince = os.clock() end

	tween(ui.fill, EASE, {
		BackgroundColor3 = errored and THEME.bad
			or (stepsDone >= #STEPS and THEME.ok or THEME.fill),
	})
end

local function buildClose(parent)
