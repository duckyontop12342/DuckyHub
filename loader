---Update the status line, dot colour and progress bar.
---@param text string
---@param color Color3
---@param progress number
local function setStatus(text, color, progress)
	if not ui.gui then return end
	ui.status.Text = text
	tween(ui.dot, FAST, { BackgroundColor3 = color })
	tween(ui.fill, EASE, { Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1) })
end

-- Core.

---Compile and run a fetched script body.
---@return boolean, string?
local function execute(body)
	local fn, compileError = loadstring(body)
	if type(fn) ~= "function" then
		return false, "Compile error: " .. tostring(compileError)
	end

	try(function() if getgenv and getgenv().MONOUI_CLEANUP then getgenv().MONOUI_CLEANUP() end end)

	spawnFn(function()
		local ok, runtimeError = xpcall(fn, debug.traceback)
		if not ok then
			warn("[DuckyHub] " .. tostring(runtimeError))
			setStatus("Runtime error (see console)", THEME.bad, 1)
		end
	end)
	return true
end

---Fetch and run the script for this place.
---@param manual boolean?
function Loader.load(manual)
	if busy or not running then return end
	if not entry then
		setStatus("Game not supported", THEME.bad, 1)
		return
	end

	busy = true
	setStatus("Fetching script...", THEME.sub, 0.35)
	local body, fetchError = fetch(entry.urlRaw)
	if not body then
		busy = false
		setStatus("Fetch failed: " .. tostring(fetchError), THEME.bad, 0.35)
		return
	end

	setStatus("Compiling...", THEME.sub, 0.7)
	local ok, executeError = execute(body)
	busy = false
	if not ok then
		setStatus(executeError, THEME.bad, 0.7)
		return
	end

	lastHash = fingerprint(body)
	pendingBody = nil
	ui.version.Text = entry.name .. "  " .. lastHash:sub(-6)
	setStatus(manual and "Reloaded" or "Loaded", THEME.ok, 1)
end

---Poll for script updates with exponential backoff on failures.
local function pollLoop()
	local failures = 0
	while running do
		local delay = math.min(POLL_INTERVAL * (2 ^ failures), MAX_BACKOFF)
		waitFn(delay)
		if not running then break end
		if not entry or busy or not lastHash then continue end

		local body = fetch(entry.urlRaw)
		if not body then
			failures = failures + 1
			continue
		end
		failures = 0

		local hash = fingerprint(body)
		if hash ~= lastHash and not pendingBody then
			pendingBody = body
			ui.reload.Text = "Update"
			setStatus("Update available - press Update", THEME.ok, 1)
		end
	end
end

---Tear everything down.
function Loader.stop()
	running = false
	for _, connection in ipairs(connections) do try(connection.Disconnect, connection) end
	table.clear(connections)
	if ui.gui then try(ui.gui.Destroy, ui.gui) end
	ui = {}
	if shared.Loader == Loader then shared.Loader = nil end
end

---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	Loader.stop()
end

xpcall(function()
	buildUi()
	spawnFn(Loader.load)
	spawnFn(pollLoop)
end, onInitializeError)
