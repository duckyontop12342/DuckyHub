---Show or hide a set of mark bars with a quick fade.
local function setBars(bars, on)
	for _, bar in ipairs(bars) do
		bar.BackgroundTransparency = 1
		bar.Visible = on
		if on then tween(bar, EASE, { BackgroundTransparency = 0 }) end
	end
end

---Paint a step row for a given state and refresh progress bookkeeping.
local function paintRow(index, state, detail)
	local row = rows[index]
	if not row or not ui.fill then return end

	local ringColor = ({
		idle = THEME.ring, active = THEME.text, done = THEME.ok, error = THEME.bad,
	})[state]
	local titleColor = ({
		idle = THEME.dim, active = THEME.text, done = THEME.sub, error = THEME.bad,
	})[state]

	tween(row.title, FAST, { TextColor3 = titleColor })
	if detail ~= nil then
		row.detail.Text = detail
		row.detail.TextColor3 = (state == "error") and THEME.bad or THEME.dim
	end

	tween(row.ringStroke, FAST, { Color = ringColor })
	if state == "active" then
		row.ringGradient.Transparency = ARC
		spinner = row.ringGradient
	else
		row.ringGradient.Transparency = SOLID
		row.ringGradient.Rotation = 0
		if spinner == row.ringGradient then spinner = nil end
	end

	local filled = state == "done" or state == "error"
	local changed = row.state ~= state
	row.fillCircle.BackgroundColor3 = (state == "error") and THEME.bad or THEME.ok
	if filled and changed then
		row.fillCircle.Size = UDim2.fromOffset(6, 6)
		tween(row.fillCircle, EASE, { Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 0 })
	elseif not filled then
		tween(row.fillCircle, FAST, { BackgroundTransparency = 1 })
	end
	if changed then
		setBars(row.checkBars, state == "done")
		setBars(row.crossBars, state == "error")
	end

	tween(row.bg, EASE, { BackgroundTransparency = (state == "active") and 0.45 or 1 })
	row.state = state

	stepsDone, activeStep, errored = 0, nil, false
	for i, r in ipairs(rows) do
		if r.state == "done" then
			stepsDone = stepsDone + 1
		elseif r.state == "active" then
			activeStep = i
		elseif r.state == "error" then
			errored = true
		end
	end
	if state == "active" and changed then activeSince = os.clock() end

	tween(ui.fill, EASE, {
		BackgroundColor3 = errored and THEME.bad
			or (stepsDone >= #STEPS and THEME.ok or THEME.fill),
	})
end

---Fade the window back in.
local function showUi()
	if not ui.gui then return end
	visibilityToken = visibilityToken + 1
	ui.gui.Enabled = true
	tween(ui.root, SLOW, { GroupTransparency = 0 })
	tween(ui.rootScale, SLOW, { Scale = 1 })
end

---Fade the window out while the loader keeps polling in the background.
local function hideUi()
	if not ui.gui then return end
	visibilityToken = visibilityToken + 1
	local token, gui = visibilityToken, ui.gui
	tween(ui.root, SLOW, { GroupTransparency = 1 })
	tween(ui.rootScale, SLOW, { Scale = 0.97 })
	delayFn(0.45, function()
		if token == visibilityToken and gui.Parent then gui.Enabled = false end
	end)
end

---Block until the user confirms or declines running the detected game.
---@param gameName string
---@return boolean
local function askToRun(gameName)
	if not ui.prompt then return false end
	promptAnswer = nil
	ui.promptTitle.Text = string.format("Run %s?", gameName)
	ui.promptBody.Text = string.format("You're in %s. Do you want to run its script?", gameName)
	ui.prompt.Visible = true

	while running and promptAnswer == nil do
		waitFn()
	end

	if ui.prompt then ui.prompt.Visible = false end
	return running and promptAnswer == true
end

---Build the close button with a Lucide icon and a drawn fallback.
local function buildClose(parent)
	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 16),
		Size = UDim2.fromOffset(32, 32), BackgroundColor3 = THEME.bad,
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	}, parent)
	round(button, 9)

	local glyph = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
	}, button)

	local image = new("ImageLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageColor3 = THEME.dim,
	}, glyph)

	local bars = {}
	if not setIcon(image, "x") then
		image:Destroy()
		image = nil
		for _, angle in ipairs({ 45, -45 }) do
			local bar = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(16, 2), Rotation = angle,
				BackgroundColor3 = THEME.dim, BorderSizePixel = 0,
			}, glyph)
			round(bar, 1)
			table.insert(bars, bar)
		end
	end

	local function tint(color)
		if image then
			tween(image, FAST, { ImageColor3 = color })
		else
			for _, bar in ipairs(bars) do tween(bar, FAST, { BackgroundColor3 = color }) end
		end
	end

	table.insert(connections, button.MouseEnter:Connect(function()
		tint(THEME.bad)
		tween(button, FAST, { BackgroundTransparency = 0.86 })
	end))
	table.insert(connections, button.MouseLeave:Connect(function()
		tint(THEME.dim)
		tween(button, FAST, { BackgroundTransparency = 1 })
	end))
	table.insert(connections, button.MouseButton1Click:Connect(function() Loader.stop(true) end))
	return button
end

