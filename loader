	and (type(getcustomasset) == "function")

local Lucide = nil
if lucideSupported then
	Lucide = try(function()
		local src = game:HttpGet(lucideUrl)
		local fn = loadstring(src)
		if type(fn) ~= "function" then return nil end
		return fn()
	end)
end

local function setIcon(imageLabel, name)
	if not Lucide or type(Lucide.GetAsset) ~= "function" then return false end
	local asset = try(Lucide.GetAsset, name)
	if not asset then return false end
	imageLabel.Image = asset.Url
	imageLabel.ImageRectSize = asset.ImageRectSize
	imageLabel.ImageRectOffset = asset.ImageRectOffset
	return true
end

