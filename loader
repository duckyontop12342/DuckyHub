local function try(fn, ...)
	local ok, result = pcall(fn, ...)
	if ok then return result end
	return nil
end

local function defrag(parts)
	for i = 1, #parts do
		parts[i] = parts[i]:reverse()
	end
	return table.concat(parts)
end

