if not shared then return warn("No shared, no script.") end
if shared.Loader then pcall(shared.Loader.stop) end

local Loader = {}
shared.Loader = Loader

local httpService = game:GetService("HttpService")
local tweenService = game:GetService("TweenService")
local placeId = game.PlaceId
local poll_interval = 15
local maxBackoff = 120

local SAFE_MODE = true

local accent1 = Color3.fromRGB(255, 70, 160)
local accent2 = Color3.fromRGB(150, 70, 255)
local bg = Color3.fromRGB(20, 20, 24)
local bg2 = Color3.fromRGB(28, 28, 34)
local fg = Color3.fromRGB(235, 235, 240)
local muted = Color3.fromRGB(160, 160, 170)

local function try(fn, ...)
	if type(fn) ~= "function" then return nil end
	local ok, result = pcall(fn, ...)
	if ok then return result end
	return nil
end

local spawnFn = (type(task) == "table" and task.spawn) or spawn
local waitFn = (type(task) == "table" and task.wait) or wait
local delayFn = (type(task) == "table" and task.delay) or delay
local cancelFn = (type(task) == "table" and task.cancel) or nil

local REGISTRY = {
	[6403373529] = {
		name = "Bedwars",
		urlRaw = "https://cdn.luaprotect.dev/p/8f7961/7243ae30-62c0-4542-80c4-5078509c2261",
	},
	[18668065416] = {
		name = "FUT",
		urlRaw = "https://raw.githubusercontent.com/LUASCRIPTSBYME/Ducky.FUT/refs/heads/main/Ducky.FUTNew",
	},
	[70539431141054] = {
		name = "RFL",
		urlRaw = "https://raw.githubusercontent.com/LUASCRIPTSBYME/Ducky.lol.rfl/refs/heads/main/Duckyrflw",
	},
}

local lucideUrl = "https://raw.githubusercontent.com/mstudio45/lucide-roblox-direct/refs/heads/main/source.lua"
local lucideSupported = (type(writefile) == "function")
	and (type(isfolder) == "function")
	and (type(makefolder) == "function")
	and (type(getcustomasset) == "function")

local Lucide = nil
if lucideSupported and not SAFE_MODE then
	Lucide = try(function()
		local src = game:HttpGet(lucideUrl)
		local fn = loadstring(src)
		if type(fn) ~= "function" then return nil end
		return fn()
	end)
end

local function setIcon(imageLabel, name)
	if not Lucide or type(Lucide.GetAsset) ~= "function" then return false end
	local asset = try(Lucide.GetAsset, name)
	if not asset then return false end
	imageLabel.Image = asset.Url
	imageLabel.ImageRectSize = asset.ImageRectSize
	imageLabel.ImageRectOffset = asset.ImageRectOffset
	return true
end

local entry = REGISTRY[placeId]
local gameName = (try(function() return game.Name end) or "") ~= "" and game.Name or ("Place " .. tostring(placeId))

local ui = {}

local function round(inst, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
	return corner
end

local function tween(inst, info, props)
	local t = try(tweenService.Create, tweenService, inst, info, props)
	if t then try(t.Play, t) end
	return t
end

local function safeParent()
	local hui = try(function() return gethui and gethui() end)
	if hui then return hui end
	local coreGui = try(function() return game:GetService("CoreGui") end)
	if coreGui then return coreGui end
	local player = try(function() return game:GetService("Players").LocalPlayer end)
	if player then return try(function() return player:WaitForChild("PlayerGui") end) end
	return nil
end

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "LoaderUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	try(function() gui.DisplayOrder = 999 end)
	gui.Parent = safeParent()

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, 20)
	frame.Size = UDim2.new(0, 360, 0, 118)
	frame.BackgroundColor3 = bg
	frame.BorderSizePixel = 0
	frame.Parent = gui
	round(frame, 14)

	local gradientFrame = Instance.new("UIGradient")
	gradientFrame.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, bg2),
		ColorSequenceKeypoint.new(1, bg),
	})
	gradientFrame.Rotation = 90
	gradientFrame.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.3
	stroke.Transparency = 0.15
	stroke.Parent = frame

	local strokeGradient = Instance.new("UIGradient")
	strokeGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, accent1),
		ColorSequenceKeypoint.new(1, accent2),
	})
	strokeGradient.Parent = stroke

	local accentBar = Instance.new("Frame")
	accentBar.BackgroundColor3 = accent1
	accentBar.BorderSizePixel = 0
	accentBar.Position = UDim2.new(0, 0, 0, 0)
	accentBar.Size = UDim2.new(1, 0, 0, 3)
	accentBar.Parent = frame
	round(accentBar, 14)

	local accentBarGradient = Instance.new("UIGradient")
	accentBarGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, accent1),
		ColorSequenceKeypoint.new(1, accent2),
	})
	accentBarGradient.Parent = accentBar

	local titleRow = Instance.new("Frame")
	titleRow.BackgroundTransparency = 1
	titleRow.Position = UDim2.new(0, 16, 0, 14)
	titleRow.Size = UDim2.new(1, -32, 0, 18)
	titleRow.Parent = frame

	local icon = Instance.new("ImageLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(0, 16, 0, 16)
	icon.Position = UDim2.new(0, 0, 0.5, 0)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.ImageColor3 = accent1
	icon.Parent = titleRow
	if not setIcon(icon, "zap") then
		icon.Size = UDim2.new(0, 8, 0, 8)
		icon.BackgroundTransparency = 0
		icon.BackgroundColor3 = accent1
		icon.BorderSizePixel = 0
		round(icon, 4)
	end

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 22, 0, 0)
	title.Size = UDim2.new(1, -22, 1, 0)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = fg
	title.Text = "LOADER"
	title.Parent = titleRow

	local message = Instance.new("TextLabel")
	message.BackgroundTransparency = 1
	message.Position = UDim2.new(0, 16, 0, 38)
	message.Size = UDim2.new(1, -32, 0, 42)
	message.Font = Enum.Font.Gotham
	message.TextSize = 13
	message.TextWrapped = true
	message.TextXAlignment = Enum.TextXAlignment.Left
	message.TextYAlignment = Enum.TextYAlignment.Top
	message.TextColor3 = muted
	message.Text = "Loading..."
	message.Parent = frame

	local buttonRow = Instance.new("Frame")
	buttonRow.BackgroundTransparency = 1
	buttonRow.Position = UDim2.new(0, 16, 1, -42)
	buttonRow.Size = UDim2.new(1, -32, 0, 28)
	buttonRow.Visible = false
	buttonRow.Parent = frame

	local function makeButton(text, pos, filled, iconName)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.5, -5, 1, 0)
		btn.Position = pos
		btn.AutoButtonColor = false
		btn.BackgroundColor3 = filled and accent1 or bg2
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 13
		btn.TextColor3 = filled and Color3.new(1, 1, 1) or fg
		btn.Text = "   " .. text
		btn.Parent = buttonRow
		round(btn, 8)

		local btnIcon = Instance.new("ImageLabel")
		btnIcon.BackgroundTransparency = 1
		btnIcon.Size = UDim2.new(0, 14, 0, 14)
		btnIcon.AnchorPoint = Vector2.new(0, 0.5)
		btnIcon.Position = UDim2.new(0, 10, 0.5, 0)
		btnIcon.ImageColor3 = filled and Color3.new(1, 1, 1) or fg
		btnIcon.ZIndex = 2
		btnIcon.Parent = btn
		if not setIcon(btnIcon, iconName) then
			btnIcon:Destroy()
			btn.Text = text
		end

		if filled then
			local grad = Instance.new("UIGradient")
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, accent1),
				ColorSequenceKeypoint.new(1, accent2),
			})
			grad.Parent = btn
		else
			local s = Instance.new("UIStroke")
			s.Color = muted
			s.Transparency = 0.6
			s.Parent = btn
		end

		try(function()
			btn.MouseEnter:Connect(function()
				tween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.15 })
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0 })
			end)
		end)

		return btn
	end

	local confirmBtn = makeButton("Run", UDim2.new(0, 0, 0, 0), true, "check")
	local cancelBtn = makeButton("Cancel", UDim2.new(0.5, 5, 0, 0), false, "x")

	tween(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 1, -40),
	})

	ui.gui = gui
	ui.frame = frame
	ui.title = title
	ui.message = message
	ui.buttonRow = buttonRow
	ui.confirmBtn = confirmBtn
	ui.cancelBtn = cancelBtn
end

local function setMessage(text)
	if ui.message then ui.message.Text = text end
end

local function hideButtons()
	if ui.buttonRow then ui.buttonRow.Visible = false end
end

local function destroyUI()
	if ui.frame then
		local t = tween(ui.frame, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 1, 20) })
		if t then
			try(function()
				t.Completed:Connect(function()
					if ui.gui then try(ui.gui.Destroy, ui.gui) end
				end)
			end)
		else
			if ui.gui then try(ui.gui.Destroy, ui.gui) end
		end
	elseif ui.gui then
		try(ui.gui.Destroy, ui.gui)
	end
end

local function askConfirm(name)
	if not ui.buttonRow then return true end
	setMessage("Do you want to run " .. name .. "?")
	ui.buttonRow.Visible = true

	local response = nil
	local connA = ui.confirmBtn.MouseButton1Click:Connect(function() response = true end)
	local connB = ui.cancelBtn.MouseButton1Click:Connect(function() response = false end)

	while response == nil do waitFn(0.1) end

	connA:Disconnect()
	connB:Disconnect()
	hideButtons()

	return response
end

local function showUnsupported(name)
	setMessage("Sorry, we do not support " .. name .. " but you can suggest it.")
end

local state = {
	thread = nil,
	hash = nil,
	etag = nil,
	backoff = poll_interval,
	stopped = false,
	env = nil,
}

local function sandbox()
	local base = (type(getrenv) == "function" and try(getrenv)) or _G
	local fake = setmetatable({}, { __index = base, __newindex = base })
	fake.getgenv = getgenv
	fake.game = (type(cloneref) == "function" and try(cloneref, game)) or game
	return fake
end

local function integrity(src)
	local h = (type(crypt) == "table" and type(crypt.hash) == "function") and try(crypt.hash, src, "sha256") or nil
	return h or httpService:GenerateGUID(false)
end

local function fetch()
	if type(request) ~= "function" and type(http_request) ~= "function" then
		return try(game.HttpGet, game, entry.urlRaw), true
	end

	local reqFn = request or http_request
	local headers = { ["X-Place-Id"] = tostring(placeId) }
	if state.etag then headers["If-None-Match"] = state.etag end

	local res = try(reqFn, {
		Url = entry.urlRaw,
		Method = "GET",
		Headers = headers,
	})

	if not res then
		return try(game.HttpGet, game, entry.urlRaw), true
	end
	if res.StatusCode == 304 then return nil, true end
	if res.StatusCode ~= 200 then return nil, false end

	if res.Headers then
		for k, v in pairs(res.Headers) do
			if string.lower(k) == "etag" then state.etag = v end
		end
	end

	return res.Body, true
end

local function execute(src)
	local id = (type(getthreadidentity) == "function") and try(getthreadidentity) or nil
	if type(setthreadidentity) == "function" then try(setthreadidentity, 2) end

	local fn, err = loadstring(src, "=loader")
	if type(fn) ~= "function" then
		if id and type(setthreadidentity) == "function" then try(setthreadidentity, id) end
		return warn("compile fail: " .. tostring(err))
	end

	if not state.env then state.env = sandbox() end
	if type(setfenv) == "function" then try(setfenv, fn, state.env) end

	if state.thread and cancelFn then try(cancelFn, state.thread) end
	local wrapped = (type(newcclosure) == "function" and try(newcclosure, fn)) or fn
	state.thread = spawnFn(wrapped)

	if id and type(setthreadidentity) == "function" then try(setthreadidentity, id) end
end

local function cycle()
	local src, ok = fetch()
	if not ok then
		state.backoff = math.min(state.backoff * 2, maxBackoff)
		return false
	end
	state.backoff = poll_interval
	if not src or src == "" then return false end

	local h = integrity(src)
	if h == state.hash then return false end

	execute(src)
	state.hash = h
	return true
end

function Loader.stop()
	state.stopped = true
	if state.thread and cancelFn then try(cancelFn, state.thread) end
	if ui.gui then try(ui.gui.Destroy, ui.gui) end
end

local function run()
	if not entry then
		build()
		setMessage("Loading...")
		waitFn(0.5)
		showUnsupported(gameName)
		return
	end

	build()
	setMessage("Loading...")
	waitFn(0.5)

	if not askConfirm(entry.name) then
		setMessage("Cancelled.")
		delayFn(1.5, destroyUI)
		return
	end

	setMessage("Loading " .. entry.name .. "...")

	if not cycle() then
		if not state.hash then
			setMessage("Failed to load " .. entry.name .. ".")
			return
		end
	end

	setMessage(entry.name .. " loaded.")
	delayFn(2.5, destroyUI)

	spawnFn(function()
		while not state.stopped do
			waitFn(state.backoff)
			try(cycle)
		end
	end)
end

function Loader.start()
	local ok, err = pcall(run)
	if not ok then
		warn("[Loader] fatal: " .. tostring(err))
		try(setMessage, "Error: " .. tostring(err))
	end
end

try(function()
	local scriptContext = game:GetService("ScriptContext")
	scriptContext.Error:Connect(function(message, trace, scriptInstance)
		warn("[LoaderDiag] " .. tostring(message))
		warn("[LoaderDiag] script: " .. tostring(scriptInstance and scriptInstance.Name or "?"))
		warn("[LoaderDiag] trace: " .. tostring(trace))
	end)
end)

Loader.start()
return Loader
