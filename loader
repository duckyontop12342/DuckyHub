---Run fn protected, returning its result or nil.
local function try(fn, ...)
	if type(fn) ~= "function" then return nil end
	local ok, result = pcall(fn, ...)
	if ok then return result end
	return nil
end

local gameName = try(function() return game.Name end)
if type(gameName) ~= "string" or gameName == "" then
	gameName = "Place " .. tostring(placeId)
end

local Lucide = nil
if type(writefile) == "function" and type(isfolder) == "function"
	and type(makefolder) == "function" and type(getcustomasset) == "function" then
	Lucide = try(function()
		local fn = loadstring(game:HttpGet(LUCIDE_URL))
		return type(fn) == "function" and fn() or nil
	end)
end

---Apply a Lucide icon to an ImageLabel/ImageButton.
---@return boolean
local function setIcon(image, name)
	if not Lucide or type(Lucide.GetAsset) ~= "function" then return false end
	local asset = try(Lucide.GetAsset, name)
	if not asset then return false end
	image.Image = asset.Url
	image.ImageRectSize = asset.ImageRectSize
	image.ImageRectOffset = asset.ImageRectOffset
	return true
end

---Create an instance with props and an optional parent.
local function new(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props or {}) do inst[key] = value end
	if parent then inst.Parent = parent end
	return inst
end

local function round(inst, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function outline(inst, transparency)
	return new("UIStroke", {
		Color = THEME.stroke, Thickness = 1, Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function tween(inst, info, props)
	local t = try(tweenService.Create, tweenService, inst, info, props)
	if t then try(t.Play, t) end
	return t
end

local function label(props, parent)
	local base = {
		BackgroundTransparency = 1, Font = Enum.Font.BuilderSans, TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left, TextSize = 15,
	}
	for key, value in pairs(props) do base[key] = value end
	return new("TextLabel", base, parent)
end

---Pick the safest GUI container the executor offers.
local function safeParent()
	local hui = try(function() return gethui and gethui() end)
	if typeof(hui) == "Instance" then return hui end
	local coreGui = try(function() return game:GetService("CoreGui") end)
	if coreGui then return coreGui end
	local localPlayer = game:GetService("Players").LocalPlayer
	return localPlayer and localPlayer:WaitForChild("PlayerGui")
end

---Cheap content fingerprint for update detection.
local function fingerprint(body)
	local sum = #body
	for i = 1, #body, 97 do
		sum = (sum * 31 + body:byte(i)) % 4294967291
	end
	return string.format("%x-%x", #body, sum)
end

---Fetch a URL bypassing CDN caches where possible.
---@return string?, string?
local function fetch(url)
	local target = url
	if url:find("raw.githubusercontent.com", 1, true) then
		target = url .. "?cb=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
	end

	if type(request) == "function" then
		local ok, res = pcall(request, {
			Url = target, Method = "GET",
			Headers = { ["Cache-Control"] = "no-cache", ["Pragma"] = "no-cache" },
		})
		if ok and type(res) == "table" then
			if res.StatusCode == 200 and type(res.Body) == "string" and #res.Body > 0 then
				return res.Body
			end
			return nil, "HTTP " .. tostring(res.StatusCode)
		end
	end

	local ok, body = pcall(game.HttpGet, game, target, true)
	if ok and type(body) == "string" and #body > 0 then return body end
	return nil, tostring(body)
end

