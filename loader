		reloadGradient.Color = ColorSequence.new(Color3.fromRGB(78, 78, 82), Color3.fromRGB(58, 58, 62))
	end))
	table.insert(connections, reload.MouseButton1Click:Connect(function()
		spawnFn(Loader.load, true)
	end))

	local idsText = string.format("Place %s  |  Game %s", tostring(game.PlaceId), tostring(game.GameId))
	local ids = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 220),
		Size = UDim2.fromOffset(250, 30), BackgroundTransparency = 1, AutoButtonColor = false,
		Text = idsText, Font = Enum.Font.BuilderSans, TextSize = 12, TextColor3 = THEME.dim,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, root)
	table.insert(connections, ids.MouseEnter:Connect(function() tween(ids, FAST, { TextColor3 = THEME.sub }) end))
	table.insert(connections, ids.MouseLeave:Connect(function() tween(ids, FAST, { TextColor3 = THEME.dim }) end))
	table.insert(connections, ids.MouseButton1Click:Connect(function()
		if type(setclipboard) ~= "function" then return end
		pcall(setclipboard, idsText)
		ids.Text = "Copied"
		spawnFn(function()
			waitFn(1.2)
			if ids.Parent then ids.Text = idsText end
		end)
	end))

	-- Drag.
	local dragging, dragStart, startPos
	table.insert(connections, header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, root.Position
		end
	end))
	table.insert(connections, userInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			startPos.X.Scale, math.floor(startPos.X.Offset + delta.X + 0.5),
			startPos.Y.Scale, math.floor(startPos.Y.Offset + delta.Y + 0.5))
	end))
	table.insert(connections, userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- Ambient motion.
	local clock = 0
	table.insert(connections, runService.Heartbeat:Connect(function(dt)
		clock = clock + dt
		borderGradient.Rotation = (clock * 30) % 360
		shimmerGradient.Offset = Vector2.new((clock * 0.8) % 2 - 1, 0)
		if spinner and spinner.Parent then spinner.Rotation = (spinner.Rotation + 420 * dt) % 360 end

		local target = stepsDone / #STEPS
		if activeStep then
			local elapsed = os.clock() - activeSince
			target = (stepsDone + 0.85 * (1 - math.exp(-1.6 * elapsed))) / #STEPS
		elseif errored then
			target = (stepsDone + 0.5) / #STEPS
		end
		progressShown = progressShown + (target - progressShown) * (1 - math.exp(-12 * dt))
		if ui.fill then ui.fill.Size = UDim2.fromScale(math.clamp(progressShown, 0, 1), 1) end
	end))

	-- In-place confirmation panel.
	local confirming = false
	local confirmYes, confirmNo = nil, nil

	local confirmCard = new("CanvasGroup", {
		Position = UDim2.fromOffset(16, 70), Size = UDim2.new(1, -32, 0, 124),
		BackgroundColor3 = THEME.inset, BorderSizePixel = 0,
		GroupTransparency = 1, Visible = false,
	}, root)
	round(confirmCard, 10)
	outline(confirmCard, 0.7)

	local confirmGlow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, confirmCard)
	gradient(confirmGlow, { Rotation = 90, Transparency = NumberSequence.new(0.955, 1) })

	label({
		Text = "Would you like to run this?",
		Font = Enum.Font.BuilderSansBold, TextSize = 15, TextColor3 = THEME.text,
		Position = UDim2.fromOffset(16, 16), Size = UDim2.new(1, -32, 0, 20),
	}, confirmCard)

	local confirmSub = label({
		Text = "", Font = SUBTITLE_FONT, TextSize = 13, TextColor3 = THEME.dim,
		Position = UDim2.fromOffset(16, 38), Size = UDim2.new(1, -32, 0, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, confirmCard)

	local function confirmButton(text, x, width, bgColor, fgColor, hoverColor, onClick)
		local bg = new("Frame", {
			Position = UDim2.fromOffset(x, 76), Size = UDim2.fromOffset(width, 32),
			BackgroundColor3 = bgColor, BorderSizePixel = 0,
		}, confirmCard)
		round(bg, 8)
		outline(bg, 0.5, THEME.stroke)

		local btn = new("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = text, Font = Enum.Font.BuilderSansMedium, TextSize = 14,
			TextColor3 = fgColor, AutoButtonColor = false,
		}, bg)

		table.insert(connections, btn.MouseEnter:Connect(function()
			tween(bg, FAST, { BackgroundColor3 = hoverColor })
		end))
		table.insert(connections, btn.MouseLeave:Connect(function()
			tween(bg, FAST, { BackgroundColor3 = bgColor })
		end))
		table.insert(connections, btn.MouseButton1Click:Connect(function()
			if confirming and onClick then onClick() end
		end))
		return btn
	end

	confirmButton("No, cancel", 30, 148, THEME.track, THEME.sub, THEME.hover, function()
		local cb = confirmNo
		if cb then cb() end
	end)

	confirmButton("Run script", 190, 148,
		THEME.fill, Color3.fromRGB(24, 24, 24), Color3.fromRGB(255, 255, 255), function()
			local cb = confirmYes
			if cb then cb() end
		end)

	local function showConfirm(gameName, sizeLabel, onYes, onNo)
		if confirming or not confirmCard.Parent then return end
		confirming = true
		confirmYes, confirmNo = onYes, onNo

		local sub = gameName or "Unknown game"
		if sizeLabel and sizeLabel ~= "" then sub = sub .. "  ·  " .. sizeLabel end
		confirmSub.Text = sub

		reload.Visible = false
		reloadBg.Visible = false

		tween(card, EASE, { GroupTransparency = 1 })
		confirmCard.Visible = true
		confirmCard.GroupTransparency = 1
		tween(confirmCard, EASE, { GroupTransparency = 0 })
		delayFn(0.18, function()
			if confirming then card.Visible = false end
		end)
	end

	local function hideConfirm()
		if not confirming then return end
		confirming = false
		confirmYes, confirmNo = nil, nil

		tween(confirmCard, EASE, { GroupTransparency = 1 })
		delayFn(0.18, function()
			if not confirming then confirmCard.Visible = false end
		end)

		card.Visible = true
		card.GroupTransparency = 1
		tween(card, EASE, { GroupTransparency = 0 })

		reload.Visible = true
		reloadBg.Visible = true
	end

	table.insert(connections, userInputService.InputBegan:Connect(function(input, processed)
		if processed or not confirming then return end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			local cb = confirmYes
			if cb then cb() end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			local cb = confirmNo
			if cb then cb() end
		end
	end))

	ui = {
		gui = gui, root = root, rootScale = rootScale, fill = fill, reload = reload,
		badge = badge, badgeText = badgeText, setLogo = setLogo,
		showConfirm = showConfirm, hideConfirm = hideConfirm,
	}

	for index = 1, #STEPS do paintRow(index, "idle") end

	tween(root, SLOW, { GroupTransparency = 0 })
	tween(rootScale, SLOW, { Scale = 1 })
end

-- Core.

function Loader.load(manual)
	if busy or not running or not ui.gui then return end
	busy = true
	pendingUpdate = false
	ui.reload.Text = "Reload"
	ui.reload.TextColor3 = Color3.fromRGB(255, 255, 255)
	for index = 1, #STEPS do paintRow(index, "idle", "") end

	paintRow(1, "active", "")
	waitFn(STEP_PAUSE)
	activeEntry = resolveEntry()
	if not activeEntry then
		paintRow(1, "error", "Not supported")
		busy = false
		return
	end
	paintRow(1, "done", activeEntry.name)
	waitFn(STEP_PAUSE)

	paintRow(2, "active", "")
	local body, fetchError = fetch(activeEntry.urlRaw)
	if not body then
		paintRow(2, "error", tostring(fetchError))
		busy = false
		return
	end
	paintRow(2, "done", string.format("%.1f KB", #body / 1024))
	waitFn(STEP_PAUSE)

	paintRow(3, "active", "")
	local fn, compileError = loadstring(body)
	if type(fn) ~= "function" then
		warn("[DuckyHub] " .. tostring(compileError))
		paintRow(3, "error", "Syntax error (see console)")
		busy = false
		return
	end
	waitFn(STEP_PAUSE)
	paintRow(3, "done", "")
	waitFn(STEP_PAUSE)

	local function runIt()
		if ui.hideConfirm then ui.hideConfirm() end
		waitFn(0.18)

		paintRow(4, "active", "")
		waitFn(STEP_PAUSE)

		try(function() if getgenv and getgenv().MONOUI_CLEANUP then getgenv().MONOUI_CLEANUP() end end)
		installTrace()
		spawnFn(function()
			local ok, runtimeError = xpcall(fn, debug.traceback)
			if not ok then
				warn("[DuckyHub] " .. tostring(runtimeError))
				if running and rows[4] and rows[4].state ~= "error" then
					paintRow(4, "error", "Runtime error (see console)")
				end
			end
		end)
		waitFn(0.35)

		if rows[4] and rows[4].state == "error" then
			busy = false
			return
		end

		paintRow(4, "done", manual and "Reloaded" or "Running")
		lastHash = fingerprint(body)
		if ui.badgeText then ui.badgeText.Text = lastHash:sub(-6):upper() end
		if ui.badge then ui.badge.Visible = true end

		-- Success Animation: "Pop" the window and turn progress bar green
		if ui.reload then
			ui.reload.Text = "Injected!"
			ui.reload.TextColor3 = THEME.ok
		end

		if ui.rootScale then
			tween(ui.rootScale, POP, { Scale = 1.03 })
			delayFn(0.15, function()
				tween(ui.rootScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
			end)
		end

		if ui.fill then
			tween(ui.fill, FAST, { BackgroundColor3 = THEME.ok })
		end

		waitFn(0.8)
		Loader.stop(true)
	end

	local function cancelIt()
		if ui.hideConfirm then ui.hideConfirm() end
		waitFn(0.18)
		paintRow(4, "error", "Cancelled")
		busy = false
	end

	if manual then
		runIt()
	elseif ui.showConfirm then
		ui.showConfirm(activeEntry.name, string.format("%.1f KB", #body / 1024), runIt, cancelIt)
	else
		runIt()
	end
end

local function pollLoop()
	local failures = 0
	while running do
		waitFn(math.min(POLL_INTERVAL * (2 ^ failures), MAX_BACKOFF))
		if not running then break end
		if not activeEntry or busy or not lastHash or pendingUpdate then continue end

		local body = fetch(activeEntry.urlRaw)
		if not body then
			failures = failures + 1
			continue
		end
		failures = 0

		if fingerprint(body) ~= lastHash then
			pendingUpdate = true
			ui.reload.Text = "Update"
			ui.badgeText.Text = "UPDATE"
			ui.badgeText.TextColor3 = THEME.ok
		end
	end
end

function Loader.stop(animated)
	if stopped then return end
	stopped = true
	running = false
	spinner = nil
	for _, connection in ipairs(connections) do try(connection.Disconnect, connection) end
	table.clear(connections)

	local gui, root, rootScale = ui.gui, ui.root, ui.rootScale
	ui = {}
	if shared.Loader == Loader then shared.Loader = nil end
	if not gui then return end

	if animated == true and root and root.Parent then
		tween(root, EASE, { GroupTransparency = 1 })
		if rootScale then tween(rootScale, EASE, { Scale = 0.97 }) end
		delayFn(0.3, function() try(gui.Destroy, gui) end)
	else
		try(gui.Destroy, gui)
	end
end

local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	Loader.stop()
end

xpcall(function()
	buildUi()
	spawnFn(function()
		local asset, aspect = resolveLogo()
		if asset and ui.setLogo then ui.setLogo(asset, aspect) end
	end)
	spawnFn(Loader.load)
	spawnFn(pollLoop)
end, onInitializeError)
