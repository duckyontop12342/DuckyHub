local function round(inst, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
	return corner
end

local function tween(inst, info, props)
	local t = try(tweenService.Create, tweenService, inst, info, props)
	if t then try(t.Play, t) end
	return t
end

local function safeParent()
	local hui = try(function() return gethui and gethui() end)
	if hui then return hui end
	local coreGui = try(function() return game:GetService("CoreGui") end)
	if coreGui then return coreGui end
