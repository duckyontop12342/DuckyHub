---Paint a step row for a given state and recompute progress.
local function paintRow(index, state, detail)
	local row = rows[index]
	if not row or not ui.fill then return end

	local color = ({
		idle = THEME.dim, active = THEME.text, done = THEME.ok, error = THEME.bad,
	})[state]

	row.title.TextColor3 = (state == "idle") and THEME.dim or (state == "done" and THEME.sub or color)
	if detail ~= nil then
		row.detail.Text = detail
		row.detail.TextColor3 = (state == "error") and THEME.bad or THEME.dim
	end

	local hasIcon = setIcon(row.image, STEP_ICON[state])
	row.image.Visible = hasIcon
	row.dot.Visible = not hasIcon
	row.image.ImageColor3 = color
	row.dot.BackgroundColor3 = color

	row.image.Rotation = 0
	if state == "active" then
		spinner = hasIcon and row.image or nil
	elseif spinner == row.image then
		spinner = nil
	end
	row.state = state

	local progress = 0
	for i, r in ipairs(rows) do
		if r.state == "done" then
			progress = progress + 1
		elseif r.state == "active" or (r.state == "error" and i == index) then
			progress = progress + 0.5
		end
	end
	tween(ui.fill, EASE, {
		Size = UDim2.fromScale(progress / #STEPS, 1),
		BackgroundColor3 = (state == "error") and THEME.bad or THEME.fill,
	})
end

