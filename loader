	}, card)

	for index, name in ipairs(STEPS) do
		local rowFrame = new("Frame", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = index,
		}, card)
		local bg = new("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = THEME.hover,
			BackgroundTransparency = 1, BorderSizePixel = 0,
		}, rowFrame)
		round(bg, 7)
		gradient(bg, { Transparency = NumberSequence.new(0, 1) })

		local holder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 18, 0.5, 0),
			Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		}, rowFrame)

		local ring = new("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		}, holder)
		round(ring, 8)
		local ringStroke = new("UIStroke", {
			Color = THEME.ring, Thickness = 1.6,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, ring)
		local ringGradient = gradient(ringStroke, { Transparency = SOLID })

		local fillCircle = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16), BackgroundColor3 = THEME.ok,
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
		}, holder)
		round(fillCircle, 8)

		local checkBars = {
			mark(holder, 6, 9.5, 4, -45),
			mark(holder, 9.5, 8, 7.4, 39),
		}
		local crossBars = {
			mark(holder, 8, 8, 8, 45),
			mark(holder, 8, 8, 8, -45),
		}

		local stepTitle = label({
			Text = name, TextSize = 14, TextColor3 = THEME.dim,
			Position = UDim2.fromOffset(40, 0), Size = UDim2.new(0.4, 0, 1, 0),
		}, rowFrame)
		local detail = label({
			Text = "", TextSize = 13, TextColor3 = THEME.dim, TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0),
			Size = UDim2.new(0.55, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
		}, rowFrame)
		rows[index] = {
			bg = bg, ringStroke = ringStroke, ringGradient = ringGradient,
			fillCircle = fillCircle, checkBars = checkBars, crossBars = crossBars,
			title = stepTitle, detail = detail, state = "idle",
		}
	end

	local prompt, promptTitle, promptBody = buildPrompt(root)

	local track = new("Frame", {
		Position = UDim2.fromOffset(16, 248), Size = UDim2.new(1, -32, 0, 4),
		BackgroundColor3 = THEME.track, BorderSizePixel = 0,
	}, root)
	round(track, 2)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.fill,
		BorderSizePixel = 0, ClipsDescendants = true,
	}, track)
	round(fill, 2)
	gradient(fill, {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(185, 185, 185)),
	})
	local shimmer = new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, fill)
	local shimmerGradient = gradient(shimmer, {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})

	-- Gradient lives on a background frame so it never tints the button text.
	local reloadBg = new("Frame", {
		Position = UDim2.fromOffset(16, 262), Size = UDim2.fromOffset(92, 30),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 2,
	}, root)
	round(reloadBg, 8)
	outline(reloadBg, 0.5, Color3.fromRGB(104, 104, 108))
	local reloadGradient = gradient(reloadBg, {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(78, 78, 82), Color3.fromRGB(58, 58, 62)),
	})

	local reload = new("TextButton", {
		Position = UDim2.fromOffset(16, 262), Size = UDim2.fromOffset(92, 30),
		BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
		Text = "Reload", Font = Enum.Font.BuilderSansMedium, TextSize = 14,
		TextColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 3,
	}, root)
	table.insert(connections, reload.MouseEnter:Connect(function()
		reloadGradient.Color = ColorSequence.new(Color3.fromRGB(96, 96, 100), Color3.fromRGB(72, 72, 76))
	end))
	table.insert(connections, reload.MouseLeave:Connect(function()
		reloadGradient.Color = ColorSequence.new(Color3.fromRGB(78, 78, 82), Color3.fromRGB(58, 58, 62))
	end))
	table.insert(connections, reload.MouseButton1Click:Connect(function()
		spawnFn(Loader.load, true)
	end))

	local idsText = string.format("Place %s  |  Game %s", tostring(game.PlaceId), tostring(game.GameId))
	local ids = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 262),
		Size = UDim2.fromOffset(250, 30), BackgroundTransparency = 1, AutoButtonColor = false,
		Text = idsText, Font = Enum.Font.BuilderSans, TextSize = 12, TextColor3 = THEME.dim,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, root)
	table.insert(connections, ids.MouseEnter:Connect(function() tween(ids, FAST, { TextColor3 = THEME.sub }) end))
	table.insert(connections, ids.MouseLeave:Connect(function() tween(ids, FAST, { TextColor3 = THEME.dim }) end))
	table.insert(connections, ids.MouseButton1Click:Connect(function()
		if type(setclipboard) ~= "function" then return end
		pcall(setclipboard, idsText)
		ids.Text = "Copied"
		spawnFn(function()
			waitFn(1.2)
			if ids.Parent then ids.Text = idsText end
		end)
	end))

	-- Drag.
	local dragging, dragStart, startPos
	table.insert(connections, header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, root.Position
		end
	end))
	table.insert(connections, userInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			startPos.X.Scale, math.floor(startPos.X.Offset + delta.X + 0.5),
			startPos.Y.Scale, math.floor(startPos.Y.Offset + delta.Y + 0.5))
	end))
	table.insert(connections, userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- Ambient motion: outline highlight, spinner arc, eased progress with creep, shimmer.
	local clock = 0
	table.insert(connections, runService.Heartbeat:Connect(function(dt)
		clock = clock + dt
		borderGradient.Rotation = (clock * 40) % 360
		shimmerGradient.Offset = Vector2.new((clock * 0.8) % 2 - 1, 0)
		if spinner and spinner.Parent then spinner.Rotation = (spinner.Rotation + 420 * dt) % 360 end

		local target = stepsDone / #STEPS
		if activeStep then
			local elapsed = os.clock() - activeSince
			target = (stepsDone + 0.85 * (1 - math.exp(-1.6 * elapsed))) / #STEPS
		elseif errored then
			target = (stepsDone + 0.5) / #STEPS
		end
		progressShown = progressShown + (target - progressShown) * (1 - math.exp(-12 * dt))
		if ui.fill then ui.fill.Size = UDim2.fromScale(math.clamp(progressShown, 0, 1), 1) end
	end))

	ui = {
		gui = gui, root = root, rootScale = rootScale, fill = fill, reload = reload,
		subtitle = subtitle, badge = badge, badgeText = badgeText, setLogo = setLogo,
		prompt = prompt, promptTitle = promptTitle, promptBody = promptBody,
	}

	for index = 1, #STEPS do paintRow(index, "idle") end

	showUi()
end

-- Core.

---Compare this loader's version against the one published in the repo.
---@return boolean allowed
local function checkLoaderVersion()
	paintRow(1, "active", "")
	waitFn(STEP_PAUSE)

	local source = fetch(LOADER_URL)
	if not source then
		paintRow(1, "done", "Offline, skipped")
		return true
	end

	if parseVersion(source) ~= LOADER_VERSION then
		paintRow(1, "error", "Outdated loader")
		if ui.badgeText then
			ui.badgeText.Text = "OUTDATED"
			ui.badgeText.TextColor3 = THEME.bad
		end
		return false
	end

	paintRow(1, "done", LOADER_VERSION .. " latest")
	return true
end

---Fetch and run the script for this place.
---@param manual boolean?
function Loader.load(manual)
	if busy or not running or not ui.gui then return end
	busy = true
	pendingUpdate = false
	loadToken = loadToken + 1
	local token = loadToken
	ui.reload.Text = "Reload"
	ui.badgeText.Text = LOADER_VERSION
	ui.badgeText.TextColor3 = THEME.sub
	for index = 1, #STEPS do paintRow(index, "idle", "") end

	local allowed = checkLoaderVersion()
	if not running then return end
	if not allowed then
		busy = false
		return
	end

	paintRow(2, "active", "")
	waitFn(STEP_PAUSE)
	activeEntry = resolveEntry()
	if not activeEntry then
		paintRow(2, "error", "Not supported")
		busy = false
		return
	end
	if ui.subtitle then ui.subtitle.Text = activeEntry.name end
	paintRow(2, "done", activeEntry.name)
	waitFn(STEP_PAUSE)

	if not askToRun(activeEntry.name) then
		busy = false
		Loader.stop(true)
		return
	end

	paintRow(3, "active", "")
	local body, fetchError = fetch(activeEntry.urlRaw)
	if not running then return end
	if not body then
		paintRow(3, "error", tostring(fetchError))
		busy = false
		return
	end
	paintRow(3, "done", string.format("%.1f KB", #body / 1024))
	waitFn(STEP_PAUSE)

	paintRow(4, "active", "")
	local fn, compileError = loadstring(body)
	if type(fn) ~= "function" then
		warn("[DuckyHub] " .. tostring(compileError))
		paintRow(4, "error", "Syntax error (see console)")
		busy = false
		return
	end
	waitFn(STEP_PAUSE)
	paintRow(4, "done", "")
	waitFn(STEP_PAUSE)
	if not running then return end

	paintRow(5, "active", "")
	try(function() if getgenv and getgenv().MONOUI_CLEANUP then getgenv().MONOUI_CLEANUP() end end)
	installTrace()

	local finished, failed = false, false
	spawnFn(function()
		local ok, runtimeError = xpcall(fn, debug.traceback)
		finished = true
		if ok then return end

		failed = true
		warn("[DuckyHub] " .. tostring(runtimeError))
		if token ~= loadToken then return end

		-- A late error has to bring the window back or it goes unseen.
		paintRow(5, "error", "Runtime error (see console)")
		showUi()
	end)

	-- Scripts that loop forever never return, so the grace window caps the wait.
	local startedAt = os.clock()
	repeat
		waitFn(STEP_PAUSE)
	until finished or not running or os.clock() - startedAt >= RUN_GRACE

	lastHash = fingerprint(body)

	if not failed and running then
		paintRow(5, "done", manual and "Reloaded" or "Running")
		waitFn(FADE_DELAY)
		if not failed and running then hideUi() end
	end

	busy = false
end

---Poll for script updates with exponential backoff on failures.
local function pollLoop()
	local failures = 0
	while running do
		waitFn(math.min(POLL_INTERVAL * (2 ^ failures), MAX_BACKOFF))
		if not running then break end
		if not activeEntry or busy or not lastHash or pendingUpdate then continue end

		local body = fetch(activeEntry.urlRaw)
		if not body then
			failures = failures + 1
			continue
		end
		failures = 0

		if running and not busy and fingerprint(body) ~= lastHash then
			pendingUpdate = true
			ui.reload.Text = "Update"
			ui.badgeText.Text = "UPDATE"
			ui.badgeText.TextColor3 = THEME.ok
			showUi()
		end
	end
end

---Tear everything down.
---@param animated boolean?
function Loader.stop(animated)
	if stopped then return end
	stopped = true
	running = false
	spinner = nil
	for _, connection in ipairs(connections) do try(connection.Disconnect, connection) end
	table.clear(connections)

	local gui, root, rootScale = ui.gui, ui.root, ui.rootScale
	ui = {}
	if shared.Loader == Loader then shared.Loader = nil end
	if not gui then return end

	if animated == true and root and root.Parent then
		tween(root, EASE, { GroupTransparency = 1 })
		if rootScale then tween(rootScale, EASE, { Scale = 0.97 }) end
		delayFn(0.3, function() try(gui.Destroy, gui) end)
	else
		try(gui.Destroy, gui)
	end
end

---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	Loader.stop()
end

xpcall(function()
	buildUi()
	spawnFn(function()
		local name = resolveGameName()
		if ui.subtitle and not activeEntry then ui.subtitle.Text = name end
	end)
	spawnFn(function()
		local asset, aspect = resolveLogo()
		if asset and ui.setLogo then ui.setLogo(asset, aspect) end
	end)
	spawnFn(Loader.load)
	spawnFn(pollLoop)
end, onInitializeError)
