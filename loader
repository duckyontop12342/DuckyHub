---Cheap content fingerprint for update detection.
local function fingerprint(body)
	local sum = #body
	for i = 1, #body, 97 do
		sum = (sum * 31 + body:byte(i)) % 4294967291
	end
	return string.format("%x-%x", #body, sum)
end

---Fetch a URL bypassing CDN caches where possible.
---@return string?, string?
local function fetch(url)
	local target = url
	if url:find("raw.githubusercontent.com", 1, true) then
		target = url .. "?cb=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
	end

	if type(request) == "function" then
		local ok, res = pcall(request, {
			Url = target, Method = "GET",
			Headers = { ["Cache-Control"] = "no-cache", ["Pragma"] = "no-cache" },
		})
		if ok and type(res) == "table" then
			if res.StatusCode == 200 and type(res.Body) == "string" and #res.Body > 0 then
				return res.Body
			end
			return nil, "HTTP " .. tostring(res.StatusCode)
		end
	end

	local ok, body = pcall(game.HttpGet, game, target, true)
	if ok and type(body) == "string" and #body > 0 then return body end
	return nil, tostring(body)
end

---Pull the loader version out of a loader source string.
---@return string?
local function parseVersion(source)
	if type(source) ~= "string" then return nil end
	return source:match('LOADER_VERSION%s*=%s*"([%w%.%-_]+)"')
end

---Read width/height from a PNG header.
---@return number?, number?
local function readPngSize(data)
	if type(data) ~= "string" or #data < 24 or data:sub(2, 4) ~= "PNG" then return nil end
	local function u32(at)
		return data:byte(at) * 16777216 + data:byte(at + 1) * 65536 + data:byte(at + 2) * 256 + data:byte(at + 3)
	end
	local width, height = u32(17), u32(21)
	if width < 1 or height < 1 then return nil end
	return width, height
end

---Download (or reuse the cached) logo and turn it into a usable asset id.
---@return string?, number?
local function resolveLogo()
	if type(writefile) ~= "function" or type(getcustomasset) ~= "function"
		or type(isfile) ~= "function" or type(readfile) ~= "function" then
		return nil
	end

	if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(LOGO_FOLDER) then
		try(makefolder, LOGO_FOLDER)
	end

	local data = fetch(LOGO_URL)
	if readPngSize(data) then
		try(writefile, LOGO_PATH, data)
	else
		data = isfile(LOGO_PATH) and try(readfile, LOGO_PATH) or nil
	end

	local width, height = readPngSize(data)
	if not width then return nil end

	local asset = try(getcustomasset, LOGO_PATH)
	if not asset then return nil end
	return asset, width / height
end

